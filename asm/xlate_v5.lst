     1                                  BITS 16
     2                                  CPU 386
     3                                  ORG 0x76F5          ; free-space block inside the ROM image (segment F000 implied)
     4                                  
     5                                  ; =====================================================================
     6                                  ;  CHS TRANSLATION PATCH for Soyo 386 AMI BIOS (27C512, dated 11/11/92)
     7                                  ;
     8                                  ;  Adds bit-shift ("Large"/ECHS-style) CHS translation to the legacy
     9                                  ;  hard-disk INT13h handler so drives up to the ~7.88 GB INT13 CHS
    10                                  ;  ceiling can be addressed, instead of the native 504 MB CHS wall
    11                                  ;  (1024 cyl x 16 heads x 63 sect, imposed by raw CHS pass-through
    12                                  ;  to the IDE task-file registers with no translation logic).
    13                                  ;
    14                                  ;  Two call sites in the original ROM are patched to reach this code
    15                                  ;  (see build.py for the exact byte patches applied at 0xA659 and
    16                                  ;  0xA965); nothing else in the ROM is modified.
    17                                  ; =====================================================================
    18                                  
    19                                  ; ---------------------------------------------------------------
    20                                  ; calc_factor                                            -- v5
    21                                  ;   In:  AX = RealCyl (word), CL = RealHeads (byte, CH=0)
    22                                  ;   Out: AX = TranslatedHeads  (RealHeads * 2^n, or 255)
    23                                  ;   Preserves: BX, CX, DX, SI, DI, ES, DS
    24                                  ;
    25                                  ;   v5 change: the head count is never allowed to reach 256.
    26                                  ;   256 heads (DH=255 reported as "max head index") is fatal for
    27                                  ;   MS-DOS/Win9x: FDISK reports the right size but fails to write the
    28                                  ;   partition table, and some geometries hang the machine. The classic
    29                                  ;   BIOS answer is used instead: head counts go 16,32,64,128 and then
    30                                  ;   jump straight to 255 (Phoenix/AMI "Large"/ECHS table), which also
    31                                  ;   lifts the ceiling to 1024 x 255 x 63 x 512 = 7.88 GB.
    32                                  ; ---------------------------------------------------------------
    33                                  calc_factor:
    34 00000000 53                          push bx
    35 00000001 89C3                        mov  bx, ax            ; bx = working cylinder count
    36 00000003 89C8                        mov  ax, cx            ; ax = candidate head count = RealHeads
    37                                  .loop:
    38 00000005 81FB0004                    cmp  bx, 1024
    39 00000009 760E                        jbe  .done             ; cylinders already fit -> done
    40 0000000B 83F87F                      cmp  ax, 127
    41 0000000E 7706                        ja   .max              ; doubling would pass 255 -> use 255 heads
    42 00000010 D1E0                        shl  ax, 1             ; heads *= 2
    43 00000012 D1EB                        shr  bx, 1             ; cylinders /= 2
    44 00000014 EBEF                        jmp  .loop
    45                                  .max:
    46 00000016 B8FF00                      mov  ax, 255
    47                                  .done:
    48 00000019 5B                          pop  bx
    49 0000001A C3                          ret
    50                                  
    51                                  ; ---------------------------------------------------------------
    52                                  ; xlate_getparams  (replaces the CHS-reporting body of AH=08h,
    53                                  ;                   original bytes at 0xA659-0xA685)
    54                                  ;   In:  ES:BX -> FDPT  (word +0h = RealCyl, byte +2h = RealHeads,
    55                                  ;                         byte +0Eh = RealSectors)
    56                                  ;   Out: CH = translated max-cyl low byte
    57                                  ;        CL = (max-cyl hi bits << 6) | sectors/track
    58                                  ;        DH = translated max-head index (TranslatedHeads - 1)
    59                                  ;        AL = sectors/track   (what the original code left in AL)
    60                                  ;   DL/AH are set by the original tail at 0xA686, which v4+ preserves.
    61                                  ;   All 32-bit registers are untouched (16-bit math only).
    62                                  ; ---------------------------------------------------------------
    63                                  xlate_getparams:
    64 0000001B 53                          push bx
    65 0000001C 56                          push si
    66 0000001D 57                          push di
    67 0000001E 268B17                      mov  dx, word [es:bx]         ; dx = RealCyl
    68 00000021 30ED                        xor  ch, ch
    69 00000023 268A4F02                    mov  cl, byte [es:bx+2]       ; cx = RealHeads
    70 00000027 268A470E                    mov  al, byte [es:bx+0x0e]    ; al = RealSectors
    71 0000002B 30E4                        xor  ah, ah
    72 0000002D 50                          push ax                        ; stash RealSectors
    73 0000002E 51                          push cx                        ; stash RealHeads
    74 0000002F 52                          push dx                        ; stash RealCyl
    75 00000030 89D0                        mov  ax, dx
    76 00000032 E8CBFF                      call calc_factor               ; ax = TranslatedHeads
    77 00000035 89C7                        mov  di, ax                    ; di = TranslatedHeads
    78                                  
    79 00000037 58                          pop  ax                        ; ax = RealCyl
    80 00000038 59                          pop  cx                        ; cx = RealHeads
    81 00000039 F7E1                        mul  cx                        ; dx:ax = RealCyl * RealHeads
    82 0000003B F7F7                        div  di                        ; ax = RealCyl*RealHeads / TransHeads
    83                                                                     ; (<= RealCyl, so it always fits)
    84                                  
    85 0000003D 83E802                      sub  ax, 2                     ; match original "-2" reporting convention
    86 00000040 3DFF03                      cmp  ax, 0x3ff
    87 00000043 7603                        jbe  .cylok
    88 00000045 B8FF03                      mov  ax, 0x3ff
    89                                  .cylok:
    90 00000048 88C5                        mov  ch, al                    ; CH = low 8 bits of max cyl index
    91 0000004A 88E3                        mov  bl, ah
    92 0000004C C0E306                      shl  bl, 6
    93 0000004F 88D9                        mov  cl, bl                    ; CL bits 7:6 = cyl high bits
    94 00000051 58                          pop  ax                        ; ax = RealSectors
    95 00000052 08C1                        or   cl, al                    ; CL bits 5:0 = sectors/track
    96                                  
    97 00000054 50                          push ax                        ; keep RealSectors for AL
    98 00000055 89F8                        mov  ax, di                    ; ax = TranslatedHeads
    99 00000057 48                          dec  ax
   100 00000058 88C6                        mov  dh, al                    ; DH = translated max head index
   101 0000005A 58                          pop  ax                        ; AL = sectors/track, AH = 0
   102                                  
   103 0000005B 5F                          pop  di
   104 0000005C 5E                          pop  si
   105 0000005D 5B                          pop  bx
   106 0000005E C3                          ret
   107                                  
   108                                  ; ---------------------------------------------------------------
   109                                  ; xlate_headcyl  (replaces "AND DH,0Fh" at 0xA965)   -- v4
   110                                  ;
   111                                  ;   Entry context (exactly as at the original instruction):
   112                                  ;     DH    = original caller HEAD (logical)
   113                                  ;     DI    = INT13h function index * 2 (dispatcher's DI, or the value
   114                                  ;             the reset path loads explicitly: 0x22 recal, 0x12 init)
   115                                  ;     ES:BX = FDPT for the active drive
   116                                  ;     Stack: [ret][orig CX][orig DX] (pushed by 0xA93C..0xA93F)
   117                                  ;
   118                                  ;   Exit:
   119                                  ;     DH           = physical head (0..RealHeads-1)
   120                                  ;     saved CX     = physical CX (cyl lo / cyl bits 9:8 / sector)
   121                                  ;     outer [bp+6] = physical cylinder HIGH BYTE (IDE port 1F5h value);
   122                                  ;                    the three port-write sites now read it from there.
   123                                  ;     The caller's saved DX in the INT13h frame ([bp+14h/15h]) is NOT
   124                                  ;     touched any more (v3 wrote [bp+15h] = caller's DH, so every
   125                                  ;     translated call returned a corrupted DH to the caller).
   126                                  ;     All 32-bit registers preserved (PUSHAD/POPAD).
   127                                  ;
   128                                  ;   Only the functions that actually carry a CHS address are translated:
   129                                  ;     AH=02,03,04,05,0A,0B,0C  (DI=04,06,08,0A,14,16,18)
   130                                  ;   Everything else (reset/recal/test-ready/alt-reset/park...) gets the
   131                                  ;   ORIGINAL behaviour: head = DH & 0Fh, cyl-high byte computed exactly
   132                                  ;   like the original ROM did ((CL>>6) | ((frameDH>>4)&0Ch)).
   133                                  ; ---------------------------------------------------------------
   134                                  xlate_headcyl:
   135 0000005F 55                          push bp
   136 00000060 89E5                        mov  bp, sp                  ; [bp+0]=outer bp [bp+4]=origCX [bp+6]=origDX
   137 00000062 83FF04                      cmp  di, 0x04
   138 00000065 7440                        je   .xl
   139 00000067 83FF06                      cmp  di, 0x06
   140 0000006A 743B                        je   .xl
   141 0000006C 83FF08                      cmp  di, 0x08
   142 0000006F 7436                        je   .xl
   143 00000071 83FF0A                      cmp  di, 0x0a
   144 00000074 7431                        je   .xl
   145 00000076 83FF14                      cmp  di, 0x14
   146 00000079 742C                        je   .xl
   147 0000007B 83FF16                      cmp  di, 0x16
   148 0000007E 7427                        je   .xl
   149 00000080 83FF18                      cmp  di, 0x18
   150 00000083 7422                        je   .xl
   151                                  
   152                                      ; ---- untranslated: reproduce original ROM behaviour ----
   153 00000085 50                          push ax
   154 00000086 53                          push bx
   155 00000087 8B5E00                      mov  bx, [bp+0]               ; outer INT13h frame bp
   156 0000008A 8A4604                      mov  al, [bp+4]               ; orig CL
   157 0000008D C0E806                      shr  al, 6
   158 00000090 368A6715                    mov  ah, [ss:bx+0x15]         ; frame DH (ECHS cyl bits 11:10 in bits 7:6)
   159 00000094 C0EC04                      shr  ah, 4
   160 00000097 80E40C                      and  ah, 0x0c
   161 0000009A 08E0                        or   al, ah
   162 0000009C 36884706                    mov  [ss:bx+6], al            ; cyl-high byte for port 1F5h
   163 000000A0 5B                          pop  bx
   164 000000A1 58                          pop  ax
   165 000000A2 80E60F                      and  dh, 0x0f
   166 000000A5 5D                          pop  bp
   167 000000A6 C3                          ret
   168                                  
   169                                  .xl:
   170 000000A7 83EC0C                      sub  sp, 12                   ; locals: -2 logC -4 logH -6 logS
   171                                                                    ;         -8 realH -10 realS -12 transH
   172 000000AA 6660                        pushad                        ; preserve ALL 32-bit registers
   173                                  
   174 000000AC 268B37                      mov  si, word [es:bx]         ; si = RealCyl
   175 000000AF 268A4F02                    mov  cl, byte [es:bx+2]       ; cl = RealHeads
   176 000000B3 30ED                        xor  ch, ch
   177 000000B5 894EF8                      mov  [bp-8], cx
   178 000000B8 268A570E                    mov  dl, byte [es:bx+0x0e]    ; dl = RealSectors
   179 000000BC 30F6                        xor  dh, dh
   180 000000BE 8956F6                      mov  [bp-10], dx
   181 000000C1 89F0                        mov  ax, si
   182 000000C3 E83AFF                      call calc_factor              ; ax = TranslatedHeads, si = factor
   183 000000C6 8946F4                      mov  [bp-12], ax
   184                                  
   185 000000C9 8B4604                      mov  ax, [bp+4]               ; origCX
   186 000000CC 88C3                        mov  bl, al
   187 000000CE 80E33F                      and  bl, 0x3f
   188 000000D1 30FF                        xor  bh, bh
   189 000000D3 895EFA                      mov  [bp-6], bx               ; logS
   190 000000D6 88C3                        mov  bl, al
   191 000000D8 80E3C0                      and  bl, 0xc0
   192 000000DB C0EB06                      shr  bl, 6
   193 000000DE 30FF                        xor  bh, bh
   194 000000E0 88E2                        mov  dl, ah
   195 000000E2 30F6                        xor  dh, dh
   196 000000E4 C1E308                      shl  bx, 8
   197 000000E7 09D3                        or   bx, dx
   198 000000E9 895EFE                      mov  [bp-2], bx               ; logC (10 bit)
   199 000000EC 8A4607                      mov  al, [bp+7]               ; orig DH
   200 000000EF 30E4                        xor  ah, ah
   201 000000F1 8946FC                      mov  [bp-4], ax               ; logH
   202                                  
   203 000000F4 660FB746FE                  movzx eax, word [bp-2]
   204 000000F9 660FB74EF4                  movzx ecx, word [bp-12]
   205 000000FE 660FAFC1                    imul  eax, ecx
   206 00000102 660FB756FC                  movzx edx, word [bp-4]
   207 00000107 6601D0                      add   eax, edx
   208 0000010A 660FB74EF6                  movzx ecx, word [bp-10]
   209 0000010F 660FAFC1                    imul  eax, ecx
   210 00000113 660FB756FA                  movzx edx, word [bp-6]
   211 00000118 664A                        dec   edx
   212 0000011A 6601D0                      add   eax, edx                ; LBA
   213                                  
   214 0000011D 660FB74EF6                  movzx ecx, word [bp-10]
   215 00000122 6631D2                      xor   edx, edx
   216 00000125 66F7F1                      div   ecx
   217 00000128 6642                        inc   edx
   218 0000012A 8956FA                      mov   [bp-6], dx              ; physSect
   219 0000012D 660FB74EF8                  movzx ecx, word [bp-8]
   220 00000132 6631D2                      xor   edx, edx
   221 00000135 66F7F1                      div   ecx                     ; eax = physCyl, edx = physHead
   222 00000138 8956FC                      mov   [bp-4], dx
   223 0000013B 8946FE                      mov   [bp-2], ax
   224                                  
   225 0000013E 8B5E00                      mov   bx, [bp+0]              ; outer INT13h frame bp
   226 00000141 36886706                    mov   [ss:bx+6], ah           ; physCyl high byte -> frame local [bp+6]
   227                                  
   228 00000145 8B46FE                      mov   ax, [bp-2]
   229 00000148 88C7                        mov   bh, al
   230 0000014A 88E3                        mov   bl, ah
   231 0000014C C0E306                      shl   bl, 6
   232 0000014F 8B4EFA                      mov   cx, [bp-6]
   233 00000152 08CB                        or    bl, cl
   234 00000154 895E04                      mov   [bp+4], bx              ; saved CX := physical CX
   235                                  
   236 00000157 6661                        popad
   237 00000159 8A76FC                      mov  dh, byte [bp-4]          ; DH = physical head
   238 0000015C 83C40C                      add  sp, 12
   239 0000015F 5D                          pop  bp
   240 00000160 C3                          ret
