     1                                  BITS 16
     2                                  CPU 386
     3                                  ORG 0x76F5          ; free-space block inside the ROM image (segment F000 implied)
     4                                  
     5                                  ; =====================================================================
     6                                  ;  CHS TRANSLATION PATCH for Soyo 386 AMI BIOS (27C512, dated 11/11/92)
     7                                  ;
     8                                  ;  Adds bit-shift ("Large"/ECHS-style) CHS translation to the legacy
     9                                  ;  hard-disk INT13h handler so drives up to the INT13 CHS ceiling of
    10                                  ;  1024 x 255 x 63 x 512 = 8.42 GB (7.84 GiB) can be addressed, instead
    11                                  ;  of the native 504 MB CHS wall (1024 cyl x 16 heads x 63 sect, imposed
    12                                  ;  by raw CHS pass-through to the IDE task-file registers with no
    13                                  ;  translation logic).
    14                                  ;
    15                                  ;  The routines below are reached from five patch sites in the original
    16                                  ;  ROM (all applied by py/build.py, which also asserts the original
    17                                  ;  bytes at each site before overwriting them):
    18                                  ;    0xA659-0xA685  AH=08h reporting body -> CALL xlate_getparams / JMP 0xA686
    19                                  ;    0xA965         AND DH,0Fh            -> CALL xlate_headcyl
    20                                  ;    0xA60E, 0xA7EA, 0xAB3D  cylinder-high builders before OUT 1F5h
    21                                  ;                   -> MOV AL,[BP+6] + NOP fill (the byte xlate_headcyl stores)
    22                                  ;  plus a checksum-balancing word at 0x7900.
    23                                  ; =====================================================================
    24                                  
    25                                  ; ---------------------------------------------------------------
    26                                  ; calc_factor
    27                                  ;   In:  AX = RealCyl (word), CL = RealHeads (byte, CH=0)
    28                                  ;   Out: AX = TranslatedHeads  (RealHeads * 2^n, or 255)
    29                                  ;   Preserves: BX, CX, DX, SI, DI, ES, DS
    30                                  ;
    31                                  ;   The head count is never allowed to reach 256 (BIOS_Evaluation.md bug #6).
    32                                  ;   256 heads (DH=255 reported as "max head index") is fatal for
    33                                  ;   MS-DOS/Win9x: FDISK reports the right size but fails to write the
    34                                  ;   partition table, and some geometries hang the machine. The classic
    35                                  ;   BIOS answer is used instead: head counts go 16,32,64,128 and then
    36                                  ;   jump straight to 255 (Phoenix/AMI "Large"/ECHS table), giving a
    37                                  ;   ceiling of 1024 x 255 x 63 x 512 = 8.42 GB (7.84 GiB).
    38                                  ; ---------------------------------------------------------------
    39                                  calc_factor:
    40 00000000 53                          push bx
    41 00000001 89C3                        mov  bx, ax            ; bx = working cylinder count
    42 00000003 89C8                        mov  ax, cx            ; ax = candidate head count = RealHeads
    43                                  .loop:
    44 00000005 81FB0004                    cmp  bx, 1024
    45 00000009 760E                        jbe  .done             ; cylinders already fit -> done
    46 0000000B 83F87F                      cmp  ax, 127
    47 0000000E 7706                        ja   .max              ; doubling would pass 255 -> use 255 heads
    48 00000010 D1E0                        shl  ax, 1             ; heads *= 2
    49 00000012 D1EB                        shr  bx, 1             ; cylinders /= 2
    50 00000014 EBEF                        jmp  .loop
    51                                  .max:
    52 00000016 B8FF00                      mov  ax, 255
    53                                  .done:
    54 00000019 5B                          pop  bx
    55 0000001A C3                          ret
    56                                  
    57                                  ; ---------------------------------------------------------------
    58                                  ; xlate_getparams  (replaces the CHS-reporting body of AH=08h,
    59                                  ;                   original bytes at 0xA659-0xA685)
    60                                  ;   In:  ES:BX -> FDPT  (word +0h = RealCyl, byte +2h = RealHeads,
    61                                  ;                         byte +0Eh = RealSectors)
    62                                  ;   Out: CH = translated max-cyl low byte
    63                                  ;        CL = (max-cyl hi bits << 6) | sectors/track
    64                                  ;        DH = translated max-head index (TranslatedHeads - 1)
    65                                  ;        AL = sectors/track   (what the original code left in AL)
    66                                  ;   DL/AH are set by the original tail at 0xA686, which is left intact.
    67                                  ;   All 32-bit registers are untouched (16-bit math only).
    68                                  ; ---------------------------------------------------------------
    69                                  xlate_getparams:
    70 0000001B 53                          push bx
    71 0000001C 56                          push si
    72 0000001D 57                          push di
    73 0000001E 268B17                      mov  dx, word [es:bx]         ; dx = RealCyl
    74 00000021 30ED                        xor  ch, ch
    75 00000023 268A4F02                    mov  cl, byte [es:bx+2]       ; cx = RealHeads
    76 00000027 268A470E                    mov  al, byte [es:bx+0x0e]    ; al = RealSectors
    77 0000002B 30E4                        xor  ah, ah
    78 0000002D 50                          push ax                        ; stash RealSectors
    79 0000002E 51                          push cx                        ; stash RealHeads
    80 0000002F 52                          push dx                        ; stash RealCyl
    81 00000030 89D0                        mov  ax, dx
    82 00000032 E8CBFF                      call calc_factor               ; ax = TranslatedHeads
    83 00000035 89C7                        mov  di, ax                    ; di = TranslatedHeads
    84                                  
    85 00000037 58                          pop  ax                        ; ax = RealCyl
    86 00000038 59                          pop  cx                        ; cx = RealHeads
    87 00000039 F7E1                        mul  cx                        ; dx:ax = RealCyl * RealHeads
    88 0000003B F7F7                        div  di                        ; ax = RealCyl*RealHeads / TransHeads
    89                                                                     ; (<= RealCyl, so it always fits)
    90                                  
    91 0000003D 83E802                      sub  ax, 2                     ; match original "-2" reporting convention
    92 00000040 3DFF03                      cmp  ax, 0x3ff
    93 00000043 7603                        jbe  .cylok
    94 00000045 B8FF03                      mov  ax, 0x3ff
    95                                  .cylok:
    96 00000048 88C5                        mov  ch, al                    ; CH = low 8 bits of max cyl index
    97 0000004A 88E3                        mov  bl, ah
    98 0000004C C0E306                      shl  bl, 6
    99 0000004F 88D9                        mov  cl, bl                    ; CL bits 7:6 = cyl high bits
   100 00000051 58                          pop  ax                        ; ax = RealSectors
   101 00000052 08C1                        or   cl, al                    ; CL bits 5:0 = sectors/track
   102                                  
   103 00000054 50                          push ax                        ; keep RealSectors for AL
   104 00000055 89F8                        mov  ax, di                    ; ax = TranslatedHeads
   105 00000057 48                          dec  ax
   106 00000058 88C6                        mov  dh, al                    ; DH = translated max head index
   107 0000005A 58                          pop  ax                        ; AL = sectors/track, AH = 0
   108                                  
   109 0000005B 5F                          pop  di
   110 0000005C 5E                          pop  si
   111 0000005D 5B                          pop  bx
   112 0000005E C3                          ret
   113                                  
   114                                  ; ---------------------------------------------------------------
   115                                  ; xlate_headcyl  (replaces "AND DH,0Fh" at 0xA965)
   116                                  ;
   117                                  ;   Entry context (exactly as at the original instruction):
   118                                  ;     DH    = original caller HEAD (logical)
   119                                  ;     DI    = INT13h function index * 2 (dispatcher's DI, or the value
   120                                  ;             the reset path loads explicitly: 0x22 recal, 0x12 init)
   121                                  ;     ES:BX = FDPT for the active drive
   122                                  ;     Stack: [ret][orig CX][orig DX] (pushed by 0xA93C..0xA93F)
   123                                  ;
   124                                  ;   Exit:
   125                                  ;     DH           = physical head (0..RealHeads-1)
   126                                  ;     saved CX     = physical CX (cyl lo / cyl bits 9:8 / sector)
   127                                  ;     outer [bp+6] = physical cylinder HIGH BYTE (IDE port 1F5h value);
   128                                  ;                    the three port-write sites now read it from there.
   129                                  ;     The caller's saved DX in the INT13h frame ([bp+14h/15h]) is NOT
   130                                  ;     touched: [bp+15h] is the caller's saved DH, and writing it was
   131                                  ;     bug #4 in BIOS_Evaluation.md.
   132                                  ;     All 32-bit registers preserved (PUSHAD/POPAD).
   133                                  ;
   134                                  ;   Only the functions that actually carry a CHS address are translated:
   135                                  ;     AH=02,03,04,05,0A,0B,0C  (DI=04,06,08,0A,14,16,18)
   136                                  ;   Everything else (reset/recal/test-ready/alt-reset/park...) gets the
   137                                  ;   ORIGINAL behaviour: head = DH & 0Fh, cyl-high byte computed exactly
   138                                  ;   like the original ROM did ((CL>>6) | ((frameDH>>4)&0Ch)).
   139                                  ; ---------------------------------------------------------------
   140                                  xlate_headcyl:
   141 0000005F 55                          push bp
   142 00000060 89E5                        mov  bp, sp                  ; [bp+0]=outer bp [bp+4]=origCX [bp+6]=origDX
   143 00000062 83FF04                      cmp  di, 0x04
   144 00000065 7440                        je   .xl
   145 00000067 83FF06                      cmp  di, 0x06
   146 0000006A 743B                        je   .xl
   147 0000006C 83FF08                      cmp  di, 0x08
   148 0000006F 7436                        je   .xl
   149 00000071 83FF0A                      cmp  di, 0x0a
   150 00000074 7431                        je   .xl
   151 00000076 83FF14                      cmp  di, 0x14
   152 00000079 742C                        je   .xl
   153 0000007B 83FF16                      cmp  di, 0x16
   154 0000007E 7427                        je   .xl
   155 00000080 83FF18                      cmp  di, 0x18
   156 00000083 7422                        je   .xl
   157                                  
   158                                      ; ---- untranslated: reproduce original ROM behaviour ----
   159 00000085 50                          push ax
   160 00000086 53                          push bx
   161 00000087 8B5E00                      mov  bx, [bp+0]               ; outer INT13h frame bp
   162 0000008A 8A4604                      mov  al, [bp+4]               ; orig CL
   163 0000008D C0E806                      shr  al, 6
   164 00000090 368A6715                    mov  ah, [ss:bx+0x15]         ; frame DH (ECHS cyl bits 11:10 in bits 7:6)
   165 00000094 C0EC04                      shr  ah, 4
   166 00000097 80E40C                      and  ah, 0x0c
   167 0000009A 08E0                        or   al, ah
   168 0000009C 36884706                    mov  [ss:bx+6], al            ; cyl-high byte for port 1F5h
   169 000000A0 5B                          pop  bx
   170 000000A1 58                          pop  ax
   171 000000A2 80E60F                      and  dh, 0x0f
   172 000000A5 5D                          pop  bp
   173 000000A6 C3                          ret
   174                                  
   175                                  .xl:
   176 000000A7 83EC0C                      sub  sp, 12                   ; locals: -2 logC -4 logH -6 logS
   177                                                                    ;         -8 realH -10 realS -12 transH
   178 000000AA 6660                        pushad                        ; preserve ALL 32-bit registers
   179                                  
   180 000000AC 268B37                      mov  si, word [es:bx]         ; si = RealCyl
   181 000000AF 268A4F02                    mov  cl, byte [es:bx+2]       ; cl = RealHeads
   182 000000B3 30ED                        xor  ch, ch
   183 000000B5 894EF8                      mov  [bp-8], cx
   184 000000B8 268A570E                    mov  dl, byte [es:bx+0x0e]    ; dl = RealSectors
   185 000000BC 30F6                        xor  dh, dh
   186 000000BE 8956F6                      mov  [bp-10], dx
   187 000000C1 89F0                        mov  ax, si
   188 000000C3 E83AFF                      call calc_factor              ; ax = TranslatedHeads
   189 000000C6 8946F4                      mov  [bp-12], ax
   190                                  
   191 000000C9 8B4604                      mov  ax, [bp+4]               ; origCX
   192 000000CC 88C3                        mov  bl, al
   193 000000CE 80E33F                      and  bl, 0x3f
   194 000000D1 30FF                        xor  bh, bh
   195 000000D3 895EFA                      mov  [bp-6], bx               ; logS
   196 000000D6 88C3                        mov  bl, al
   197 000000D8 80E3C0                      and  bl, 0xc0
   198 000000DB C0EB06                      shr  bl, 6
   199 000000DE 30FF                        xor  bh, bh
   200 000000E0 88E2                        mov  dl, ah
   201 000000E2 30F6                        xor  dh, dh
   202 000000E4 C1E308                      shl  bx, 8
   203 000000E7 09D3                        or   bx, dx
   204 000000E9 895EFE                      mov  [bp-2], bx               ; logC (10 bit)
   205 000000EC 8A4607                      mov  al, [bp+7]               ; orig DH
   206 000000EF 30E4                        xor  ah, ah
   207 000000F1 8946FC                      mov  [bp-4], ax               ; logH
   208                                  
   209 000000F4 660FB746FE                  movzx eax, word [bp-2]
   210 000000F9 660FB74EF4                  movzx ecx, word [bp-12]
   211 000000FE 660FAFC1                    imul  eax, ecx
   212 00000102 660FB756FC                  movzx edx, word [bp-4]
   213 00000107 6601D0                      add   eax, edx
   214 0000010A 660FB74EF6                  movzx ecx, word [bp-10]
   215 0000010F 660FAFC1                    imul  eax, ecx
   216 00000113 660FB756FA                  movzx edx, word [bp-6]
   217 00000118 664A                        dec   edx
   218 0000011A 6601D0                      add   eax, edx                ; LBA
   219                                  
   220 0000011D 660FB74EF6                  movzx ecx, word [bp-10]
   221 00000122 6631D2                      xor   edx, edx
   222 00000125 66F7F1                      div   ecx
   223 00000128 6642                        inc   edx
   224 0000012A 8956FA                      mov   [bp-6], dx              ; physSect
   225 0000012D 660FB74EF8                  movzx ecx, word [bp-8]
   226 00000132 6631D2                      xor   edx, edx
   227 00000135 66F7F1                      div   ecx                     ; eax = physCyl, edx = physHead
   228 00000138 8956FC                      mov   [bp-4], dx
   229 0000013B 8946FE                      mov   [bp-2], ax
   230                                  
   231 0000013E 8B5E00                      mov   bx, [bp+0]              ; outer INT13h frame bp
   232 00000141 36886706                    mov   [ss:bx+6], ah           ; physCyl high byte -> frame local [bp+6]
   233                                  
   234 00000145 8B46FE                      mov   ax, [bp-2]
   235 00000148 88C7                        mov   bh, al
   236 0000014A 88E3                        mov   bl, ah
   237 0000014C C0E306                      shl   bl, 6
   238 0000014F 8B4EFA                      mov   cx, [bp-6]
   239 00000152 08CB                        or    bl, cl
   240 00000154 895E04                      mov   [bp+4], bx              ; saved CX := physical CX
   241                                  
   242 00000157 6661                        popad
   243 00000159 8A76FC                      mov  dh, byte [bp-4]          ; DH = physical head
   244 0000015C 83C40C                      add  sp, 12
   245 0000015F 5D                          pop  bp
   246 00000160 C3                          ret
