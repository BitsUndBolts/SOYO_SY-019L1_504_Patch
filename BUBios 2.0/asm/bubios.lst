     1                                  ; =====================================================================
     2                                  ;  BUBios -- MR-BIOS-style front end for the AMIBIOS 11/11/92 setup
     3                                  ;  (SOYO SY-019L1, OPTi 82C495SLC, 27C512) -- version 2.0
     4                                  ;
     5                                  ;  2.0 adds the POST screen in post.asm (included at the end of this file)
     6                                  ;  and removes dead AMI code; see README.md.
     7                                  ;
     8                                  ;  Built on top of the hardware-confirmed ECHS ROM
     9                                  ;  (binary/SY019L1_27C512_CHSPATCH.BIN of the parent project).
    10                                  ;
    11                                  ;  What this adds (all patch sites are applied and verified by
    12                                  ;  py/build_bubios.py, which asserts the original bytes first):
    13                                  ;
    14                                  ;    0x36D4  AMI main menu            -> JMP bu_main   (tab bar + pages)
    15                                  ;    0x38B5  AMI screen header        -> JMP bu_hdr    (title bar + tabs)
    16                                  ;    0x0D3D  option-editor getkey     -> CALL bu_edkey (Tab / Shift-Tab)
    17                                  ;    0x08D5  Standard-CMOS getkey     -> CALL bu_stdkey + NOP (Tab, digits)
    18                                  ;    0x5F94  date/time field getkey   -> CALL bu_dtkey (numeric date/time entry)
    19                                  ;    0x5037  16 colour schemes        -> BUBios schemes (F2/F3 cycles them)
    20                                  ;    0x4FF6  "bright" OR-mask 0Fh     -> 08h (intensity only, keeps hue)
    21                                  ;    0x309A / 0x6D3A  footer texts    -> Tab/ESC hints
    22                                  ;
    23                                  ;  Code lives in the free block 0xDA84-0xDFFF (executed from F000).
    24                                  ;  Data (and the small timing loop) live in the free block 0x7902-0x7EFD.
    25                                  ;  The setup program copies F000:0000-DFFF to 0100:0000 and runs with
    26                                  ;  DS=SS=0100h, so DS-relative data must sit below 0xE000 -- and not in
    27                                  ;  0xDA84-0xDFFF, which is the setup's stack in that RAM copy.  That is
    28                                  ;  why every string/table is in the 0x79xx block.
    29                                  ; =====================================================================
    30                                  [map all bubios.map]
    31                                  BITS 16
    32                                  CPU 386
    33                                  
    34                                  ; ---- AMI setup routines (all near, segment F000) --------------------
    35                                  A_RDCMOS   equ 0x84CB     ; read CMOS into the image at DS:E000
    36                                  A_VIDINIT  equ 0x5077     ; video mode + colour scheme -> E1A2..E1A9
    37                                  A_CUROFF   equ 0x0995     ; hide cursor
    38                                  A_SETUPOK  equ 0x54AE     ; AX<>0 if menu item [E187] is available
    39                                  A_NOSETUP  equ 0x3704     ; "NO CMOS SETUP PRESENT" path (exits setup)
    40                                  A_BOX      equ 0x5199     ; box  AX=top-left DX=bottom-right BX=style
    41                                  A_FILL     equ 0x520E     ; fill AX=top-left DX=bottom-right, attr [E19F]
    42                                  A_HLINE    equ 0x526E     ; horizontal line AX=start DL=len BX=style
    43                                  A_VLINE    equ 0x5286     ; vertical line   AX=start DL=len BX=style
    44                                  A_PRINT    equ 0x52DF     ; print DS:BX at AX=row:col, attr [E19F]
    45                                  A_PRINTB   equ 0x52BB     ; same, bright
    46                                  A_PRINTC   equ 0x52D2     ; same, centred on column AL
    47                                  A_PUTCH    equ 0x52FA     ; print char AL at DX=row:col
    48                                  A_FOOTER   equ 0x390F     ; framed footer caption DS:BX centred at AX
    49                                  A_GETKEY   equ 0x530E     ; AX = ASCII, or 100h+scan for extended keys
    50                                  A_COLOUR   equ 0x50BA     ; F2/F3 colour cycling (reads [E182])
    51                                  A_SAVEEXIT equ 0x29DD     ; "Write to CMOS and Exit (Y/N)?"
    52                                  A_QUIT     equ 0x29EC     ; "Want to Quit Without Saving (Y/N)?"
    53                                  A_VALSTR   equ 0x5B21     ; AX = value string of option record [E18F]
    54                                  H_STD      equ 0x00EC     ; Standard CMOS setup page
    55                                  H_ADV      equ 0x0BDE     ; Advanced CMOS setup page
    56                                  H_CHIP     equ 0x0C05     ; Advanced chipset setup page
    57                                  H_DEF      equ 0x5486     ; load BIOS / power-on defaults ([E187]=5/6)
    58                                  H_PWD      equ 0xF1C8     ; change password
    59                                  H_DETECT   equ 0x4A44     ; auto-detect hard disk
    60                                  CALC_FACTOR equ 0x76F5    ; ECHS head-factor routine of the xlate patch
    61                                  A_STDKEY   equ 0x08CD     ; Standard CMOS field key reader (flags = navigation)
    62                                  A_GETDATE  equ 0x6180     ; CX = year, DH = month, DL = day (BCD, validated)
    63                                  A_GETTIME  equ 0x61BA     ; CH = hour, CL = min, DH = sec, DL = DST (BCD)
    64                                  A_SETDATE  equ 0x5FCB     ; set RTC date, day clamped to the month, redraw
    65                                  A_DTSHOW   equ 0x6022     ; redraw date, time and calendar
    66                                  
    67                                  ; ---- AMI option records used on the Summary page ----------------------
    68                                  R_EXTCACHE equ 0xBDE7     ; External Cache Memory
    69                                  R_VSHADOW  equ 0xBE8F     ; Video ROM Shadow C000,16K
    70                                  R_SSHADOW  equ 0xC057     ; System ROM Shadow F000,64K
    71                                  R_BOOTSEQ  equ 0xBDA3     ; System Boot Up Sequence
    72                                  R_NUMLOCK  equ 0xBD1D     ; System Boot Up Num Lock
    73                                  R_PASSWORD equ 0xBE6D     ; Password Checking Option
    74                                  
    75                                  ; ---- AMI strings reused (verified by the build script) ----------------
    76                                  S_FLOPPY   equ 0x6F35     ; "360  KB, 5.."  stride 17
    77                                  S_MONO     equ 0x6F8A
    78                                  S_COL80    equ 0x6F9B
    79                                  S_COL40    equ 0x6FAC
    80                                  S_VGA      equ 0x6FBD
    81                                  S_HELP_DEF equ 0x2D4F
    82                                  S_HELP_PON equ 0x2D9B
    83                                  S_HELP_PWD equ 0x2DE5
    84                                  S_HELP_DET equ 0x2E11
    85                                  S_HELP_SAV equ 0x2E7C
    86                                  S_HELP_QUT equ 0x2E75
    87                                  
    88                                  ; ---- setup data segment (DS = 0100h) ---------------------------------
    89                                  CMOS       equ 0xE000     ; CMOS image, CMOS+n = register n
    90                                  V_KEY      equ 0xE182
    91                                  V_ITEM     equ 0xE187     ; current AMI main-menu item (handlers read it)
    92                                  V_REC      equ 0xE18F
    93                                  V_VSTR     equ 0xE197
    94                                  V_ATTR     equ 0xE19F     ; current drawing attribute
    95                                  C_CONTENT  equ 0xE1A2
    96                                  C_SEL      equ 0xE1A3
    97                                  C_HDR      equ 0xE1A8
    98                                  AMI_VSTR   equ 0x8292     ; word: base of the option value strings
    99                                  AMI_VIDSEG equ 0x4FF4     ; word: B800h / B000h
   100                                  
   101                                  ; BUBios state -- in the setup's zero-initialised, otherwise unused area
   102                                  BU_TAB     equ 0xEF80     ; current tab 0..NTABS-1
   103                                  BU_PEND    equ 0xEF81     ; Tab (+1) / Shift-Tab (-1) pressed inside a page
   104                                  BU_SEL     equ 0xEF82     ; selected entry on the Tools / Exit pages
   105                                  BU_MHZ     equ 0xEF84     ; word: measured clock in 1/10 MHz
   106                                  BU_CPU     equ 0xEF86     ; CPU family 3/4/5/6
   107                                  BU_FPU     equ 0xEF87     ; 1 = numeric coprocessor answered FNINIT
   108                                  BU_DTPOS   equ 0xEF88     ; word: row:col of the active date/time field, 0 = none
   109                                  BU_DTW     equ 0xEF8A     ; width of that field
   110                                  BU_BUF     equ 0xEF90     ; 40-byte text buffer
   111                                  
   112                                  NTABS      equ 6
   113                                  LBLW       equ 18         ; label field width on the Summary page
   114                                  ITEMSZ     equ 7          ; size of a Tools/Exit list entry
   115                                  
   116                                  ; =====================================================================
   117                                  section code start=0 vstart=0xDA84
   118                                  ; =====================================================================
   119                                  
   120                                  ; ---------------------------------------------------------------------
   121                                  ; bu_main -- replaces the AMI main menu (entered by JMP from 0x2997)
   122                                  ; ---------------------------------------------------------------------
   123                                  bu_main:
   124 00000000 E8(CB84)                    call A_RDCMOS
   125 00000003 E8(7750)                    call A_VIDINIT
   126 00000006 E8(9509)                    call A_CUROFF
   127 00000009 E8(7D00)                    call bu_detect
   128 0000000C C60687E100                  mov  byte [V_ITEM], 0
   129 00000011 E8(AE54)                    call A_SETUPOK
   130 00000014 09C0                        or   ax, ax
   131 00000016 7509                        jnz  .loop
   132 00000018 B8[4F03]                    mov  ax, s_foot_main
   133 0000001B E81A01                      call bu_hdr
   134 0000001E E9(0437)                    jmp  A_NOSETUP
   135                                  
   136                                  .loop:
   137 00000021 A080EF                      mov  al, [BU_TAB]
   138 00000024 3C01                        cmp  al, 1
   139 00000026 7225                        jb   .menu
   140 00000028 3C03                        cmp  al, 3
   141 0000002A 7721                        ja   .menu
   142                                      ; ---- AMI pages: Standard / Advanced / Chipset ----
   143 0000002C FEC8                        dec  al
   144 0000002E A287E1                      mov  [V_ITEM], al
   145 00000031 98                          cbw
   146 00000032 89C3                        mov  bx, ax
   147 00000034 D1E3                        shl  bx, 1
   148 00000036 C60681EF00                  mov  byte [BU_PEND], 0
   149 0000003B FF97[B901]                  call [bx+page_handlers]
   150 0000003F A081EF                      mov  al, [BU_PEND]
   151 00000042 08C0                        or   al, al
   152 00000044 7560                        jnz  .step
   153 00000046 C60680EF00                  mov  byte [BU_TAB], 0          ; plain ESC -> back to Summary
   154 0000004B EBD4                        jmp  .loop
   155                                  
   156                                  .menu:
   157 0000004D E86C01                      call bu_draw_page
   158 00000050 E8(0E53)                    call A_GETKEY
   159 00000053 A382E1                      mov  [V_KEY], ax
   160 00000056 83F81B                      cmp  ax, 0x001B
   161 00000059 7430                        je   .esc
   162 0000005B 83F809                      cmp  ax, 0x0009
   163 0000005E 7440                        je   .next
   164 00000060 3D0F01                      cmp  ax, 0x010F
   165 00000063 743F                        je   .prev
   166 00000065 3D4801                      cmp  ax, 0x0148
   167 00000068 744C                        je   .up
   168 0000006A 3D5001                      cmp  ax, 0x0150
   169 0000006D 745D                        je   .down
   170 0000006F 83F80D                      cmp  ax, 0x000D
   171 00000072 7472                        je   .enter
   172 00000074 3D4401                      cmp  ax, 0x0144
   173 00000077 0F848300                    je   .f10
   174 0000007B 3D3C01                      cmp  ax, 0x013C
   175 0000007E 0F848700                    je   .colour
   176 00000082 3D3D01                      cmp  ax, 0x013D
   177 00000085 0F848000                    je   .colour
   178 00000089 EB96                        jmp  .loop
   179                                  
   180                                  .esc:
   181 0000008B B005                        mov  al, NTABS-1               ; ESC on Summary -> Exit page
   182 0000008D 803E80EF00                  cmp  byte [BU_TAB], 0
   183 00000092 7402                        je   .set
   184 00000094 30C0                        xor  al, al                    ; ESC elsewhere -> Summary
   185                                  .set:
   186 00000096 A280EF                      mov  [BU_TAB], al
   187 00000099 C60682EF00                  mov  byte [BU_SEL], 0
   188 0000009E EB81                        jmp  .loop
   189                                  .next:
   190 000000A0 B001                        mov  al, 1
   191 000000A2 EB02                        jmp  .step
   192                                  .prev:
   193 000000A4 B0FF                        mov  al, -1
   194                                  .step:
   195 000000A6 020680EF                    add  al, [BU_TAB]
   196 000000AA 7902                        jns  .s1
   197 000000AC 0406                        add  al, NTABS
   198                                  .s1:
   199 000000AE 3C06                        cmp  al, NTABS
   200 000000B0 72E4                        jb   .set
   201 000000B2 2C06                        sub  al, NTABS
   202 000000B4 EBE0                        jmp  .set
   203                                  
   204                                  .up:
   205 000000B6 E85600                      call bu_list
   206 000000B9 09C9                        or   cx, cx
   207 000000BB 0F8462FF                    jz   .loop
   208 000000BF A082EF                      mov  al, [BU_SEL]
   209 000000C2 FEC8                        dec  al
   210 000000C4 791A                        jns  .sel
   211 000000C6 88C8                        mov  al, cl
   212 000000C8 FEC8                        dec  al
   213 000000CA EB14                        jmp  .sel
   214                                  .down:
   215 000000CC E84000                      call bu_list
   216 000000CF 09C9                        or   cx, cx
   217 000000D1 0F844CFF                    jz   .loop
   218 000000D5 A082EF                      mov  al, [BU_SEL]
   219 000000D8 FEC0                        inc  al
   220 000000DA 38C8                        cmp  al, cl
   221 000000DC 7202                        jb   .sel
   222 000000DE 30C0                        xor  al, al
   223                                  .sel:
   224 000000E0 A282EF                      mov  [BU_SEL], al
   225 000000E3 E93BFF                      jmp  .loop
   226                                  
   227                                  .enter:
   228 000000E6 E82600                      call bu_list
   229 000000E9 09C9                        or   cx, cx
   230 000000EB 0F8432FF                    jz   .loop
   231 000000EF E83A00                      call bu_item                   ; BX -> entry
   232 000000F2 8A4704                      mov  al, [bx+4]
   233 000000F5 A287E1                      mov  [V_ITEM], al
   234 000000F8 FF5705                      call [bx+5]
   235 000000FB E923FF                      jmp  .loop
   236                                  
   237                                  .f10:
   238 000000FE C60687E10A                  mov  byte [V_ITEM], 10
   239 00000103 E8(DD29)                    call A_SAVEEXIT                ; returns only if the answer was N
   240 00000106 E918FF                      jmp  .loop
   241                                  
   242                                  .colour:
   243 00000109 E8(BA50)                    call A_COLOUR
   244 0000010C E912FF                      jmp  .loop
   245                                  
   246                                  ; ---------------------------------------------------------------------
   247                                  ; bu_list: SI -> entry list of the current tab, CX = number of entries
   248                                  ; bu_item: BX -> entry [BU_SEL] of list SI
   249                                  ; ---------------------------------------------------------------------
   250                                  bu_list:
   251 0000010F 31C9                        xor  cx, cx
   252 00000111 BE[D101]                    mov  si, tools_list
   253 00000114 B104                        mov  cl, 4
   254 00000116 803E80EF04                  cmp  byte [BU_TAB], 4
   255 0000011B 740E                        je   .r
   256 0000011D BE[ED01]                    mov  si, exit_list
   257 00000120 B102                        mov  cl, 2
   258 00000122 803E80EF05                  cmp  byte [BU_TAB], 5
   259 00000127 7402                        je   .r
   260 00000129 31C9                        xor  cx, cx
   261 0000012B C3                      .r: ret
   262                                  
   263                                  bu_item:
   264 0000012C A082EF                      mov  al, [BU_SEL]
   265 0000012F B407                        mov  ah, ITEMSZ
   266 00000131 F6E4                        mul  ah
   267 00000133 89F3                        mov  bx, si
   268 00000135 01C3                        add  bx, ax
   269 00000137 C3                          ret
   270                                  
   271                                  ; ---------------------------------------------------------------------
   272                                  ; bu_hdr -- replaces the AMI screen header (0x38B5).
   273                                  ;   In: AX = footer caption (row 24), BX = page title (unused: the
   274                                  ;       active tab names the page).  All registers preserved.
   275                                  ; ---------------------------------------------------------------------
   276                                  bu_hdr:
   277 00000138 60                          pusha
   278 00000139 50                          push ax
   279 0000013A A0A8E1                      mov  al, [C_HDR]
   280 0000013D A29FE1                      mov  [V_ATTR], al
   281 00000140 31C0                        xor  ax, ax                    ; row 0: title bar
   282 00000142 BA4F00                      mov  dx, 0x004F
   283 00000145 E8(0E52)                    call A_FILL
   284 00000148 BB[C602]                    mov  bx, s_title
   285 0000014B 31C0                        xor  ax, ax                    ; row 0, column 0
   286 0000014D E8(BB52)                    call A_PRINTB
   287 00000150 B80001                      mov  ax, 0x0100                ; frame rows 1..24
   288 00000153 BA4F18                      mov  dx, 0x184F
   289 00000156 BB0300                      mov  bx, 3
   290 00000159 E8(9951)                    call A_BOX
   291 0000015C B80003                      mov  ax, 0x0300                ; separator under the tab bar
   292 0000015F B250                        mov  dl, 0x50
   293 00000161 BB1720                      mov  bx, 0x2017
   294 00000164 E8(6E52)                    call A_HLINE
   295                                      ; tab bar (row 2)
   296 00000167 BE[BF01]                    mov  si, tab_table
   297 0000016A 31C9                        xor  cx, cx
   298                                  .tab:
   299 0000016C A0A8E1                      mov  al, [C_HDR]
   300 0000016F 3A0E80EF                    cmp  cl, [BU_TAB]
   301 00000173 7503                        jne  .t1
   302 00000175 E82E00                      call bu_tabattr
   303                                  .t1:
   304 00000178 A29FE1                      mov  [V_ATTR], al
   305 0000017B AC                          lodsb                          ; column
   306 0000017C B402                        mov  ah, 2
   307 0000017E 8B1C                        mov  bx, [si]
   308 00000180 83C602                      add  si, 2
   309 00000183 51                          push cx
   310 00000184 E8(DF52)                    call A_PRINT
   311 00000187 59                          pop  cx
   312 00000188 41                          inc  cx
   313 00000189 83F906                      cmp  cx, NTABS
   314 0000018C 72DE                        jb   .tab
   315                                      ; footer and content area
   316 0000018E 5B                          pop  bx
   317 0000018F B82818                      mov  ax, 0x1828
   318 00000192 E8(0F39)                    call A_FOOTER
   319 00000195 A0A2E1                      mov  al, [C_CONTENT]
   320 00000198 A29FE1                      mov  [V_ATTR], al
   321 0000019B B80104                      mov  ax, 0x0401
   322 0000019E BA4E17                      mov  dx, 0x174E
   323 000001A1 E8(0E52)                    call A_FILL
   324 000001A4 61                          popa
   325 000001A5 C3                          ret
   326                                  
   327                                  ; active-tab attribute: one per colour scheme, inverse video on mono
   328                                  bu_tabattr:
   329 000001A6 B070                        mov  al, 0x70
   330 000001A8 813EF44F00B0                cmp  word [AMI_VIDSEG], 0xB000
   331 000001AE 740B                        je   .r
   332 000001B0 8A1E37E0                    mov  bl, [CMOS+0x37]
   333 000001B4 83E30F                      and  bx, 0x000F
   334 000001B7 8A87[B602]                  mov  al, [bx+tab_attrs]
   335 000001BB C3                      .r: ret
   336                                  
   337                                  ; ---------------------------------------------------------------------
   338                                  ; bu_draw_page -- Summary / Tools / Exit pages
   339                                  ; ---------------------------------------------------------------------
   340                                  bu_draw_page:
   341 000001BC 31DB                        xor  bx, bx
   342 000001BE B8[4F03]                    mov  ax, s_foot_main
   343 000001C1 E874FF                      call bu_hdr
   344 000001C4 A0A8E1                      mov  al, [C_HDR]
   345 000001C7 A29FE1                      mov  [V_ATTR], al
   346 000001CA B80016                      mov  ax, 0x1600                ; line above the help row
   347 000001CD B250                        mov  dl, 0x50
   348 000001CF BB1720                      mov  bx, 0x2017
   349 000001D2 E8(6E52)                    call A_HLINE
   350 000001D5 803E80EF00                  cmp  byte [BU_TAB], 0
   351 000001DA 745D                        je   bu_summary
   352                                      ; ---- list page ----
   353 000001DC E830FF                      call bu_list
   354 000001DF E357                        jcxz .done
   355 000001E1 31DB                        xor  bx, bx                    ; bl = index
   356 000001E3 B607                        mov  dh, 7                     ; first row
   357                                  .item:
   358 000001E5 51                          push cx
   359 000001E6 56                          push si
   360 000001E7 53                          push bx
   361 000001E8 52                          push dx
   362 000001E9 A0A2E1                      mov  al, [C_CONTENT]
   363 000001EC 3A1E82EF                    cmp  bl, [BU_SEL]
   364 000001F0 7503                        jne  .a
   365 000001F2 A0A3E1                      mov  al, [C_SEL]
   366 000001F5 A29FE1                  .a: mov  [V_ATTR], al
   367 000001F8 88F4                        mov  ah, dh                    ; selection bar, columns 22..57
   368 000001FA B016                        mov  al, 22
   369 000001FC B239                        mov  dl, 57
   370 000001FE E8(0E52)                    call A_FILL
   371 00000201 5A                          pop  dx
   372 00000202 5B                          pop  bx
   373 00000203 53                          push bx
   374 00000204 52                          push dx
   375 00000205 88D8                        mov  al, bl
   376 00000207 B407                        mov  ah, ITEMSZ
   377 00000209 F6E4                        mul  ah
   378 0000020B 89F3                        mov  bx, si
   379 0000020D 01C3                        add  bx, ax
   380 0000020F 8B1F                        mov  bx, [bx]                  ; label
   381 00000211 88F4                        mov  ah, dh
   382 00000213 B018                        mov  al, 24
   383 00000215 E8(DF52)                    call A_PRINT
   384 00000218 5A                          pop  dx
   385 00000219 5B                          pop  bx
   386 0000021A 5E                          pop  si
   387 0000021B 59                          pop  cx
   388 0000021C 80C602                      add  dh, 2
   389 0000021F FEC3                        inc  bl
   390 00000221 E2C2                        loop .item
   391                                      ; help text of the selected entry, row 23
   392 00000223 E8E9FE                      call bu_list
   393 00000226 E803FF                      call bu_item
   394 00000229 A0A2E1                      mov  al, [C_CONTENT]
   395 0000022C A29FE1                      mov  [V_ATTR], al
   396 0000022F 8B5F02                      mov  bx, [bx+2]
   397 00000232 B82817                      mov  ax, 0x1728
   398 00000235 E8(D252)                    call A_PRINTC
   399                                  .done:
   400 00000238 C3                          ret
   401                                  
   402                                  ; ---------------------------------------------------------------------
   403                                  ; bu_summary -- the entry page
   404                                  ; ---------------------------------------------------------------------
   405                                  bu_summary:
   406 00000239 B82703                      mov  ax, 0x0327                ; column divider rows 3..22
   407 0000023C B214                        mov  dl, 0x14
   408 0000023E BB8B40                      mov  bx, 0x408B
   409 00000241 E8(8652)                    call A_VLINE
   410 00000244 A0A2E1                      mov  al, [C_CONTENT]
   411 00000247 A29FE1                      mov  [V_ATTR], al
   412 0000024A BB[A403]                    mov  bx, s_tagline
   413 0000024D B82817                      mov  ax, 0x1728
   414 00000250 E8(D252)                    call A_PRINTC
   415 00000253 BE[FB01]                    mov  si, sum_table
   416                                  .e:
   417 00000256 AC                          lodsb
   418 00000257 3CFF                        cmp  al, 0xFF
   419 00000259 744F                        je   .done
   420 0000025B 88C6                        mov  dh, al                    ; row
   421 0000025D AC                          lodsb
   422 0000025E 88C2                        mov  dl, al                    ; column
   423 00000260 AD                          lodsw
   424 00000261 89C7                        mov  di, ax                    ; label
   425 00000263 AD                          lodsw                          ; value descriptor
   426 00000264 56                          push si
   427 00000265 52                          push dx
   428 00000266 57                          push di
   429 00000267 55                          push bp
   430 00000268 E85000                      call bu_value                  ; BX = value string or 0
   431 0000026B 5D                          pop  bp
   432 0000026C 5F                          pop  di
   433 0000026D 5A                          pop  dx
   434 0000026E 09DB                        or   bx, bx
   435 00000270 7435                        jz   .skip
   436 00000272 53                          push bx
   437 00000273 A0A2E1                      mov  al, [C_CONTENT]
   438 00000276 A29FE1                      mov  [V_ATTR], al
   439 00000279 89FB                        mov  bx, di
   440 0000027B 89D0                        mov  ax, dx
   441 0000027D E8(DF52)                    call A_PRINT
   442                                      ; dotted leader
   443 00000280 89FB                        mov  bx, di
   444 00000282 E82600                      call A_STRLEN_wrap             ; CX = label length
   445 00000285 52                          push dx
