  2092                              <1> section tools start=0x3000 vstart=0x19B0
  2093                              <1> ; =====================================================================
  2094                              <1> ; Setup, Tools page: "Auto-Detect Disks at Boot: On/Off".  Runs inside
  2095                              <1> ; the setup program (DS = 0100h, the RAM copy); the texts are DS-relative,
  2096                              <1> ; so they have to sit below E000h, which this block does.
  2097                              <1> ; ---------------------------------------------------------------------
  2098                              <1> BU_AUTOLBL equ 0xEFC0             ; label buffer in the setup's data area
  2099                              <1> 
  2100                              <1> bu_autolabel:                      ; build the label: "... at Boot: On"
  2101 00000000 60                  <1>     pusha
  2102 00000001 06                  <1>     push es
  2103 00000002 1E                  <1>     push ds
  2104 00000003 07                  <1>     pop  es
  2105 00000004 BE[5E00]            <1>     mov  si, s_it_auto
  2106 00000007 BFC0EF              <1>     mov  di, BU_AUTOLBL
  2107 0000000A AC                  <1> .c: lodsb
  2108 0000000B AA                  <1>     stosb
  2109 0000000C 08C0                <1>     or   al, al
  2110 0000000E 75FA                <1>     jnz  .c
  2111 00000010 4F                  <1>     dec  di
  2112 00000011 BE[7D00]            <1>     mov  si, s_off
  2113 00000014 E8(1307)            <1>     call auto_on
  2114 00000017 7403                <1>     jz   .s
  2115 00000019 BE[7A00]            <1>     mov  si, s_on
  2116 0000001C AC                  <1> .s: lodsb
  2117 0000001D AA                  <1>     stosb
  2118 0000001E 08C0                <1>     or   al, al
  2119 00000020 75FA                <1>     jnz  .s
  2120 00000022 07                  <1>     pop  es
  2121 00000023 61                  <1>     popa
  2122 00000024 C3                  <1>     ret
  2123                              <1> 
  2124                              <1> bu_autotoggle:
  2125 00000025 B400                <1>     mov  ah, 0
  2126 00000027 E8(1307)            <1>     call auto_on
  2127 0000002A 7502                <1>     jnz  .w
  2128 0000002C FEC4                <1>     inc  ah                        ; off -> on
  2129 0000002E B07F                <1> .w: mov  al, CM_FLAGS
  2130 00000030 E8(9DEE)            <1>     call P_CMOSWR
  2131 00000033 88267FE0            <1>     mov  [0xE000 + CM_FLAGS], ah   ; the setup's CMOS image too
  2132 00000037 80F4A5              <1>     xor  ah, 0xA5
  2133 0000003A B07E                <1>     mov  al, CM_CHECK
  2134 0000003C E8(9DEE)            <1>     call P_CMOSWR
  2135 0000003F 88267EE0            <1>     mov  [0xE000 + CM_CHECK], ah
  2136 00000043 C3                  <1>     ret
  2137                              <1> 
  2138                              <1> 
