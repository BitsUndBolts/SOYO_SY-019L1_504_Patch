  1653 00000428 F32EA4              <1>     rep  cs movsb
  1654 0000042B B8F7F3              <1>     mov  ax, 0xF3F7                ; 32 x DIV BX
  1655 0000042E B120                <1>     mov  cl, 32
  1656 00000430 F3AB                <1>     rep  stosw
  1657 00000432 B8E2BE              <1>     mov  ax, 0xBEE2                ; LOOP back to the first DIV
  1658 00000435 AB                  <1>     stosw
  1659 00000436 B0CB                <1>     mov  al, 0xCB                  ; RETF
  1660 00000438 AA                  <1>     stosb
  1661 00000439 07                  <1>     pop  es
  1662 0000043A 9C                  <1>     pushf                          ; keep the caller's interrupt flag:
  1663 0000043B FA                  <1>     cli                            ; early in POST interrupts are off
  1664 0000043C E461                <1>     in   al, 0x61
  1665 0000043E 50                  <1>     push ax
  1666 0000043F 24FC                <1>     and  al, 0xFC
  1667 00000441 E661                <1>     out  0x61, al
  1668 00000443 B0B0                <1>     mov  al, 0xB0
  1669 00000445 E643                <1>     out  0x43, al
  1670 00000447 B0FF                <1>     mov  al, 0xFF
  1671 00000449 E642                <1>     out  0x42, al
  1672 0000044B E642                <1>     out  0x42, al
  1673 0000044D E461                <1>     in   al, 0x61
  1674 0000044F 0C01                <1>     or   al, 1
  1675 00000451 E661                <1>     out  0x61, al
  1676 00000453 9A0000C007          <1>     call TLOOP_SEG:0
  1677 00000458 B080                <1>     mov  al, 0x80
  1678 0000045A E643                <1>     out  0x43, al
  1679 0000045C E442                <1>     in   al, 0x42
