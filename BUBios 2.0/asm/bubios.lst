  1886 00000072 C746FC0000          <1>     mov  word [bp-4], 0
  1887 00000077 66837C0C00          <1>     cmp  dword [si+12], 0          ; 28-bit LBA only
  1888 0000007C 0F854201            <1>     jne  ext_bad
  1889 00000080 668B4408            <1>     mov  eax, [si+8]
  1890 00000084 663DFFFFFF0F        <1>     cmp  eax, 0x0FFFFFFF
  1891 0000008A 0F873401            <1>     ja   ext_bad
