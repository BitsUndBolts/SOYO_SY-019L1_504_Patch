  2057                              <1> ext48:                             ; INT 13h AH=48h (part of bu_int13)
  2058 0000050D 833C1A              <1>     cmp  word [si], 0x1A
  2059 00000510 0F82(C201)          <1>     jb   ext_bad
  2060 00000514 56                  <1>     push si
  2061 00000515 8D76EC              <1>     lea  si, [bp-20]
  2062 00000518 B94200              <1>     mov  cx, 66                    ; 1 s
  2063 0000051B 31FF                <1>     xor  di, di                    ; no model text
  2064 0000051D E8(8003)            <1>     call ide_id
  2065 00000520 5F                  <1>     pop  di                        ; DS:DI = caller's buffer
  2066 00000521 B480                <1>     mov  ah, 0x80
  2067 00000523 0F82(C801)          <1>     jc   ext_done
  2068 00000527 C7051A00            <1>     mov  word [di], 0x1A
  2069 0000052B C745020000          <1>     mov  word [di+2], 0
  2070 00000530 6631C0              <1>     xor  eax, eax
  2071 00000533 8B46EC              <1>     mov  ax, [bp-20]
  2072 00000536 66894504            <1>     mov  [di+4], eax               ; cylinders
  2073 0000053A 8B46EE              <1>     mov  ax, [bp-18]
  2074 0000053D 66894508            <1>     mov  [di+8], eax               ; heads
  2075 00000541 8B46F0              <1>     mov  ax, [bp-16]
  2076 00000544 6689450C            <1>     mov  [di+12], eax              ; sectors per track
  2077 00000548 660FB74EEC          <1>     movzx ecx, word [bp-20]
  2078 0000054D 660FB756EE          <1>     movzx edx, word [bp-18]
  2079 00000552 660FAFCA            <1>     imul ecx, edx
  2080 00000556 660FAFC8            <1>     imul ecx, eax                  ; C*H*S
  2081 0000055A F646F302            <1>     test byte [bp-13], 2           ; LBA supported: words 60-61
  2082 0000055E 7404                <1>     jz   .tot
  2083 00000560 668B4EF4            <1>     mov  ecx, [bp-12]
  2084                              <1> .tot:
