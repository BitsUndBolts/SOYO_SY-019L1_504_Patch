  1662 000003FA B120                <1>     mov  cl, 32
  1663 000003FC F3AB                <1>     rep  stosw
  1664 000003FE B8E2BE              <1>     mov  ax, 0xBEE2                ; LOOP back to the first DIV
  1665 00000401 AB                  <1>     stosw
  1666 00000402 B0CB                <1>     mov  al, 0xCB                  ; RETF
  1667 00000404 AA                  <1>     stosb
  1668 00000405 07                  <1>     pop  es
  1669 00000406 FA                  <1>     cli
  1670 00000407 E461                <1>     in   al, 0x61
  1671 00000409 50                  <1>     push ax
  1672 0000040A 24FC                <1>     and  al, 0xFC
  1673 0000040C E661                <1>     out  0x61, al
  1674 0000040E B0B0                <1>     mov  al, 0xB0
  1675 00000410 E643                <1>     out  0x43, al
  1676 00000412 B0FF                <1>     mov  al, 0xFF
  1677 00000414 E642                <1>     out  0x42, al
  1678 00000416 E642                <1>     out  0x42, al
  1679 00000418 E461                <1>     in   al, 0x61
  1680 0000041A 0C01                <1>     or   al, 1
  1681 0000041C E661                <1>     out  0x61, al
  1682 0000041E 9A0000C007          <1>     call TLOOP_SEG:0
  1683 00000423 B080                <1>     mov  al, 0x80
  1684 00000425 E643                <1>     out  0x43, al
