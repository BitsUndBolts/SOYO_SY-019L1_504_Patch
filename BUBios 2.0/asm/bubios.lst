  1189                                  ; bu_dtentry -- numeric entry for a date/time field of the Standard page
  1190                                  ;   In : AL = first digit typed, [BU_DTPOS]/[BU_DTW] = field
  1191                                  ;   Out: AX = key to hand back to AMI's field loop
  1192                                  ;        Enter (next field) after a commit, 0 (ignored) after ESC,
  1193                                  ;        or the navigation key that ended the entry.
  1194                                  ;   Digits fill the field; it commits by itself when full.  Backspace
  1195                                  ;   deletes, ESC cancels.  Years may be typed with 2 or 4 digits.
  1196                                  bu_dtentry:
  1197 00000000 53                          push bx
  1198 00000001 51                          push cx
  1199 00000002 52                          push dx
  1200 00000003 56                          push si
  1201 00000004 57                          push di
  1202 00000005 55                          push bp
  1203 00000006 06                          push es
  1204 00000007 6A00                        push 0
  1205 00000009 07                          pop  es
  1206 0000000A 2680068E0240                add  byte [es:0x28E], 0x40     ; hold AMI's once-a-second clock redraw
  1207 00000010 8B1688EF                    mov  dx, [BU_DTPOS]
  1208 00000014 BE[9402]                    mov  si, dt_fields
  1209                                  .find:
  1210 00000017 833C00                      cmp  word [si], 0
  1211 0000001A 7409                        je   .none
  1212 0000001C 3914                        cmp  [si], dx
  1213 0000001E 7409                        je   .found
  1214 00000020 83C604                      add  si, 4
  1215 00000023 EBF2                        jmp  .find
  1216                                  .none:
  1217 00000025 31C0                        xor  ax, ax
  1218 00000027 EB70                        jmp  .done
  1219                                  .found:
  1220 00000029 C60690EF20                  mov  byte [BU_BUF], ' '
  1221 0000002E 31ED                        xor  bp, bp                    ; value
  1222 00000030 31C9                        xor  cx, cx                    ; CL = digits typed
  1223                                  .digit:
  1224 00000032 3A4C02                      cmp  cl, [si+2]
  1225 00000035 731D                        jae  .key
  1226 00000037 88CB                        mov  bl, cl
  1227 00000039 30FF                        xor  bh, bh
  1228 0000003B 888791EF                    mov  [bx+BU_BUF+1], al
  1229 0000003F 2C30                        sub  al, '0'
  1230 00000041 98                          cbw
  1231 00000042 95                          xchg ax, bp
  1232 00000043 BB0A00                      mov  bx, 10
  1233 00000046 F7E3                        mul  bx
  1234 00000048 01C5                        add  bp, ax
  1235 0000004A FEC1                        inc  cl
  1236 0000004C E85B00                      call dt_echo
  1237 0000004F 3A4C02                      cmp  cl, [si+2]
  1238 00000052 7338                        jae  .enter                    ; field full: commit, next field
  1239                                  .key:
  1240 00000054 B400                        mov  ah, 0
  1241 00000056 CD16                        int  0x16
  1242 00000058 3C30                        cmp  al, '0'
  1243 0000005A 7204                        jb   .nd
  1244 0000005C 3C39                        cmp  al, '9'
  1245 0000005E 76D2                        jbe  .digit
  1246                                  .nd:
  1247 00000060 3D080E                      cmp  ax, 0x0E08                ; Backspace
  1248 00000063 7516                        jne  .ne
  1249 00000065 08C9                        or   cl, cl
  1250 00000067 74EB                        jz   .key
  1251 00000069 FEC9                        dec  cl
  1252 0000006B 89E8                        mov  ax, bp
  1253 0000006D 31D2                        xor  dx, dx
  1254 0000006F BB0A00                      mov  bx, 10
  1255 00000072 F7F3                        div  bx
  1256 00000074 89C5                        mov  bp, ax
  1257 00000076 E83100                      call dt_echo
  1258 00000079 EBD9                        jmp  .key
  1259                                  .ne:
  1260 0000007B 80FC01                      cmp  ah, 1                     ; ESC: cancel
  1261 0000007E 7414                        je   .cancel
  1262 00000080 3D0D1C                      cmp  ax, 0x1C0D
  1263 00000083 7407                        je   .enter
  1264 00000085 50                          push ax                        ; any other key: commit and pass it on
  1265 00000086 E8(0000)                    call dt_commit
  1266 00000089 58                          pop  ax
  1267 0000008A EB0D                        jmp  .done
  1268                                  .enter:
  1269 0000008C E8(0000)                    call dt_commit
  1270 0000008F B80D1C                      mov  ax, 0x1C0D
  1271 00000092 EB05                        jmp  .done
  1272                                  .cancel:
  1273 00000094 E8(2260)                    call A_DTSHOW
  1274 00000097 31C0                        xor  ax, ax
  1275                                  .done:
  1276 00000099 6A00                        push 0
  1277 0000009B 07                          pop  es
  1278 0000009C 26802E8E0240                sub  byte [es:0x28E], 0x40
  1279 000000A2 07                          pop  es
  1280 000000A3 5D                          pop  bp
  1281 000000A4 5F                          pop  di
  1282 000000A5 5E                          pop  si
  1283 000000A6 5A                          pop  dx
  1284 000000A7 59                          pop  cx
  1285 000000A8 5B                          pop  bx
  1286 000000A9 C3                          ret
  1287                                  
  1288                                  ; show " digits" padded to the field width, in the highlight colour
  1289                                  dt_echo:
  1290 000000AA 60                          pusha
  1291 000000AB 88CB                        mov  bl, cl
  1292 000000AD 30FF                        xor  bh, bh
  1293 000000AF 8DBF91EF                    lea  di, [bx+BU_BUF+1]
  1294 000000B3 0FB6068AEF                  movzx ax, byte [BU_DTW]
  1295 000000B8 0590EF                      add  ax, BU_BUF
  1296                                  .pad:
  1297 000000BB 39C7                        cmp  di, ax
  1298 000000BD 7306                        jae  .pz
  1299 000000BF C60520                      mov  byte [di], ' '
  1300 000000C2 47                          inc  di
  1301 000000C3 EBF6                        jmp  .pad
  1302                                  .pz:
  1303 000000C5 C60500                      mov  byte [di], 0
  1304 000000C8 A0A3E1                      mov  al, [C_SEL]
  1305 000000CB A29FE1                      mov  [V_ATTR], al
  1306 000000CE A188EF                      mov  ax, [BU_DTPOS]            ; the field's highlight starts at its column
  1307 000000D1 BB90EF                      mov  bx, BU_BUF
  1308 000000D4 E8(DF52)                    call A_PRINT
  1309 000000D7 61                          popa
  1310 000000D8 C3                          ret
  1311                                  
  1312                                  ; =====================================================================
  1313                                  section code3 start=0x1400 vstart=0x7856
  1314                                  ; =====================================================================
  1315                                  ; dt_commit -- write the typed value to the RTC (if valid) and redraw
  1316                                  ;   In: BP = value, CL = digits typed, SI -> dt_fields entry
  1317                                  dt_commit:
  1318 00000000 08C9                        or   cl, cl
  1319 00000002 0F849500                    jz   .show
  1320 00000006 89EB                        mov  bx, bp
  1321 00000008 8A4403                      mov  al, [si+3]
  1322 0000000B 3C03                        cmp  al, 3
  1323 0000000D 7358                        jae  .time
  1324 0000000F 50                          push ax
  1325 00000010 E8(8061)                    call A_GETDATE
  1326 00000013 58                          pop  ax
  1327 00000014 3C01                        cmp  al, 1
  1328 00000016 7237                        jb   .mon
  1329 00000018 7441                        je   .day
  1330 0000001A 83FB64                      cmp  bx, 100                   ; year: 2 digits -> 1980..2079
  1331 0000001D 730D                        jae  .y4
  1332 0000001F 81C36C07                    add  bx, 1900
  1333 00000023 81FBBC07                    cmp  bx, 1980
  1334 00000027 7303                        jae  .y4
  1335 00000029 83C364                      add  bx, 100
  1336                                  .y4:
  1337 0000002C 81FB6D07                    cmp  bx, 1901
  1338 00000030 7269                        jb   .show
  1339 00000032 81FB3308                    cmp  bx, 2099
  1340 00000036 7763                        ja   .show
  1341 00000038 89D8                        mov  ax, bx
  1342 0000003A B364                        mov  bl, 100
  1343 0000003C F6F3                        div  bl
  1344 0000003E 88E7                        mov  bh, ah
  1345 00000040 E8(FB04)                    call dt_bcd
  1346 00000043 88C5                        mov  ch, al
  1347 00000045 88F8                        mov  al, bh
  1348 00000047 E8(FB04)                    call dt_bcd
  1349 0000004A 88C1                        mov  cl, al
  1350 0000004C E9(CB5F)                    jmp  A_SETDATE
  1351                                  .mon:
  1352 0000004F B40C                        mov  ah, 12
  1353 00000051 E8(E604)                    call dt_range1
  1354 00000054 7245                        jc   .show
  1355 00000056 88C6                        mov  dh, al
  1356 00000058 E9(CB5F)                    jmp  A_SETDATE
  1357                                  .day:
  1358 0000005B B41F                        mov  ah, 31
  1359 0000005D E8(E604)                    call dt_range1
  1360 00000060 7239                        jc   .show
  1361 00000062 88C2                        mov  dl, al
  1362 00000064 E9(CB5F)                    jmp  A_SETDATE
  1363                                  .time:
  1364 00000067 50                          push ax
  1365 00000068 E8(BA61)                    call A_GETTIME
  1366 0000006B 58                          pop  ax
  1367 0000006C 83FB3B                      cmp  bx, 59
  1368 0000006F 772A                        ja   .show
  1369 00000071 3C04                        cmp  al, 4
  1370 00000073 7216                        jb   .hour
  1371 00000075 50                          push ax
  1372 00000076 88D8                        mov  al, bl
  1373 00000078 E8(FB04)                    call dt_bcd
  1374 0000007B 88C4                        mov  ah, al
  1375 0000007D 5B                          pop  bx                        ; BL = kind
  1376 0000007E 80FB04                      cmp  bl, 4
  1377 00000081 7404                        je   .min
  1378 00000083 88E6                        mov  dh, ah
  1379 00000085 EB10                        jmp  .sett
  1380                                  .min:
  1381 00000087 88E1                        mov  cl, ah
  1382 00000089 EB0C                        jmp  .sett
  1383                                  .hour:
  1384 0000008B 83FB17                      cmp  bx, 23
  1385 0000008E 770B                        ja   .show
  1386 00000090 88D8                        mov  al, bl
  1387 00000092 E8(FB04)                    call dt_bcd
  1388 00000095 88C5                        mov  ch, al
  1389                                  .sett:
  1390 00000097 B403                        mov  ah, 3
  1391 00000099 CD1A                        int  0x1A
  1392                                  .show:
  1393 0000009B E9(2260)                    jmp  A_DTSHOW
  1394                                  
  1395                                  code3_end:
  1396                                  %include "post.asm"
     1                              <1> ; =====================================================================
     2                              <1> ;  BUBios 2.0 -- POST screen
     3                              <1> ;
     4                              <1> ;  Replaces AMI's start-up text (logo line, "Hit <DEL>", the memory
     5                              <1> ;  count, "WAIT......", the configuration box and the end-of-POST beep)
     6                              <1> ;  with one screen that is drawn as soon as the video BIOS is up and is
     7                              <1> ;  filled in while POST runs.  AMI's POST itself is not changed: every
     8                              <1> ;  hook replaces a print, or calls the AMI routine it replaces first.
     9                              <1> ;
    10                              <1> ;  Hook sites (patched and verified by py/build_bubios.py):
    11                              <1> ;    0x593B  MOV SI,8100 / CALL F52E (logo)  -> NOP x6
    12                              <1> ;    0x5945  CALL F42E (BIOS ID lines)       -> CALL bu_post_init
    13                              <1> ;    0x12BF  MOV SI,8100 / CALL F52E (logo)  -> NOP x6  (redraw after SETUP)
    14                              <1> ;    0x12C6  CALL F42E                       -> CALL bu_post_init
    15                              <1> ;    0x12CD  MOV SI,76AC / CALL F52E (WAIT)  -> CALL bu_wait + NOP x3
    16                              <1> ;    0x4F04  MOV SI,7688 / CALL F52E (DEL)   -> CALL bu_delmsg + NOP x3
    17                              <1> ;    0x4EA1  memory count print (49 bytes)   -> MOV AX,BX / ADD AX,BP /
    18                              <1> ;                                               CALL bu_memshow / JMP 4ED2
    19                              <1> ;    0x4CB4  CALL 4CD3 / MOV SI,76AC / CALL F52E (WAIT)
    20                              <1> ;                                            -> CALL bu_wait + NOP x6
    21                              <1> ;    0x1610  CALL F571 (end-of-POST beep)    -> CALL bu_chime
    22                              <1> ;    0x1613  CALL 16B7 (clear screen)        -> CALL bu_refresh
    23                              <1> ;    0x164C  CALL 39C0 (AMI config box)      -> CALL bu_final
    24                              <1> ;    0x120D, 0x158C  CALL 1656 (error list)  -> CALL bu_errors
    25                              <1> ;
    26                              <1> ;  All of it runs from segment F000 in real mode, with DS = 0040h (BDA)
    27                              <1> ;  on AMI's POST stack (0030:0100).  State between the hooks lives in
    28                              <1> ;  the BDA inter-application area 40:F0-40:FF; bu_final clears it again
    29                              <1> ;  before the boot.  Strings shared with the setup pages are read from
    30                              <1> ;  the BUBios data block (F000:79xx) with CS overrides.
    31                              <1> ;
    32                              <1> ;  The code fills the space of AMI's old configuration box
    33                              <1> ;  (0x39C0-0x3B83 and 0x3B8F-0x4033; AMI's shared CR/LF routine at
    34                              <1> ;  0x3B84-0x3B8E stays where it is).
    35                              <1> ; =====================================================================
    36                              <1> 
    37                              <1> ; ---- AMI POST routines ----------------------------------------------
    38                              <1> P_BIOSID   equ 0xF42E     ; BIOS ID lines (also sets the A20 gate, keep it)
    39                              <1> P_CMOSRD   equ 0xEE94     ; AL = CMOS register AL
    40                              <1> P_CHIPRD   equ 0x8EE3     ; AL = OPTi register AL (ports 22h/24h)
    41                              <1> P_OPTION   equ 0x8300     ; ZF=1 if AMI CMOS option AL is set
    42                              <1> P_IDEID    equ 0xAF07     ; AH=0: IDENTIFY drive DL into ES:BX, CF=error
    43                              <1> S_BIOSID   equ 0x8078     ; "40-040A-001102-00101111-111192-OP495SLC"
    44                              <1> O_BOOTSEQ  equ 0xB870     ; byte: AMI option code of "System Boot Up Sequence"
    45                              <1> 
    46                              <1> ; ---- state in the BDA inter-application area (DS = 0040h) ----------
    47                              <1> ST_FLAG    equ 0xF0       ; FLAG_UP = our screen is up (this POST)
    48                              <1> FLAG_UP    equ 0xB2
    49                              <1> ST_CPU     equ 0xF1       ; 3/4/5/6 = family, +80h = Cyrix core
    50                              <1> ST_FPU     equ 0xF2       ; 1 = coprocessor answered
    51                              <1> ST_SCH     equ 0xF3       ; colour scheme 0..5, 6 = monochrome
    52                              <1> ST_T0      equ 0xF4       ; word: RTC minute*60+second at the start
    53                              <1> ST_UNITS   equ 0xF6       ; word: 64 KB blocks counted so far
    54                              <1> ST_TOTAL   equ 0xF8       ; word: 64 KB blocks in total (0 = unknown)
    55                              <1> ST_STAT    equ 0xFA       ; word: status line text
    56                              <1> ST_MHZ     equ 0xFC       ; word: measured clock x10
    57                              <1> 
    58                              <1> ; ---- low memory used only at the very end of POST ---------------------
    59                              <1> TLOOP_SEG  equ 0x07C0     ; timing loop copied to 07C0:0000 (= 0:7C00)
    60                              <1> IDBUF      equ 0x7E00     ; IDENTIFY data at 0000:7E00
    61                              <1> 
    62                              <1> ; ---- attribute indices ------------------------------------------------
    63                              <1> AT_BG       equ 0
    64                              <1> AT_TITLE    equ 1
    65                              <1> AT_LABEL    equ 2
    66                              <1> AT_VALUE    equ 3
    67                              <1> AT_FILL     equ 4
    68                              <1> AT_EMPTY    equ 5
    69                              <1> AT_ACCENT   equ 6
    70                              <1> AT_ERR      equ 7
    71                              <1> AT_STAT     equ 8
    72                              <1> NATTR      equ 9
    73                              <1> 
    74                              <1> ; ---- layout -------------------------------------------------------------
    75                              <1> R_SYS      equ 2          ; rows 2..5: processor / system block
    76                              <1> R_MEM      equ 7          ; row 7 bar, row 8 block map
    77                              <1> R_FDD      equ 10
    78                              <1> R_HDC      equ 11         ; rows 11-12 disk C:, 13-14 disk D:
    79                              <1> R_PORTS    equ 15
    80                              <1> R_ROMS     equ 16
    81                              <1> R_LINE     equ 17
    82                              <1> R_MSG      equ 18         ; rows 18-20 and 22-23: messages (AMI's errors)
    83                              <1> R_AMI      equ 21         ; AMI copyright line: POST checks that it is on
    84                              <1>                           ; screen at row 21, column 0 (F3DB) and crashes
    85                              <1>                           ; on purpose if it is not
    86                              <1> R_STAT     equ 24
    87                              <1> C_LBL      equ 2
    88                              <1> C_VAL      equ 15
    89                              <1> C_RLBL     equ 42
    90                              <1> C_RVAL     equ 55
    91                              <1> BAR_W      equ 40
    92                              <1> MAP_MAX    equ 32
    93                              <1> 
    94                              <1> %define POS(r,c) (((r) << 8) | (c))
    95                              <1> 
    96                              <1> ; =====================================================================
    97                              <1> section post1 start=0x1800 vstart=0x39C0
    98                              <1> ; =====================================================================
    99                              <1> 
   100                              <1> ; ---------------------------------------------------------------------
   101                              <1> ; hook entry points
   102                              <1> ; ---------------------------------------------------------------------
   103                              <1> bu_post_init:                      ; replaces CALL F42E once video is up
   104 00000000 E8(2EF4)            <1>     call P_BIOSID                  ; keep AMI's side effects (A20 gate)
   105 00000003 E87B00              <1>     call enter
   106 00000006 E8(3B00)            <1>     call cpu_detect
   107 00000009 C706FA00[0405]      <1>     mov  word [ST_STAT], s_st_mem
   108 0000000F 803EF000B2          <1>     cmp  byte [ST_FLAG], FLAG_UP   ; second call (after SETUP): keep the
   109 00000014 7508                <1>     jne  .first                    ; memory count; the POST time would
   110 00000016 C706F400FFFF        <1>     mov  word [ST_T0], 0xFFFF      ; include the time spent in SETUP, so
   111 0000001C EB13                <1>     jmp  short .draw               ; it is not shown
   112                              <1> .first:
   113 0000001E C606F000B2          <1>     mov  byte [ST_FLAG], FLAG_UP
   114 00000023 E8(D600)            <1>     call rtc_now
   115 00000026 A3F400              <1>     mov  [ST_T0], ax
   116 00000029 31C0                <1>     xor  ax, ax
   117 0000002B A3F600              <1>     mov  [ST_UNITS], ax
   118 0000002E A3F800              <1>     mov  [ST_TOTAL], ax
   119                              <1> .draw:
   120 00000031 E8(B801)            <1>     call draw_all
   121 00000034 BA000F              <1>     mov  dx, POS(R_LINE-2, 0)       ; AMI keeps row+2 as its print row
   122 00000037 EB3E                <1>     jmp  leave_cur
   123                              <1> 
   124                              <1> bu_refresh:                        ; replaces the clear-screen before boot
   125 00000039 E84500              <1>     call enter
   126 0000003C B40F                <1>     mov  ah, 0x0F                  ; as AMI's 16B7: set the current mode again
   127 0000003E CD10                <1>     int  0x10
   128 00000040 B400                <1>     mov  ah, 0
   129 00000042 CD10                <1>     int  0x10
   130 00000044 803EF000B2          <1>     cmp  byte [ST_FLAG], FLAG_UP
   131 00000049 752F                <1>     jne  hook_ret                  ; our screen was never set up
   132 0000004B C706FA00[2E05]      <1>     mov  word [ST_STAT], s_st_dev
   133 00000051 E8(B801)            <1>     call draw_all
   134 00000054 EB1E                <1>     jmp  short leave_line
   135                              <1> 
   136                              <1> bu_delmsg:
   137 00000056 E82800              <1>     call enter
   138 00000059 B8[1705]            <1>     mov  ax, s_st_del
   139 0000005C EB06                <1>     jmp  short status
   140                              <1> bu_wait:
   141 0000005E E82000              <1>     call enter
   142 00000061 B8[2E05]            <1>     mov  ax, s_st_dev
   143                              <1> status:
   144 00000064 803EF000B2          <1>     cmp  byte [ST_FLAG], FLAG_UP
   145 00000069 750F                <1>     jne  hook_ret
   146 0000006B A3FA00              <1>     mov  [ST_STAT], ax
   147 0000006E E8(F500)            <1>     call vid_es
   148 00000071 E8(7802)            <1>     call draw_status
   149                              <1> leave_line:
   150 00000074 BA0011              <1>     mov  dx, POS(R_LINE, 0)         ; AMI's messages start on the next row
   151                              <1> leave_cur:
   152 00000077 E8(3D01)            <1>     call set_cursor
   153                              <1> hook_ret:
   154 0000007A 07                  <1>     pop  es
   155 0000007B 1F                  <1>     pop  ds
   156 0000007C 61                  <1>     popa
   157 0000007D 83C402              <1>     add  sp, 2                     ; the return address of 'enter'
   158 00000080 C3                  <1>     ret
   159                              <1> 
   160                              <1> ; enter: saves all registers and sets DS = 0040h (BX is changed).
   161                              <1> ; The hook then leaves through hook_ret.
   162                              <1> enter:
   163 00000081 60                  <1>     pusha
   164 00000082 1E                  <1>     push ds
   165 00000083 06                  <1>     push es
   166 00000084 6A40                <1>     push 0x40
   167 00000086 1F                  <1>     pop  ds
   168 00000087 89E3                <1>     mov  bx, sp
   169 00000089 36FF6714            <1>     jmp  word [ss:bx+20]
   170                              <1> 
   171                              <1> ; ---------------------------------------------------------------------
   172                              <1> ; bu_errors -- replaces CALL 1656 (AMI's error list) at 0x120D and 0x158C:
   173                              <1> ; gives the messages all six rows, including the copyright row (POST no
   174                              <1> ; longer checks it at this point), then runs AMI's routine
   175                              <1> ; ---------------------------------------------------------------------
   176                              <1> bu_errors:
   177 0000008D E8F1FF              <1>     call enter
   178 00000090 803EF000B2          <1>     cmp  byte [ST_FLAG], FLAG_UP
   179 00000095 751F                <1>     jne  .go
   180 00000097 E8(F500)            <1>     call vid_es
   181 0000009A B020                <1>     mov  al, ' '
   182 0000009C B307                <1>     mov  bl, AT_ERR
   183 0000009E B9E001              <1>     mov  cx, 80*6
   184 000000A1 BA0012              <1>     mov  dx, POS(R_MSG, 0)
   185 000000A4 E8(5401)            <1>     call fill_at
   186 000000A7 C706FA00[4305]      <1>     mov  word [ST_STAT], s_st_err
   187 000000AD E8(7802)            <1>     call draw_status
   188 000000B0 BA0011              <1>     mov  dx, POS(R_LINE, 0)
   189 000000B3 E8(3D01)            <1>     call set_cursor
   190 000000B6 07                  <1> .go:pop  es
   191 000000B7 1F                  <1>     pop  ds
   192 000000B8 61                  <1>     popa
   193 000000B9 83C402              <1>     add  sp, 2
   194 000000BC E9(5616)            <1>     jmp  0x1656
   195                              <1> 
   196                              <1> ; ---------------------------------------------------------------------
   197                              <1> ; bu_memshow -- memory count (replaces AMI's "nnnnnn KB OK")
   198                              <1> ;   In: AX = 64 KB blocks counted, DX = blocks still to go in this
   199                              <1> ;       pass, BP = first block of the pass (1 = base memory, 0Ah = 640K-1M,
   200                              <1> ;       10h = above 1 MB)
   201                              <1> ; ---------------------------------------------------------------------
   202                              <1> bu_memshow:
   203 000000BF E8BFFF              <1>     call enter
   204 000000C2 803EF000B2          <1>     cmp  byte [ST_FLAG], FLAG_UP
   205 000000C7 75B1                <1>     jne  hook_ret
   206 000000C9 A3F600              <1>     mov  [ST_UNITS], ax
   207 000000CC 83FD10              <1>     cmp  bp, 0x10
   208 000000CF 7205                <1>     jb   .base
   209 000000D1 01D0                <1>     add  ax, dx                    ; above 1 MB: AX+DX-1 = last block
   210 000000D3 48                  <1>     dec  ax
   211 000000D4 EB12                <1>     jmp  short .set
   212                              <1> .base:                             ; below 1 MB the total is not known yet:
   213 000000D6 B031                <1>     mov  al, 0x31                  ; use the extended memory found last time
   214 000000D8 E8(94EE)            <1>     call P_CMOSRD                  ; (CMOS 31h:30h, KB)
   215 000000DB 88C4                <1>     mov  ah, al
   216 000000DD B030                <1>     mov  al, 0x30
   217 000000DF E8(94EE)            <1>     call P_CMOSRD
   218 000000E2 C1E806              <1>     shr  ax, 6
   219 000000E5 83C010              <1>     add  ax, 16
   220                              <1> .set:
   221 000000E8 A3F800              <1>     mov  [ST_TOTAL], ax
   222 000000EB E8(F500)            <1>     call vid_es
   223 000000EE E8(A102)            <1>     call draw_memory
   224 000000F1 EB87                <1>     jmp  short hook_ret
   225                              <1> 
   226                              <1> post1_end:
   227                              <1> 
   228                              <1> ; =====================================================================
   229                              <1> section post2 start=0x1C00 vstart=0x3B8F
   230                              <1> ; =====================================================================
   231                              <1> 
   232                              <1> ; ---------------------------------------------------------------------
   233                              <1> ; bu_chime -- two short notes instead of the end-of-POST beep
   234                              <1> ; ---------------------------------------------------------------------
   235                              <1> bu_chime:
   236 00000000 60                  <1>     pusha
   237 00000001 BB7404              <1>     mov  bx, 1140                  ; ~1047 Hz (C6)
   238 00000004 E80800              <1>     call .note
   239 00000007 BBF902              <1>     mov  bx, 761                   ; ~1568 Hz (G6)
   240 0000000A E80200              <1>     call .note
   241 0000000D 61                  <1>     popa
   242 0000000E C3                  <1>     ret
   243                              <1> .note:
   244 0000000F B0B6                <1>     mov  al, 0xB6
   245 00000011 E643                <1>     out  0x43, al
   246 00000013 88D8                <1>     mov  al, bl
   247 00000015 E642                <1>     out  0x42, al
   248 00000017 88F8                <1>     mov  al, bh
   249 00000019 E642                <1>     out  0x42, al
   250 0000001B E461                <1>     in   al, 0x61
   251 0000001D 0C03                <1>     or   al, 3
   252 0000001F E661                <1>     out  0x61, al
   253 00000021 B9A00F              <1>     mov  cx, 4000                  ; 4000 refresh toggles x 15 us = 60 ms
   254 00000024 E461                <1> .t: in   al, 0x61
   255 00000026 2410                <1>     and  al, 0x10
   256 00000028 88C4                <1>     mov  ah, al
   257 0000002A E461                <1> .t2:in   al, 0x61
   258 0000002C 2410                <1>     and  al, 0x10
   259 0000002E 38E0                <1>     cmp  al, ah
   260 00000030 74F8                <1>     je   .t2
   261 00000032 E2F0                <1>     loop .t
   262 00000034 E461                <1>     in   al, 0x61
   263 00000036 24FC                <1>     and  al, 0xFC
   264 00000038 E661                <1>     out  0x61, al
   265 0000003A C3                  <1>     ret
   266                              <1> 
   267                              <1> ; ---------------------------------------------------------------------
   268                              <1> ; cpu_detect -> [ST_CPU], [ST_FPU]
   269                              <1> ; ---------------------------------------------------------------------
   270                              <1> cpu_detect:
   271 0000003B 31C0                <1>     xor  ax, ax                    ; Cyrix cores leave the flags alone on DIV
   272 0000003D 9E                  <1>     sahf
   273 0000003E B80500              <1>     mov  ax, 5
   274 00000041 B302                <1>     mov  bl, 2
   275 00000043 F6F3                <1>     div  bl
   276 00000045 9F                  <1>     lahf
   277 00000046 30C9                <1>     xor  cl, cl
   278 00000048 80FC02              <1>     cmp  ah, 2
   279 0000004B 7502                <1>     jne  .ac
   280 0000004D B180                <1>     mov  cl, 0x80
   281 0000004F B503                <1> .ac:mov  ch, 3
   282 00000051 66BB00000400        <1>     mov  ebx, 0x40000              ; AC flag: 486 and later
   283 00000057 E85F00              <1>     call flip
   284 0000005A 741C                <1>     jz   .fam
   285 0000005C B504                <1>     mov  ch, 4
   286 0000005E 66BB00002000        <1>     mov  ebx, 0x200000             ; ID flag: CPUID
   287 00000064 E85200              <1>     call flip
   288 00000067 740F                <1>     jz   .fam
   289 00000069 51                  <1>     push cx
   290 0000006A 66B801000000        <1>     mov  eax, 1
   291 00000070 0FA2                <1>     db   0x0F, 0xA2                ; CPUID
   292 00000072 59                  <1>     pop  cx
   293 00000073 88E5                <1>     mov  ch, ah
   294 00000075 80E50F              <1>     and  ch, 0x0F
   295                              <1> .fam:
   296 00000078 08CD                <1>     or   ch, cl
   297 0000007A 882EF100            <1>     mov  [ST_CPU], ch
   298 0000007E C606F20000          <1>     mov  byte [ST_FPU], 0          ; coprocessor: FNINIT/FNSTSW/FNSTCW probe
