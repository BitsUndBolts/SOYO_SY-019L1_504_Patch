  1822                              <1> ; =====================================================================
  1823                              <1> section lba start=0x2C00 vstart=0x3292
  1824                              <1> ; =====================================================================
  1825                              <1> ; INT 13h extensions (EDD 1.1 subset) for the hard disks 80h/81h:
  1826                              <1> ;   41h installation check, 42h extended read, 43h extended write,
  1827                              <1> ;   44h verify, 47h seek (no-op), 48h drive parameters.
  1828                              <1> ; Sectors are addressed as CHS through the drive's physical geometry (the
  1829                              <1> ; FDPT at INT 41h/46h, as AMI's own code does) as long as the request
  1830                              <1> ; stays inside it, and as 28-bit LBA beyond it.  The transfer is polled
  1831                              <1> ; PIO, one command per request (up to 127 sectors).  Entered from AMI's
  1832                              <1> ; INT 13h handler at A3E7 (patched to JMP bu_int13).
  1833                              <1> ; Frame: BP -> ES DS DI SI BP SP BX DX CX AX (PUSHA order) ; locals below.
  1834                              <1> ; ---------------------------------------------------------------------
  1835                              <1> bu_int13:
  1836 00000000 FB                  <1>     sti
  1837 00000001 FC                  <1>     cld
  1838 00000002 80FA80              <1>     cmp  dl, 0x80
  1839 00000005 720A                <1>     jb   .orig
  1840 00000007 80FC41              <1>     cmp  ah, 0x41
  1841 0000000A 7205                <1>     jb   .orig
  1842 0000000C 80FC48              <1>     cmp  ah, 0x48
  1843 0000000F 7606                <1>     jbe  ext13
  1844                              <1> .orig:
  1845 00000011 80FA80              <1>     cmp  dl, 0x80
  1846 00000014 E9(ECA3)            <1>     jmp  INT13_CONT
  1847                              <1> 
  1848                              <1> ext13:
  1849 00000017 60                  <1>     pusha
  1850 00000018 1E                  <1>     push ds
  1851 00000019 06                  <1>     push es
  1852 0000001A 89E5                <1>     mov  bp, sp
  1853 0000001C 83EC14              <1>     sub  sp, 20                    ; [bp-2] select byte, [bp-4] done,
  1854 0000001F 88D0                <1>     mov  al, dl                    ; [bp-6] command, [bp-8] LBA mode,
  1855                              <1>                                    ; [bp-20..bp-9] IDENTIFY words
  1856 00000021 247F                <1>     and  al, 0x7F
  1857 00000023 6A40                <1>     push 0x40
  1858 00000025 0FA1                <1>     pop  fs
  1859 00000027 643A067500          <1>     cmp  al, [fs:0x75]             ; that many hard disks?
  1860 0000002C 0F839201            <1>     jae  ext_bad
  1861 00000030 3C01                <1>     cmp  al, 1
  1862 00000032 0F878C01            <1>     ja   ext_bad
  1863 00000036 88C3                <1>     mov  bl, al                    ; BL = drive 0/1
  1864 00000038 C0E004              <1>     shl  al, 4
  1865 0000003B 0CA0                <1>     or   al, 0xA0
  1866 0000003D 8846FE              <1>     mov  [bp-2], al
  1867 00000040 8E5E02              <1>     mov  ds, [bp+2]                ; caller's DS:SI
  1868 00000043 8B7606              <1>     mov  si, [bp+6]
  1869 00000046 80FC41              <1>     cmp  ah, 0x41
  1870 00000049 0F84(4400)          <1>     je   ext41
  1871 0000004D 80FC48              <1>     cmp  ah, 0x48
  1872 00000050 0F84(0D05)          <1>     je   ext48
  1873 00000054 80FC47              <1>     cmp  ah, 0x47
  1874 00000057 0F846B01            <1>     je   ext_ok
  1875 0000005B 80FC45              <1>     cmp  ah, 0x45
  1876 0000005E 0F836001            <1>     jae  ext_bad
  1877                              <1>     ; ---- 42h / 43h / 44h
  1878 00000062 B120                <1>     mov  cl, 0x20                  ; READ SECTORS
  1879 00000064 80FC43              <1>     cmp  ah, 0x43
  1880 00000067 7206                <1>     jb   .cmd
  1881 00000069 B130                <1>     mov  cl, 0x30                  ; WRITE SECTORS
  1882 0000006B 7402                <1>     je   .cmd
  1883 0000006D B140                <1>     mov  cl, 0x40                  ; READ VERIFY SECTORS
  1884                              <1> .cmd:
