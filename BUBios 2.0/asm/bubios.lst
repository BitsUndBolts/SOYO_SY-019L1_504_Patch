  1679 00000416 B0B0                <1>     mov  al, 0xB0
  1680 00000418 E643                <1>     out  0x43, al
  1681 0000041A B0FF                <1>     mov  al, 0xFF
  1682 0000041C E642                <1>     out  0x42, al
  1683 0000041E E642                <1>     out  0x42, al
  1684 00000420 E461                <1>     in   al, 0x61
