  1196                                  ; bu_dtentry -- numeric entry for a date/time field of the Standard page
  1197                                  ;   In : AL = first digit typed, [BU_DTPOS]/[BU_DTW] = field
  1198                                  ;   Out: AX = key to hand back to AMI's field loop
  1199                                  ;        Enter (next field) after a commit, 0 (ignored) after ESC,
  1200                                  ;        or the navigation key that ended the entry.
  1201                                  ;   Digits fill the field; it commits by itself when full.  Backspace
  1202                                  ;   deletes, ESC cancels.  Years may be typed with 2 or 4 digits.
  1203                                  bu_dtentry:
  1204 00000000 53                          push bx
  1205 00000001 51                          push cx
  1206 00000002 52                          push dx
  1207 00000003 56                          push si
  1208 00000004 57                          push di
  1209 00000005 55                          push bp
  1210 00000006 06                          push es
  1211 00000007 6A00                        push 0
  1212 00000009 07                          pop  es
  1213 0000000A 2680068E0240                add  byte [es:0x28E], 0x40     ; hold AMI's once-a-second clock redraw
  1214 00000010 8B1688EF                    mov  dx, [BU_DTPOS]
  1215 00000014 BE[9B02]                    mov  si, dt_fields
  1216                                  .find:
  1217 00000017 833C00                      cmp  word [si], 0
  1218 0000001A 7409                        je   .none
  1219 0000001C 3914                        cmp  [si], dx
  1220 0000001E 7409                        je   .found
  1221 00000020 83C604                      add  si, 4
  1222 00000023 EBF2                        jmp  .find
  1223                                  .none:
  1224 00000025 31C0                        xor  ax, ax
  1225 00000027 EB70                        jmp  .done
  1226                                  .found:
  1227 00000029 C60690EF20                  mov  byte [BU_BUF], ' '
  1228 0000002E 31ED                        xor  bp, bp                    ; value
  1229 00000030 31C9                        xor  cx, cx                    ; CL = digits typed
  1230                                  .digit:
  1231 00000032 3A4C02                      cmp  cl, [si+2]
  1232 00000035 731D                        jae  .key
  1233 00000037 88CB                        mov  bl, cl
  1234 00000039 30FF                        xor  bh, bh
  1235 0000003B 888791EF                    mov  [bx+BU_BUF+1], al
  1236 0000003F 2C30                        sub  al, '0'
  1237 00000041 98                          cbw
  1238 00000042 95                          xchg ax, bp
  1239 00000043 BB0A00                      mov  bx, 10
  1240 00000046 F7E3                        mul  bx
  1241 00000048 01C5                        add  bp, ax
  1242 0000004A FEC1                        inc  cl
  1243 0000004C E85B00                      call dt_echo
  1244 0000004F 3A4C02                      cmp  cl, [si+2]
  1245 00000052 7338                        jae  .enter                    ; field full: commit, next field
  1246                                  .key:
  1247 00000054 B400                        mov  ah, 0
  1248 00000056 CD16                        int  0x16
  1249 00000058 3C30                        cmp  al, '0'
  1250 0000005A 7204                        jb   .nd
  1251 0000005C 3C39                        cmp  al, '9'
  1252 0000005E 76D2                        jbe  .digit
  1253                                  .nd:
  1254 00000060 3D080E                      cmp  ax, 0x0E08                ; Backspace
  1255 00000063 7516                        jne  .ne
  1256 00000065 08C9                        or   cl, cl
  1257 00000067 74EB                        jz   .key
  1258 00000069 FEC9                        dec  cl
  1259 0000006B 89E8                        mov  ax, bp
  1260 0000006D 31D2                        xor  dx, dx
  1261 0000006F BB0A00                      mov  bx, 10
  1262 00000072 F7F3                        div  bx
  1263 00000074 89C5                        mov  bp, ax
  1264 00000076 E83100                      call dt_echo
  1265 00000079 EBD9                        jmp  .key
  1266                                  .ne:
  1267 0000007B 80FC01                      cmp  ah, 1                     ; ESC: cancel
  1268 0000007E 7414                        je   .cancel
  1269 00000080 3D0D1C                      cmp  ax, 0x1C0D
  1270 00000083 7407                        je   .enter
  1271 00000085 50                          push ax                        ; any other key: commit and pass it on
  1272 00000086 E8(0000)                    call dt_commit
  1273 00000089 58                          pop  ax
  1274 0000008A EB0D                        jmp  .done
  1275                                  .enter:
  1276 0000008C E8(0000)                    call dt_commit
  1277 0000008F B80D1C                      mov  ax, 0x1C0D
  1278 00000092 EB05                        jmp  .done
  1279                                  .cancel:
  1280 00000094 E8(2260)                    call A_DTSHOW
  1281 00000097 31C0                        xor  ax, ax
  1282                                  .done:
  1283 00000099 6A00                        push 0
  1284 0000009B 07                          pop  es
  1285 0000009C 26802E8E0240                sub  byte [es:0x28E], 0x40
  1286 000000A2 07                          pop  es
  1287 000000A3 5D                          pop  bp
  1288 000000A4 5F                          pop  di
  1289 000000A5 5E                          pop  si
  1290 000000A6 5A                          pop  dx
  1291 000000A7 59                          pop  cx
  1292 000000A8 5B                          pop  bx
  1293 000000A9 C3                          ret
  1294                                  
  1295                                  ; show " digits" padded to the field width, in the highlight colour
  1296                                  dt_echo:
  1297 000000AA 60                          pusha
  1298 000000AB 88CB                        mov  bl, cl
  1299 000000AD 30FF                        xor  bh, bh
  1300 000000AF 8DBF91EF                    lea  di, [bx+BU_BUF+1]
  1301 000000B3 0FB6068AEF                  movzx ax, byte [BU_DTW]
  1302 000000B8 0590EF                      add  ax, BU_BUF
  1303                                  .pad:
  1304 000000BB 39C7                        cmp  di, ax
  1305 000000BD 7306                        jae  .pz
  1306 000000BF C60520                      mov  byte [di], ' '
  1307 000000C2 47                          inc  di
  1308 000000C3 EBF6                        jmp  .pad
  1309                                  .pz:
  1310 000000C5 C60500                      mov  byte [di], 0
  1311 000000C8 A0A3E1                      mov  al, [C_SEL]
  1312 000000CB A29FE1                      mov  [V_ATTR], al
  1313 000000CE A188EF                      mov  ax, [BU_DTPOS]            ; the field's highlight starts at its column
  1314 000000D1 BB90EF                      mov  bx, BU_BUF
  1315 000000D4 E8(DF52)                    call A_PRINT
  1316 000000D7 61                          popa
  1317 000000D8 C3                          ret
  1318                                  
  1319                                  ; =====================================================================
  1320                                  section code3 start=0x1400 vstart=0x7856
  1321                                  ; =====================================================================
  1322                                  ; dt_commit -- write the typed value to the RTC (if valid) and redraw
  1323                                  ;   In: BP = value, CL = digits typed, SI -> dt_fields entry
  1324                                  dt_commit:
  1325 00000000 08C9                        or   cl, cl
  1326 00000002 0F849500                    jz   .show
  1327 00000006 89EB                        mov  bx, bp
  1328 00000008 8A4403                      mov  al, [si+3]
  1329 0000000B 3C03                        cmp  al, 3
  1330 0000000D 7358                        jae  .time
  1331 0000000F 50                          push ax
  1332 00000010 E8(8061)                    call A_GETDATE
  1333 00000013 58                          pop  ax
  1334 00000014 3C01                        cmp  al, 1
  1335 00000016 7237                        jb   .mon
  1336 00000018 7441                        je   .day
  1337 0000001A 83FB64                      cmp  bx, 100                   ; year: 2 digits -> 1980..2079
  1338 0000001D 730D                        jae  .y4
  1339 0000001F 81C36C07                    add  bx, 1900
  1340 00000023 81FBBC07                    cmp  bx, 1980
  1341 00000027 7303                        jae  .y4
  1342 00000029 83C364                      add  bx, 100
  1343                                  .y4:
  1344 0000002C 81FB6D07                    cmp  bx, 1901
  1345 00000030 7269                        jb   .show
  1346 00000032 81FB3308                    cmp  bx, 2099
  1347 00000036 7763                        ja   .show
  1348 00000038 89D8                        mov  ax, bx
  1349 0000003A B364                        mov  bl, 100
  1350 0000003C F6F3                        div  bl
  1351 0000003E 88E7                        mov  bh, ah
  1352 00000040 E8(FE04)                    call dt_bcd
  1353 00000043 88C5                        mov  ch, al
  1354 00000045 88F8                        mov  al, bh
  1355 00000047 E8(FE04)                    call dt_bcd
  1356 0000004A 88C1                        mov  cl, al
  1357 0000004C E9(CB5F)                    jmp  A_SETDATE
  1358                                  .mon:
  1359 0000004F B40C                        mov  ah, 12
  1360 00000051 E8(E904)                    call dt_range1
  1361 00000054 7245                        jc   .show
  1362 00000056 88C6                        mov  dh, al
  1363 00000058 E9(CB5F)                    jmp  A_SETDATE
  1364                                  .day:
  1365 0000005B B41F                        mov  ah, 31
  1366 0000005D E8(E904)                    call dt_range1
  1367 00000060 7239                        jc   .show
  1368 00000062 88C2                        mov  dl, al
  1369 00000064 E9(CB5F)                    jmp  A_SETDATE
  1370                                  .time:
  1371 00000067 50                          push ax
  1372 00000068 E8(BA61)                    call A_GETTIME
  1373 0000006B 58                          pop  ax
  1374 0000006C 83FB3B                      cmp  bx, 59
  1375 0000006F 772A                        ja   .show
  1376 00000071 3C04                        cmp  al, 4
  1377 00000073 7216                        jb   .hour
  1378 00000075 50                          push ax
  1379 00000076 88D8                        mov  al, bl
  1380 00000078 E8(FE04)                    call dt_bcd
  1381 0000007B 88C4                        mov  ah, al
  1382 0000007D 5B                          pop  bx                        ; BL = kind
  1383 0000007E 80FB04                      cmp  bl, 4
  1384 00000081 7404                        je   .min
  1385 00000083 88E6                        mov  dh, ah
  1386 00000085 EB10                        jmp  .sett
  1387                                  .min:
  1388 00000087 88E1                        mov  cl, ah
  1389 00000089 EB0C                        jmp  .sett
  1390                                  .hour:
  1391 0000008B 83FB17                      cmp  bx, 23
  1392 0000008E 770B                        ja   .show
  1393 00000090 88D8                        mov  al, bl
  1394 00000092 E8(FE04)                    call dt_bcd
  1395 00000095 88C5                        mov  ch, al
  1396                                  .sett:
  1397 00000097 B403                        mov  ah, 3
  1398 00000099 CD1A                        int  0x1A
  1399                                  .show:
  1400 0000009B E9(2260)                    jmp  A_DTSHOW
  1401                                  
  1402                                  code3_end:
  1403                                  %include "post.asm"
     1                              <1> ; =====================================================================
     2                              <1> ;  BUBios 2.1 -- POST screen, drive auto-detection, INT 13h extensions
     3                              <1> ;
     4                              <1> ;  POST screen: replaces AMI's start-up text (logo line, "Hit <DEL>", the
     5                              <1> ;  memory count, "WAIT......", the configuration box and the end-of-POST
     6                              <1> ;  beep) with one screen that is drawn after the video card's own sign-on
     7                              <1> ;  and filled in while POST runs.  AMI's POST itself is not changed:
     8                              <1> ;  every hook replaces a print, or calls the AMI routine it replaces first.
     9                              <1> ;
    10                              <1> ;  Hook sites (patched and verified by py/build_bubios.py):
    11                              <1> ;    0x593B  MOV SI,8100 / CALL F52E (logo)  -> NOP x6
    12                              <1> ;    0x5945  CALL F42E (BIOS ID lines)       -> CALL bu_post_init
    13                              <1> ;    0x12BF  MOV SI,8100 / CALL F52E (logo)  -> NOP x6  (redraw after SETUP)
    14                              <1> ;    0x12C6  CALL F42E                       -> CALL bu_post_init
    15                              <1> ;    0x12CD  MOV SI,76AC / CALL F52E (WAIT)  -> CALL bu_wait + NOP x3
    16                              <1> ;    0x4F04  MOV SI,7688 / CALL F52E (DEL)   -> CALL bu_delmsg + NOP x3
    17                              <1> ;    0x4EA1  memory count print (49 bytes)   -> MOV AX,BX / ADD AX,BP /
    18                              <1> ;                                               CALL bu_memshow / JMP 4ED2
    19                              <1> ;    0x4CB4  CALL 4CD3 / MOV SI,76AC / CALL F52E (WAIT)
    20                              <1> ;                                            -> CALL bu_wait + NOP x6
    21                              <1> ;    0x120D, 0x158C  CALL 1656 (error list)  -> CALL bu_errors
    22                              <1> ;    0x1610  CALL F571 (end-of-POST beep)    -> CALL bu_chime
    23                              <1> ;    0x1613  CALL 16B7 (clear screen)        -> CALL bu_refresh
    24                              <1> ;    0x164C  CALL 39C0 (AMI config box)      -> CALL bu_final
    25                              <1> ;    0xF3DB  AMI's on-screen copyright check -> RET
    26                              <1> ;    0xA3E7  INT 13h entry (CMP DL,80/STI/CLD) -> JMP bu_int13 + NOP x2
    27                              <1> ;
    28                              <1> ;  All POST code runs from segment F000 in real mode, with DS = 0040h
    29                              <1> ;  (BDA) on AMI's POST stack (0030:0100).  State between the hooks lives
    30                              <1> ;  in the BDA inter-application area 40:F0-40:FF; bu_final clears it
    31                              <1> ;  before the boot.  Strings shared with the setup pages are read from the
    32                              <1> ;  BUBios data block (F000:79xx) with CS overrides.
    33                              <1> ;
    34                              <1> ;  Space used (all freed from dead AMI code, see README.md):
    35                              <1> ;    post1  0x39C0-0x3B83   hooks
    36                              <1> ;    post2  0x3B8F-0x4167   screen drawing
    37                              <1> ;    post3  0x429D-0x49DA   end of POST, IDENTIFY, auto-detect, texts
    38                              <1> ;    lba    0x3292-0x3481   INT 13h extensions (AH=41h-48h)
    39                              <1> ;    tools  0x19B0-0x1A79   setup: "Auto-Detect Disks at Boot" switch
    40                              <1> ; =====================================================================
    41                              <1> 
    42                              <1> ; ---- AMI POST routines ----------------------------------------------
    43                              <1> P_BIOSID   equ 0xF42E     ; BIOS ID lines (also sets the A20 gate, keep it)
    44                              <1> P_CMOSRD   equ 0xEE94     ; AL = CMOS register AL
    45                              <1> P_CMOSWR   equ 0xEE9D     ; CMOS register AL = AH
    46                              <1> P_CHIPRD   equ 0x8EE3     ; AL = OPTi register AL (ports 22h/24h)
    47                              <1> P_OPTION   equ 0x8300     ; ZF=1 if AMI CMOS option AL is set
    48                              <1> P_SETUP    equ 0xF104     ; password check (if set) + SETUP, as POST calls it
    49                              <1> S_BIOSID   equ 0x8078     ; "40-040A-001102-00101111-111192-OP495SLC"
    50                              <1> O_BOOTSEQ  equ 0xB870     ; byte: AMI option code of "System Boot Up Sequence"
    51                              <1> INT13_CONT equ 0xA3EC     ; AMI INT 13h after CMP DL,80h / STI / CLD
    52                              <1> INT13_FLOP equ 0xA446     ; (for reference: DL < 80h goes on to INT 40h)
    53                              <1> 
    54                              <1> ; ---- BUBios CMOS switch (outside both AMI checksums) -----------------
    55                              <1> CM_FLAGS   equ 0x7F       ; bit0 = auto-detect disks at boot
    56                              <1> CM_CHECK   equ 0x7E       ; = CM_FLAGS xor 0A5h, else the flags are ignored
    57                              <1> 
    58                              <1> ; ---- state in the BDA inter-application area (DS = 0040h) ----------
    59                              <1> ST_FLAG    equ 0xF0       ; FLAG_UP = our screen is up (this POST)
    60                              <1> FLAG_UP    equ 0xB2
    61                              <1> ST_CPU     equ 0xF1       ; 3/4/5/6 = family, +80h = Cyrix core
    62                              <1> ST_FPU     equ 0xF2       ; 1 = coprocessor answered
    63                              <1> ST_SCH     equ 0xF3       ; colour scheme 0..5, 6 = monochrome
    64                              <1> ST_T0      equ 0xF4       ; word: RTC minute*60+second at the start
    65                              <1> ST_UNITS   equ 0xF6       ; word: 64 KB blocks counted so far
    66                              <1> ST_TOTAL   equ 0xF8       ; word: 64 KB blocks in total (0 = unknown)
    67                              <1> ST_STAT    equ 0xFA       ; word: status line text
    68                              <1> ST_MHZ     equ 0xFC       ; word: measured clock x10 (0 = not shown yet)
    69                              <1> ST_DISK    equ 0xFE       ; bit0/1: C:/D: identified, bit4/5: C:/D: absent
    70                              <1> ST_MISC    equ 0xFF       ; bit0: POST time not meaningful (SETUP visited), bit1: end of POST
    71                              <1>                           ; bit1: memory test done (say 'Disabled' for cache)
    72                              <1> 
    73                              <1> ; ---- low memory used only while POST runs ---------------------------
    74                              <1> TLOOP_SEG  equ 0x07C0     ; timing loop copied to 07C0:0000 (= 0:7C00)
    75                              <1> 
    76                              <1> ; ---- timing: port 61h bit 4 toggles every 15.09 us --------------------
    77                              <1> SPLASH_T   equ 2          ; seconds the video card's sign-on stays visible
    78                              <1> BOOT_T     equ 3          ; seconds of countdown before the boot
    79                              <1> T_SECOND   equ 66         ; x 1000 toggles = 1 s
    80                              <1> 
    81                              <1> ; ---- attribute indices ------------------------------------------------
    82                              <1> AT_BG      equ 0
    83                              <1> AT_TITLE   equ 1
    84                              <1> AT_LABEL   equ 2
    85                              <1> AT_VALUE   equ 3
    86                              <1> AT_FILL    equ 4
    87                              <1> AT_EMPTY   equ 5
    88                              <1> AT_ACCENT  equ 6
    89                              <1> AT_ERR     equ 7
    90                              <1> AT_STAT    equ 8
    91                              <1> NATTR      equ 9
    92                              <1> 
    93                              <1> ; ---- layout -------------------------------------------------------------
    94                              <1> R_SYS      equ 2          ; rows 2..5: processor / system block
    95                              <1> R_MEM      equ 7          ; memory bar
    96                              <1> R_FDD      equ 9
    97                              <1> R_HDC      equ 10         ; rows 10-11 disk C:, 12-13 disk D:
    98                              <1> R_PORTS    equ 15
    99                              <1> R_ROMS     equ 16
   100                              <1> R_LINE     equ 17
   101                              <1> R_MSG      equ 18         ; rows 18..23: messages (AMI's errors)
   102                              <1> R_STAT     equ 24
   103                              <1> C_LBL      equ 2
   104                              <1> C_VAL      equ 15
   105                              <1> C_RLBL     equ 42
   106                              <1> C_RVAL     equ 55
   107                              <1> C_LBA      equ 58         ; "LBA nnnnn MB" on a disk's model row
   108                              <1> BAR_W      equ 40
   109                              <1> 
   110                              <1> %define POS(r,c) (((r) << 8) | (c))
   111                              <1> 
   112                              <1> ; =====================================================================
   113                              <1> section post1 start=0x1800 vstart=0x39C0
   114                              <1> ; =====================================================================
   115                              <1> 
   116                              <1> ; ---------------------------------------------------------------------
   117                              <1> ; bu_post_init -- replaces CALL F42E once the video BIOS is up
   118                              <1> ; ---------------------------------------------------------------------
   119                              <1> bu_post_init:
   120 00000000 E80A01              <1>     call enter
   121 00000003 E8(0601)            <1>     call vid_es                    ; the video card's sign-on: leave it on
   122 00000006 803EF000B2          <1>     cmp  byte [ST_FLAG], FLAG_UP   ; screen for SPLASH_T seconds (only if
   123 0000000B 7418                <1>     je   .go                       ; there is one, and not after SETUP)
   124 0000000D 31FF                <1>     xor  di, di
   125 0000000F B9D007              <1>     mov  cx, 80*25
   126                              <1> .scan:
   127 00000012 268A05              <1>     mov  al, [es:di]
   128 00000015 47                  <1>     inc  di
   129 00000016 47                  <1>     inc  di
   130 00000017 3C20                <1>     cmp  al, ' '
   131 00000019 7704                <1>     ja   .splash
   132 0000001B E2F5                <1>     loop .scan
   133 0000001D EB06                <1>     jmp  short .go
   134                              <1> .splash:
   135 0000001F B98400              <1>     mov  cx, SPLASH_T * T_SECOND
   136 00000022 E8(2E00)            <1>     call wait_units
   137                              <1> .go:
   138 00000025 E8(2EF4)            <1>     call P_BIOSID                  ; AMI's ID lines: keep its A20 handling
   139 00000028 E8(4C00)            <1>     call cpu_detect
   140 0000002B C706FA00[6A06]      <1>     mov  word [ST_STAT], s_st_mem
   141 00000031 803EF000B2          <1>     cmp  byte [ST_FLAG], FLAG_UP   ; second call (after SETUP): keep the
   142 00000036 7507                <1>     jne  .first                    ; memory count; the POST time would
   143 00000038 800EFF0001          <1>     or   byte [ST_MISC], 1         ; include the time spent in SETUP
   144 0000003D EB1F                <1>     jmp  short .draw
   145                              <1> .first:
   146 0000003F C606F000B2          <1>     mov  byte [ST_FLAG], FLAG_UP
   147 00000044 E8(E700)            <1>     call rtc_now
   148 00000047 A3F400              <1>     mov  [ST_T0], ax
   149 0000004A 31C0                <1>     xor  ax, ax
   150 0000004C A3F600              <1>     mov  [ST_UNITS], ax
   151 0000004F A3F800              <1>     mov  [ST_TOTAL], ax
   152 00000052 A3FC00              <1>     mov  [ST_MHZ], ax
   153 00000055 A3FE00              <1>     mov  [ST_DISK], ax             ; (and ST_MISC)
   154 00000058 E8(E703)            <1>     call measure_clock             ; shown only if it is a standard clock
   155 0000005B E8(E901)            <1>     call early_ports
   156                              <1> .draw:
   157 0000005E E8(3002)            <1>     call draw_all
   158 00000061 B91400              <1>     mov  cx, 20                    ; disks: a quick try (0.3 s) now, a
   159 00000064 E8(7902)            <1>     call detect_disks              ; longer one after the memory test
   160 00000067 BA000F              <1>     mov  dx, POS(R_LINE-2, 0)      ; AMI keeps row+2 as its print row
   161 0000006A E99600              <1>     jmp  leave_cur
   162                              <1> 
   163                              <1> ; ---------------------------------------------------------------------
   164                              <1> ; bu_refresh -- replaces the clear-screen before the configuration box
   165                              <1> ; ---------------------------------------------------------------------
   166                              <1> bu_refresh:
   167 0000006D E89D00              <1>     call enter
   168 00000070 C706FA00[9406]      <1>     mov  word [ST_STAT], s_st_dev
   169 00000076 E8(0601)            <1>     call vid_es
   170 00000079 803EF000B2          <1>     cmp  byte [ST_FLAG], FLAG_UP
   171 0000007E 7514                <1>     jne  .mode
   172 00000080 B001                <1>     mov  al, AT_TITLE              ; our screen still there? then no flash
   173 00000082 E8(2A01)            <1>     call attr
   174 00000085 263A260300          <1>     cmp  ah, [es:3]
   175 0000008A 7508                <1>     jne  .mode
   176 0000008C 26803E020042        <1>     cmp  byte [es:2], 'B'
   177 00000092 7419                <1>     je   .keep
   178                              <1> .mode:
   179 00000094 8026FE00FC          <1>     and  byte [ST_DISK], 0xFC      ; names are gone: IDENTIFY again later
   180 00000099 B40F                <1>     mov  ah, 0x0F                  ; as AMI's 16B7: set the current mode again
   181 0000009B CD10                <1>     int  0x10
   182 0000009D B400                <1>     mov  ah, 0
   183 0000009F CD10                <1>     int  0x10
   184 000000A1 803EF000B2          <1>     cmp  byte [ST_FLAG], FLAG_UP
   185 000000A6 755E                <1>     jne  hook_ret                  ; our screen was never set up
   186 000000A8 E8(3002)            <1>     call draw_all
   187 000000AB EB03                <1>     jmp  short .vals
   188                              <1> .keep:
   189 000000AD E8(D602)            <1>     call draw_status
   190                              <1> .vals:
   191 000000B0 E8(0000)            <1>     call fill_values
   192 000000B3 EB4B                <1>     jmp  short leave_line
   193                              <1> 
   194                              <1> ; ---------------------------------------------------------------------
   195                              <1> ; bu_delmsg / bu_wait -- status line texts
   196                              <1> ; ---------------------------------------------------------------------
   197                              <1> bu_delmsg:
   198 000000B5 E85500              <1>     call enter
   199 000000B8 B8[7D06]            <1>     mov  ax, s_st_del
   200 000000BB EB33                <1>     jmp  short status
   201                              <1> bu_wait:                           ; memory test done: disks, values
   202 000000BD E84D00              <1>     call enter
   203 000000C0 803EF000B2          <1>     cmp  byte [ST_FLAG], FLAG_UP
   204 000000C5 753F                <1>     jne  hook_ret
   205 000000C7 C706FA00[9406]      <1>     mov  word [ST_STAT], s_st_dev
   206 000000CD E8(0601)            <1>     call vid_es
   207 000000D0 E8(D602)            <1>     call draw_status
   208 000000D3 833EFC0000          <1>     cmp  word [ST_MHZ], 0          ; clock not known yet: try again
   209 000000D8 7503                <1>     jne  .c
   210 000000DA E8(E703)            <1>     call measure_clock
   211 000000DD B91400              <1> .c: mov  cx, 20                    ; auto-detect on: give a spinning-up
   212 000000E0 E8(CF04)            <1>     call auto_on                   ; drive up to 10 s, it has to be set up
   213 000000E3 7403                <1>     jz   .d                        ; before AMI's disk initialisation
   214 000000E5 B99402              <1>     mov  cx, 10 * T_SECOND
   215 000000E8 E8(7902)            <1> .d: call detect_disks
   216 000000EB E8(0000)            <1>     call fill_values
   217 000000EE EB10                <1>     jmp  short leave_line
   218                              <1> status:
   219 000000F0 803EF000B2          <1>     cmp  byte [ST_FLAG], FLAG_UP
   220 000000F5 750F                <1>     jne  hook_ret
   221 000000F7 A3FA00              <1>     mov  [ST_STAT], ax
   222 000000FA E8(0601)            <1>     call vid_es
   223 000000FD E8(D602)            <1>     call draw_status
   224                              <1> leave_line:
   225 00000100 BA0011              <1>     mov  dx, POS(R_LINE, 0)        ; AMI's messages start on the next row
   226                              <1> leave_cur:
   227 00000103 E8(5001)            <1>     call set_cursor
   228                              <1> hook_ret:
   229 00000106 07                  <1>     pop  es
   230 00000107 1F                  <1>     pop  ds
   231 00000108 61                  <1>     popa
   232 00000109 83C402              <1>     add  sp, 2                     ; the return address of 'enter'
   233 0000010C C3                  <1>     ret
   234                              <1> 
   235                              <1> ; enter: saves all registers and sets DS = 0040h (BX is changed).
   236                              <1> ; The hook then leaves through hook_ret.
   237                              <1> enter:
   238 0000010D 60                  <1>     pusha
   239 0000010E 1E                  <1>     push ds
   240 0000010F 06                  <1>     push es
   241 00000110 6A40                <1>     push 0x40
   242 00000112 1F                  <1>     pop  ds
   243 00000113 89E3                <1>     mov  bx, sp
   244 00000115 36FF6714            <1>     jmp  word [ss:bx+20]
   245                              <1> 
   246                              <1> ; ---------------------------------------------------------------------
   247                              <1> ; bu_errors -- replaces CALL 1656 (AMI's error list) at 0x120D, 0x158C
   248                              <1> ; ---------------------------------------------------------------------
   249                              <1> bu_errors:
   250 00000119 E8F1FF              <1>     call enter
   251 0000011C 803EF000B2          <1>     cmp  byte [ST_FLAG], FLAG_UP
   252 00000121 751F                <1>     jne  .go
   253 00000123 E8(0601)            <1>     call vid_es
   254 00000126 B020                <1>     mov  al, ' '
   255 00000128 B307                <1>     mov  bl, AT_ERR
   256 0000012A B9E001              <1>     mov  cx, 80*6
   257 0000012D BA0012              <1>     mov  dx, POS(R_MSG, 0)
   258 00000130 E8(6701)            <1>     call fill_at
   259 00000133 C706FA00[A906]      <1>     mov  word [ST_STAT], s_st_err
   260 00000139 E8(D602)            <1>     call draw_status
   261 0000013C BA0011              <1>     mov  dx, POS(R_LINE, 0)
   262 0000013F E8(5001)            <1>     call set_cursor
   263 00000142 07                  <1> .go:pop  es
   264 00000143 1F                  <1>     pop  ds
   265 00000144 61                  <1>     popa
   266 00000145 83C402              <1>     add  sp, 2
   267 00000148 E9(5616)            <1>     jmp  0x1656
   268                              <1> 
   269                              <1> ; ---------------------------------------------------------------------
   270                              <1> ; bu_memshow -- memory count (replaces AMI's "nnnnnn KB OK")
   271                              <1> ;   In: AX = 64 KB blocks counted, DX = blocks still to go in this
   272                              <1> ;       pass, BP = first block of the pass (1 = base memory, 0Ah = 640K-1M,
   273                              <1> ;       10h = above 1 MB)
   274                              <1> ; ---------------------------------------------------------------------
