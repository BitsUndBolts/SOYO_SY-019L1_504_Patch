  1683 00000464 F7D0                <1>     not  ax
  1684 00000466 93                  <1>     xchg ax, bx                    ; BX = elapsed PIT ticks
  1685 00000467 58                  <1>     pop  ax
  1686 00000468 E661                <1>     out  0x61, al
  1687 0000046A 9D                  <1>     popf
  1688 0000046B 31F6                <1>     xor  si, si                    ; K for 386 / 486 / 586+
  1689 0000046D A0F100              <1>     mov  al, [ST_CPU]
  1690 00000470 247F                <1>     and  al, 0x7F
