  1575 000003A6 B0EC                <1>     mov  al, 0xEC
  1576 000003A8 EE                  <1>     out  dx, al
  1577 000003A9 B80889              <1>     mov  ax, 0x8908                ; BSY=0, DRQ=1 (ERR ends the wait)
  1578 000003AC E8(6804)            <1>     call ide_wait
