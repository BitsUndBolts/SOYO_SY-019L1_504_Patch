  1909 000000C4 660FAFD1            <1>     imul edx, ecx
  1910 000000C8 660FAFD3            <1>     imul edx, ebx                  ; C*H*S
  1911 000000CC 6650                <1>     push eax
  1912 000000CE 660FB74C02          <1>     movzx ecx, word [si+2]
  1913 000000D3 6601C8              <1>     add  eax, ecx                  ; end of the request
  1914 000000D6 6639D0              <1>     cmp  eax, edx
  1915 000000D9 0F9746F8            <1>     seta byte [bp-8]               ; beyond CHS: LBA addressing
  1916 000000DD BAF601              <1>     mov  dx, 0x1F6                 ; select the drive, wait until ready
  1917 000000E0 8A46FE              <1>     mov  al, [bp-2]
  1918 000000E3 EE                  <1>     out  dx, al
  1919 000000E4 B840C0              <1>     mov  ax, 0xC040
  1920 000000E7 B94A01              <1>     mov  cx, 5 * 66                ; 5 s
  1921 000000EA E8(6804)            <1>     call ide_wait
