  1561 0000038C B2F7                <1>     mov  dl, 0xF7
  1562 0000038E EC                  <1>     in   al, dx                    ; (400 ns settle)
  1563 0000038F EC                  <1>     in   al, dx
  1564 00000390 EC                  <1>     in   al, dx
  1565 00000391 EC                  <1>     in   al, dx
