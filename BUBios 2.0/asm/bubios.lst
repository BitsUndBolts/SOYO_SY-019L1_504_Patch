  2158                              <1> cmos_sum:                          ; AX = both AMI CMOS checksums and the
  2159 000005D5 B07F                <1>     mov  al, 0x7F                  ; auto-detect switch (7Eh/7Fh, outside
  2160 000005D7 E8(9802)            <1>     call bcd_raw                   ; the checksums) added up
  2161 000005DA 50                  <1>     push ax
  2162 000005DB B03F                <1>     mov  al, 0x3F
  2163 000005DD E8(9802)            <1>     call bcd_raw
  2164 000005E0 50                  <1>     push ax
  2165 000005E1 B02F                <1>     mov  al, 0x2F
  2166 000005E3 E8(9802)            <1>     call bcd_raw                   ; (bcd_raw changes BX)
  2167 000005E6 5B                  <1>     pop  bx
  2168 000005E7 01D8                <1>     add  ax, bx
  2169 000005E9 5B                  <1>     pop  bx
  2170 000005EA 01D8                <1>     add  ax, bx
  2171 000005EC C3                  <1>     ret
