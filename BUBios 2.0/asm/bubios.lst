  1672 0000040C AA                  <1>     stosb
  1673 0000040D 07                  <1>     pop  es
  1674 0000040E FA                  <1>     cli
  1675 0000040F E461                <1>     in   al, 0x61
  1676 00000411 50                  <1>     push ax
