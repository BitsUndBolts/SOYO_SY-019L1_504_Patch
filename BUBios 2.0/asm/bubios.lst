  1942 0000011A 88E0                <1>     mov  al, ah
  1943 0000011C EE                  <1>     out  dx, al
  1944 0000011D 58                  <1>     pop  ax
  1945 0000011E 0A46FE              <1>     or   al, [bp-2]
