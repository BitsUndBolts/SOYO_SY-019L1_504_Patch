  1843 0000001F 88D0                <1>     mov  al, dl                    ; [bp-6] command, [bp-8] LBA mode,
  1844                              <1>                                    ; [bp-20..bp-9] IDENTIFY words
  1845 00000021 247F                <1>     and  al, 0x7F
  1846 00000023 6A40                <1>     push 0x40
