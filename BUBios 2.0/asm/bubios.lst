  1568 00000358 B2F7                <1>     mov  dl, 0xF7
  1569 0000035A EC                  <1>     in   al, dx                    ; (400 ns settle)
  1570 0000035B EC                  <1>     in   al, dx
  1571 0000035C EC                  <1>     in   al, dx
  1572 0000035D EC                  <1>     in   al, dx
