  2140 00000044 817E0CAA55          <1>     cmp  word [bp+12], 0x55AA
  2141 00000049 0F85(C201)          <1>     jne  ext_bad
  2142 0000004D C7460C55AA          <1>     mov  word [bp+12], 0xAA55
  2143 00000052 C746100100          <1>     mov  word [bp+16], 0x0001      ; 42h-44h, 47h, 48h
  2144 00000057 C6461321            <1>     mov  byte [bp+19], 0x21        ; EDD 1.1
  2145 0000005B E9(D601)            <1>     jmp  ext_ret
