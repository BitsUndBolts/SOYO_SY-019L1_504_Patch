  1584                              <1> ; ide_id -- IDENTIFY DEVICE by polling (no IRQ, no buffer)
  1585                              <1> ;   In : BL = drive (0/1), CX = timeout (15 ms units), SS:SI = 12 bytes
  1586                              <1> ;        ES:DI = where the model name goes (DI = 0: nowhere), BH = attribute
  1587                              <1> ;   Out: CF=0: [SI] = cylinders, heads, sectors (words 1, 3, 6), word 49,
  1588                              <1> ;        words 60-61 (LBA sectors); CF=1: AL=1 no drive, AL=0 no answer
  1589                              <1> ide_id:
  1590 000003A3 52                  <1>     push dx
