     1                                  ; =====================================================================
     2                                  ;  BUBios -- MR-BIOS-style front end for the AMIBIOS 11/11/92 setup
     3                                  ;  (SOYO SY-019L1, OPTi 82C495SLC, 27C512) -- version 1.0
     4                                  ;
     5                                  ;  Built on top of the hardware-confirmed ECHS ROM
     6                                  ;  (binary/SY019L1_27C512_CHSPATCH.BIN of the parent project).
     7                                  ;
     8                                  ;  What this adds (all patch sites are applied and verified by
     9                                  ;  py/build_bubios.py, which asserts the original bytes first):
    10                                  ;
    11                                  ;    0x36D4  AMI main menu            -> JMP bu_main   (tab bar + pages)
    12                                  ;    0x38B5  AMI screen header        -> JMP bu_hdr    (title bar + tabs)
    13                                  ;    0x0D3D  option-editor getkey     -> CALL bu_edkey (Tab / Shift-Tab)
    14                                  ;    0x08D5  Standard-CMOS getkey     -> CALL bu_stdkey + NOP (Tab, digits)
    15                                  ;    0x5F94  date/time field getkey   -> CALL bu_dtkey (numeric date/time entry)
    16                                  ;    0x5037  16 colour schemes        -> BUBios schemes (F2/F3 cycles them)
    17                                  ;    0x4FF6  "bright" OR-mask 0Fh     -> 08h (intensity only, keeps hue)
    18                                  ;    0x309A / 0x6D3A  footer texts    -> Tab/ESC hints
    19                                  ;
    20                                  ;  Code lives in the free block 0xDA84-0xDFFF (executed from F000).
    21                                  ;  Data (and the small timing loop) live in the free block 0x7902-0x7EFD.
    22                                  ;  The setup program copies F000:0000-DFFF to 0100:0000 and runs with
    23                                  ;  DS=SS=0100h, so DS-relative data must sit below 0xE000 -- and not in
    24                                  ;  0xDA84-0xDFFF, which is the setup's stack in that RAM copy.  That is
    25                                  ;  why every string/table is in the 0x79xx block.
    26                                  ; =====================================================================
    27                                  [map all bubios.map]
    28                                  BITS 16
    29                                  CPU 386
    30                                  
    31                                  ; ---- AMI setup routines (all near, segment F000) --------------------
    32                                  A_RDCMOS   equ 0x84CB     ; read CMOS into the image at DS:E000
    33                                  A_VIDINIT  equ 0x5077     ; video mode + colour scheme -> E1A2..E1A9
    34                                  A_CUROFF   equ 0x0995     ; hide cursor
    35                                  A_SETUPOK  equ 0x54AE     ; AX<>0 if menu item [E187] is available
    36                                  A_NOSETUP  equ 0x3704     ; "NO CMOS SETUP PRESENT" path (exits setup)
    37                                  A_BOX      equ 0x5199     ; box  AX=top-left DX=bottom-right BX=style
    38                                  A_FILL     equ 0x520E     ; fill AX=top-left DX=bottom-right, attr [E19F]
    39                                  A_HLINE    equ 0x526E     ; horizontal line AX=start DL=len BX=style
    40                                  A_VLINE    equ 0x5286     ; vertical line   AX=start DL=len BX=style
    41                                  A_PRINT    equ 0x52DF     ; print DS:BX at AX=row:col, attr [E19F]
    42                                  A_PRINTB   equ 0x52BB     ; same, bright
    43                                  A_PRINTC   equ 0x52D2     ; same, centred on column AL
    44                                  A_PUTCH    equ 0x52FA     ; print char AL at DX=row:col
    45                                  A_FOOTER   equ 0x390F     ; framed footer caption DS:BX centred at AX
    46                                  A_GETKEY   equ 0x530E     ; AX = ASCII, or 100h+scan for extended keys
    47                                  A_COLOUR   equ 0x50BA     ; F2/F3 colour cycling (reads [E182])
    48                                  A_SAVEEXIT equ 0x29DD     ; "Write to CMOS and Exit (Y/N)?"
    49                                  A_QUIT     equ 0x29EC     ; "Want to Quit Without Saving (Y/N)?"
    50                                  A_VALSTR   equ 0x5B21     ; AX = value string of option record [E18F]
    51                                  H_STD      equ 0x00EC     ; Standard CMOS setup page
    52                                  H_ADV      equ 0x0BDE     ; Advanced CMOS setup page
    53                                  H_CHIP     equ 0x0C05     ; Advanced chipset setup page
    54                                  H_DEF      equ 0x5486     ; load BIOS / power-on defaults ([E187]=5/6)
    55                                  H_PWD      equ 0xF1C8     ; change password
    56                                  H_DETECT   equ 0x4A44     ; auto-detect hard disk
    57                                  CALC_FACTOR equ 0x76F5    ; ECHS head-factor routine of the xlate patch
    58                                  A_STDKEY   equ 0x08CD     ; Standard CMOS field key reader (flags = navigation)
    59                                  A_GETDATE  equ 0x6180     ; CX = year, DH = month, DL = day (BCD, validated)
    60                                  A_GETTIME  equ 0x61BA     ; CH = hour, CL = min, DH = sec, DL = DST (BCD)
    61                                  A_SETDATE  equ 0x5FCB     ; set RTC date, day clamped to the month, redraw
    62                                  A_DTSHOW   equ 0x6022     ; redraw date, time and calendar
    63                                  
    64                                  ; ---- AMI option records used on the Summary page ----------------------
    65                                  R_EXTCACHE equ 0xBDE7     ; External Cache Memory
    66                                  R_VSHADOW  equ 0xBE8F     ; Video ROM Shadow C000,16K
    67                                  R_SSHADOW  equ 0xC057     ; System ROM Shadow F000,64K
    68                                  R_BOOTSEQ  equ 0xBDA3     ; System Boot Up Sequence
    69                                  R_NUMLOCK  equ 0xBD1D     ; System Boot Up Num Lock
    70                                  R_PASSWORD equ 0xBE6D     ; Password Checking Option
    71                                  
    72                                  ; ---- AMI strings reused (verified by the build script) ----------------
    73                                  S_FLOPPY   equ 0x6F35     ; "360  KB, 5.."  stride 17
    74                                  S_MONO     equ 0x6F8A
    75                                  S_COL80    equ 0x6F9B
    76                                  S_COL40    equ 0x6FAC
    77                                  S_VGA      equ 0x6FBD
    78                                  S_HELP_DEF equ 0x2D4F
    79                                  S_HELP_PON equ 0x2D9B
    80                                  S_HELP_PWD equ 0x2DE5
    81                                  S_HELP_DET equ 0x2E11
    82                                  S_HELP_SAV equ 0x2E7C
    83                                  S_HELP_QUT equ 0x2E75
    84                                  
    85                                  ; ---- setup data segment (DS = 0100h) ---------------------------------
    86                                  CMOS       equ 0xE000     ; CMOS image, CMOS+n = register n
    87                                  V_KEY      equ 0xE182
    88                                  V_ITEM     equ 0xE187     ; current AMI main-menu item (handlers read it)
    89                                  V_REC      equ 0xE18F
    90                                  V_VSTR     equ 0xE197
    91                                  V_ATTR     equ 0xE19F     ; current drawing attribute
    92                                  C_CONTENT  equ 0xE1A2
    93                                  C_SEL      equ 0xE1A3
    94                                  C_HDR      equ 0xE1A8
    95                                  AMI_VSTR   equ 0x8292     ; word: base of the option value strings
    96                                  AMI_VIDSEG equ 0x4FF4     ; word: B800h / B000h
    97                                  
    98                                  ; BUBios state -- in the setup's zero-initialised, otherwise unused area
    99                                  BU_TAB     equ 0xEF80     ; current tab 0..NTABS-1
   100                                  BU_PEND    equ 0xEF81     ; Tab (+1) / Shift-Tab (-1) pressed inside a page
   101                                  BU_SEL     equ 0xEF82     ; selected entry on the Tools / Exit pages
   102                                  BU_MHZ     equ 0xEF84     ; word: measured clock in 1/10 MHz
   103                                  BU_CPU     equ 0xEF86     ; CPU family 3/4/5/6
   104                                  BU_FPU     equ 0xEF87     ; 1 = numeric coprocessor answered FNINIT
   105                                  BU_DTPOS   equ 0xEF88     ; word: row:col of the active date/time field, 0 = none
   106                                  BU_DTW     equ 0xEF8A     ; width of that field
   107                                  BU_BUF     equ 0xEF90     ; 40-byte text buffer
   108                                  
   109                                  NTABS      equ 6
   110                                  LBLW       equ 18         ; label field width on the Summary page
   111                                  ITEMSZ     equ 7          ; size of a Tools/Exit list entry
   112                                  
   113                                  ; =====================================================================
   114                                  section code start=0 vstart=0xDA84
   115                                  ; =====================================================================
   116                                  
   117                                  ; ---------------------------------------------------------------------
   118                                  ; bu_main -- replaces the AMI main menu (entered by JMP from 0x2997)
   119                                  ; ---------------------------------------------------------------------
   120                                  bu_main:
   121 00000000 E8(CB84)                    call A_RDCMOS
   122 00000003 E8(7750)                    call A_VIDINIT
   123 00000006 E8(9509)                    call A_CUROFF
   124 00000009 E8(7D00)                    call bu_detect
   125 0000000C C60687E100                  mov  byte [V_ITEM], 0
   126 00000011 E8(AE54)                    call A_SETUPOK
   127 00000014 09C0                        or   ax, ax
   128 00000016 7509                        jnz  .loop
   129 00000018 B8[4F03]                    mov  ax, s_foot_main
   130 0000001B E81A01                      call bu_hdr
   131 0000001E E9(0437)                    jmp  A_NOSETUP
   132                                  
   133                                  .loop:
   134 00000021 A080EF                      mov  al, [BU_TAB]
   135 00000024 3C01                        cmp  al, 1
   136 00000026 7225                        jb   .menu
   137 00000028 3C03                        cmp  al, 3
   138 0000002A 7721                        ja   .menu
   139                                      ; ---- AMI pages: Standard / Advanced / Chipset ----
   140 0000002C FEC8                        dec  al
   141 0000002E A287E1                      mov  [V_ITEM], al
   142 00000031 98                          cbw
   143 00000032 89C3                        mov  bx, ax
   144 00000034 D1E3                        shl  bx, 1
   145 00000036 C60681EF00                  mov  byte [BU_PEND], 0
   146 0000003B FF97[B901]                  call [bx+page_handlers]
   147 0000003F A081EF                      mov  al, [BU_PEND]
   148 00000042 08C0                        or   al, al
   149 00000044 7560                        jnz  .step
   150 00000046 C60680EF00                  mov  byte [BU_TAB], 0          ; plain ESC -> back to Summary
   151 0000004B EBD4                        jmp  .loop
   152                                  
   153                                  .menu:
   154 0000004D E86C01                      call bu_draw_page
   155 00000050 E8(0E53)                    call A_GETKEY
   156 00000053 A382E1                      mov  [V_KEY], ax
   157 00000056 83F81B                      cmp  ax, 0x001B
   158 00000059 7430                        je   .esc
   159 0000005B 83F809                      cmp  ax, 0x0009
   160 0000005E 7440                        je   .next
   161 00000060 3D0F01                      cmp  ax, 0x010F
   162 00000063 743F                        je   .prev
   163 00000065 3D4801                      cmp  ax, 0x0148
   164 00000068 744C                        je   .up
   165 0000006A 3D5001                      cmp  ax, 0x0150
   166 0000006D 745D                        je   .down
   167 0000006F 83F80D                      cmp  ax, 0x000D
   168 00000072 7472                        je   .enter
   169 00000074 3D4401                      cmp  ax, 0x0144
   170 00000077 0F848300                    je   .f10
   171 0000007B 3D3C01                      cmp  ax, 0x013C
   172 0000007E 0F848700                    je   .colour
   173 00000082 3D3D01                      cmp  ax, 0x013D
   174 00000085 0F848000                    je   .colour
   175 00000089 EB96                        jmp  .loop
   176                                  
   177                                  .esc:
   178 0000008B B005                        mov  al, NTABS-1               ; ESC on Summary -> Exit page
   179 0000008D 803E80EF00                  cmp  byte [BU_TAB], 0
   180 00000092 7402                        je   .set
   181 00000094 30C0                        xor  al, al                    ; ESC elsewhere -> Summary
   182                                  .set:
   183 00000096 A280EF                      mov  [BU_TAB], al
   184 00000099 C60682EF00                  mov  byte [BU_SEL], 0
   185 0000009E EB81                        jmp  .loop
   186                                  .next:
   187 000000A0 B001                        mov  al, 1
   188 000000A2 EB02                        jmp  .step
   189                                  .prev:
   190 000000A4 B0FF                        mov  al, -1
   191                                  .step:
   192 000000A6 020680EF                    add  al, [BU_TAB]
   193 000000AA 7902                        jns  .s1
   194 000000AC 0406                        add  al, NTABS
   195                                  .s1:
   196 000000AE 3C06                        cmp  al, NTABS
   197 000000B0 72E4                        jb   .set
   198 000000B2 2C06                        sub  al, NTABS
   199 000000B4 EBE0                        jmp  .set
   200                                  
   201                                  .up:
   202 000000B6 E85600                      call bu_list
   203 000000B9 09C9                        or   cx, cx
   204 000000BB 0F8462FF                    jz   .loop
   205 000000BF A082EF                      mov  al, [BU_SEL]
   206 000000C2 FEC8                        dec  al
   207 000000C4 791A                        jns  .sel
   208 000000C6 88C8                        mov  al, cl
   209 000000C8 FEC8                        dec  al
   210 000000CA EB14                        jmp  .sel
   211                                  .down:
   212 000000CC E84000                      call bu_list
   213 000000CF 09C9                        or   cx, cx
   214 000000D1 0F844CFF                    jz   .loop
   215 000000D5 A082EF                      mov  al, [BU_SEL]
   216 000000D8 FEC0                        inc  al
   217 000000DA 38C8                        cmp  al, cl
   218 000000DC 7202                        jb   .sel
   219 000000DE 30C0                        xor  al, al
   220                                  .sel:
   221 000000E0 A282EF                      mov  [BU_SEL], al
   222 000000E3 E93BFF                      jmp  .loop
   223                                  
   224                                  .enter:
   225 000000E6 E82600                      call bu_list
   226 000000E9 09C9                        or   cx, cx
   227 000000EB 0F8432FF                    jz   .loop
   228 000000EF E83A00                      call bu_item                   ; BX -> entry
   229 000000F2 8A4704                      mov  al, [bx+4]
   230 000000F5 A287E1                      mov  [V_ITEM], al
   231 000000F8 FF5705                      call [bx+5]
   232 000000FB E923FF                      jmp  .loop
   233                                  
   234                                  .f10:
   235 000000FE C60687E10A                  mov  byte [V_ITEM], 10
   236 00000103 E8(DD29)                    call A_SAVEEXIT                ; returns only if the answer was N
   237 00000106 E918FF                      jmp  .loop
   238                                  
   239                                  .colour:
   240 00000109 E8(BA50)                    call A_COLOUR
   241 0000010C E912FF                      jmp  .loop
   242                                  
   243                                  ; ---------------------------------------------------------------------
   244                                  ; bu_list: SI -> entry list of the current tab, CX = number of entries
   245                                  ; bu_item: BX -> entry [BU_SEL] of list SI
   246                                  ; ---------------------------------------------------------------------
   247                                  bu_list:
   248 0000010F 31C9                        xor  cx, cx
   249 00000111 BE[D101]                    mov  si, tools_list
   250 00000114 B104                        mov  cl, 4
   251 00000116 803E80EF04                  cmp  byte [BU_TAB], 4
   252 0000011B 740E                        je   .r
   253 0000011D BE[ED01]                    mov  si, exit_list
   254 00000120 B102                        mov  cl, 2
   255 00000122 803E80EF05                  cmp  byte [BU_TAB], 5
   256 00000127 7402                        je   .r
   257 00000129 31C9                        xor  cx, cx
   258 0000012B C3                      .r: ret
   259                                  
   260                                  bu_item:
   261 0000012C A082EF                      mov  al, [BU_SEL]
   262 0000012F B407                        mov  ah, ITEMSZ
   263 00000131 F6E4                        mul  ah
   264 00000133 89F3                        mov  bx, si
   265 00000135 01C3                        add  bx, ax
   266 00000137 C3                          ret
   267                                  
   268                                  ; ---------------------------------------------------------------------
   269                                  ; bu_hdr -- replaces the AMI screen header (0x38B5).
   270                                  ;   In: AX = footer caption (row 24), BX = page title (unused: the
   271                                  ;       active tab names the page).  All registers preserved.
   272                                  ; ---------------------------------------------------------------------
   273                                  bu_hdr:
   274 00000138 60                          pusha
   275 00000139 50                          push ax
   276 0000013A A0A8E1                      mov  al, [C_HDR]
   277 0000013D A29FE1                      mov  [V_ATTR], al
   278 00000140 31C0                        xor  ax, ax                    ; row 0: title bar
   279 00000142 BA4F00                      mov  dx, 0x004F
   280 00000145 E8(0E52)                    call A_FILL
   281 00000148 BB[C602]                    mov  bx, s_title
   282 0000014B 31C0                        xor  ax, ax                    ; row 0, column 0
   283 0000014D E8(BB52)                    call A_PRINTB
   284 00000150 B80001                      mov  ax, 0x0100                ; frame rows 1..24
   285 00000153 BA4F18                      mov  dx, 0x184F
   286 00000156 BB0300                      mov  bx, 3
   287 00000159 E8(9951)                    call A_BOX
   288 0000015C B80003                      mov  ax, 0x0300                ; separator under the tab bar
   289 0000015F B250                        mov  dl, 0x50
   290 00000161 BB1720                      mov  bx, 0x2017
   291 00000164 E8(6E52)                    call A_HLINE
   292                                      ; tab bar (row 2)
   293 00000167 BE[BF01]                    mov  si, tab_table
   294 0000016A 31C9                        xor  cx, cx
   295                                  .tab:
   296 0000016C A0A8E1                      mov  al, [C_HDR]
   297 0000016F 3A0E80EF                    cmp  cl, [BU_TAB]
   298 00000173 7503                        jne  .t1
   299 00000175 E82E00                      call bu_tabattr
   300                                  .t1:
   301 00000178 A29FE1                      mov  [V_ATTR], al
   302 0000017B AC                          lodsb                          ; column
   303 0000017C B402                        mov  ah, 2
   304 0000017E 8B1C                        mov  bx, [si]
   305 00000180 83C602                      add  si, 2
   306 00000183 51                          push cx
   307 00000184 E8(DF52)                    call A_PRINT
   308 00000187 59                          pop  cx
   309 00000188 41                          inc  cx
   310 00000189 83F906                      cmp  cx, NTABS
   311 0000018C 72DE                        jb   .tab
   312                                      ; footer and content area
   313 0000018E 5B                          pop  bx
   314 0000018F B82818                      mov  ax, 0x1828
   315 00000192 E8(0F39)                    call A_FOOTER
   316 00000195 A0A2E1                      mov  al, [C_CONTENT]
   317 00000198 A29FE1                      mov  [V_ATTR], al
   318 0000019B B80104                      mov  ax, 0x0401
   319 0000019E BA4E17                      mov  dx, 0x174E
   320 000001A1 E8(0E52)                    call A_FILL
   321 000001A4 61                          popa
   322 000001A5 C3                          ret
   323                                  
   324                                  ; active-tab attribute: one per colour scheme, inverse video on mono
   325                                  bu_tabattr:
   326 000001A6 B070                        mov  al, 0x70
   327 000001A8 813EF44F00B0                cmp  word [AMI_VIDSEG], 0xB000
   328 000001AE 740B                        je   .r
   329 000001B0 8A1E37E0                    mov  bl, [CMOS+0x37]
   330 000001B4 83E30F                      and  bx, 0x000F
   331 000001B7 8A87[B602]                  mov  al, [bx+tab_attrs]
   332 000001BB C3                      .r: ret
   333                                  
   334                                  ; ---------------------------------------------------------------------
   335                                  ; bu_draw_page -- Summary / Tools / Exit pages
   336                                  ; ---------------------------------------------------------------------
   337                                  bu_draw_page:
   338 000001BC 31DB                        xor  bx, bx
   339 000001BE B8[4F03]                    mov  ax, s_foot_main
   340 000001C1 E874FF                      call bu_hdr
   341 000001C4 A0A8E1                      mov  al, [C_HDR]
   342 000001C7 A29FE1                      mov  [V_ATTR], al
   343 000001CA B80016                      mov  ax, 0x1600                ; line above the help row
   344 000001CD B250                        mov  dl, 0x50
   345 000001CF BB1720                      mov  bx, 0x2017
   346 000001D2 E8(6E52)                    call A_HLINE
   347 000001D5 803E80EF00                  cmp  byte [BU_TAB], 0
   348 000001DA 745D                        je   bu_summary
   349                                      ; ---- list page ----
   350 000001DC E830FF                      call bu_list
   351 000001DF E357                        jcxz .done
   352 000001E1 31DB                        xor  bx, bx                    ; bl = index
   353 000001E3 B607                        mov  dh, 7                     ; first row
   354                                  .item:
   355 000001E5 51                          push cx
   356 000001E6 56                          push si
   357 000001E7 53                          push bx
   358 000001E8 52                          push dx
   359 000001E9 A0A2E1                      mov  al, [C_CONTENT]
   360 000001EC 3A1E82EF                    cmp  bl, [BU_SEL]
   361 000001F0 7503                        jne  .a
   362 000001F2 A0A3E1                      mov  al, [C_SEL]
   363 000001F5 A29FE1                  .a: mov  [V_ATTR], al
   364 000001F8 88F4                        mov  ah, dh                    ; selection bar, columns 22..57
   365 000001FA B016                        mov  al, 22
   366 000001FC B239                        mov  dl, 57
   367 000001FE E8(0E52)                    call A_FILL
   368 00000201 5A                          pop  dx
   369 00000202 5B                          pop  bx
   370 00000203 53                          push bx
   371 00000204 52                          push dx
   372 00000205 88D8                        mov  al, bl
   373 00000207 B407                        mov  ah, ITEMSZ
   374 00000209 F6E4                        mul  ah
   375 0000020B 89F3                        mov  bx, si
   376 0000020D 01C3                        add  bx, ax
   377 0000020F 8B1F                        mov  bx, [bx]                  ; label
   378 00000211 88F4                        mov  ah, dh
   379 00000213 B018                        mov  al, 24
   380 00000215 E8(DF52)                    call A_PRINT
   381 00000218 5A                          pop  dx
   382 00000219 5B                          pop  bx
   383 0000021A 5E                          pop  si
   384 0000021B 59                          pop  cx
   385 0000021C 80C602                      add  dh, 2
   386 0000021F FEC3                        inc  bl
   387 00000221 E2C2                        loop .item
   388                                      ; help text of the selected entry, row 23
   389 00000223 E8E9FE                      call bu_list
   390 00000226 E803FF                      call bu_item
   391 00000229 A0A2E1                      mov  al, [C_CONTENT]
   392 0000022C A29FE1                      mov  [V_ATTR], al
   393 0000022F 8B5F02                      mov  bx, [bx+2]
   394 00000232 B82817                      mov  ax, 0x1728
   395 00000235 E8(D252)                    call A_PRINTC
   396                                  .done:
   397 00000238 C3                          ret
   398                                  
   399                                  ; ---------------------------------------------------------------------
   400                                  ; bu_summary -- the entry page
   401                                  ; ---------------------------------------------------------------------
   402                                  bu_summary:
   403 00000239 B82703                      mov  ax, 0x0327                ; column divider rows 3..22
   404 0000023C B214                        mov  dl, 0x14
   405 0000023E BB8B40                      mov  bx, 0x408B
   406 00000241 E8(8652)                    call A_VLINE
   407 00000244 A0A2E1                      mov  al, [C_CONTENT]
   408 00000247 A29FE1                      mov  [V_ATTR], al
   409 0000024A BB[A403]                    mov  bx, s_tagline
   410 0000024D B82817                      mov  ax, 0x1728
   411 00000250 E8(D252)                    call A_PRINTC
   412 00000253 BE[FB01]                    mov  si, sum_table
   413                                  .e:
   414 00000256 AC                          lodsb
   415 00000257 3CFF                        cmp  al, 0xFF
   416 00000259 744F                        je   .done
   417 0000025B 88C6                        mov  dh, al                    ; row
   418 0000025D AC                          lodsb
   419 0000025E 88C2                        mov  dl, al                    ; column
   420 00000260 AD                          lodsw
   421 00000261 89C7                        mov  di, ax                    ; label
   422 00000263 AD                          lodsw                          ; value descriptor
   423 00000264 56                          push si
   424 00000265 52                          push dx
   425 00000266 57                          push di
   426 00000267 55                          push bp
   427 00000268 E85000                      call bu_value                  ; BX = value string or 0
   428 0000026B 5D                          pop  bp
   429 0000026C 5F                          pop  di
   430 0000026D 5A                          pop  dx
   431 0000026E 09DB                        or   bx, bx
   432 00000270 7435                        jz   .skip
   433 00000272 53                          push bx
   434 00000273 A0A2E1                      mov  al, [C_CONTENT]
   435 00000276 A29FE1                      mov  [V_ATTR], al
   436 00000279 89FB                        mov  bx, di
   437 0000027B 89D0                        mov  ax, dx
   438 0000027D E8(DF52)                    call A_PRINT
   439                                      ; dotted leader
   440 00000280 89FB                        mov  bx, di
   441 00000282 E82600                      call A_STRLEN_wrap             ; CX = label length
   442 00000285 52                          push dx
   443 00000286 00CA                        add  dl, cl
   444 00000288 FEC2                        inc  dl                        ; first dot column
   445 0000028A B91200                      mov  cx, LBLW
   446 0000028D 28C1                        sub  cl, al                    ; (AL = label length)
