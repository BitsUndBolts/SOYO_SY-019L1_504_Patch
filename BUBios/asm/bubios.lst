  2227                              <1> ; hd_remove: BL = drive that did not answer after the memory test: if CMOS
  2228                              <1> ; has it set up, set its type to "none" so that AMI's disk setup does not
  2229                              <1> ; wait for it (about a minute, then "HDD controller failure")
  2230                              <1> hd_remove:
  2231 00000000 53                  <1>     push bx
  2232 00000001 E8(0E03)            <1>     call disk_geo
  2233 00000004 5B                  <1>     pop  bx
  2234 00000005 7217                <1>     jc   .r                        ; not set up
  2235 00000007 B012                <1>     mov  al, 0x12
  2236 00000009 E8(94EE)            <1>     call P_CMOSRD
  2237 0000000C B40F                <1>     mov  ah, 0x0F                  ; keep the other drive's nibble
  2238 0000000E 08DB                <1>     or   bl, bl
  2239 00000010 7402                <1>     jz   .c
  2240 00000012 B4F0                <1>     mov  ah, 0xF0
  2241 00000014 20C4                <1> .c: and  ah, al
