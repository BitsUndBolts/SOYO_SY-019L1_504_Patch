  1855                              <1> ; =====================================================================
  1856                              <1> section lba start=0x2C00 vstart=0x3292
  1857                              <1> ; =====================================================================
  1858                              <1> ; INT 13h extensions (EDD 1.1 subset) for the hard disks 80h/81h:
  1859                              <1> ;   41h installation check, 42h extended read, 43h extended write,
  1860                              <1> ;   44h verify, 47h seek (no-op), 48h drive parameters.
  1861                              <1> ; Sectors are addressed as CHS through the drive's physical geometry (the
  1862                              <1> ; FDPT at INT 41h/46h, as AMI's own code does) as long as the request
  1863                              <1> ; stays inside it, and as 28-bit LBA beyond it.  The transfer is polled
  1864                              <1> ; PIO, one command per request (up to 127 sectors).  Entered from AMI's
  1865                              <1> ; INT 13h handler at A3E7 (patched to JMP bu_int13).
  1866                              <1> ; Frame: BP -> ES DS DI SI BP SP BX DX CX AX (PUSHA order) ; locals below.
  1867                              <1> ; ---------------------------------------------------------------------
  1868                              <1> bu_int13:
  1869 00000000 FB                  <1>     sti
  1870 00000001 FC                  <1>     cld
  1871 00000002 80FA80              <1>     cmp  dl, 0x80
  1872 00000005 720A                <1>     jb   .orig
  1873 00000007 80FC41              <1>     cmp  ah, 0x41
  1874 0000000A 7205                <1>     jb   .orig
  1875 0000000C 80FC48              <1>     cmp  ah, 0x48
  1876 0000000F 7606                <1>     jbe  ext13
  1877                              <1> .orig:
  1878 00000011 80FA80              <1>     cmp  dl, 0x80
  1879 00000014 E9(ECA3)            <1>     jmp  INT13_CONT
  1880                              <1> 
  1881                              <1> ext13:
  1882 00000017 60                  <1>     pusha
  1883 00000018 1E                  <1>     push ds
  1884 00000019 06                  <1>     push es
  1885 0000001A 89E5                <1>     mov  bp, sp
  1886 0000001C 83EC14              <1>     sub  sp, 20                    ; [bp-2] select byte, [bp-4] done,
  1887 0000001F 88D0                <1>     mov  al, dl                    ; [bp-6] command, [bp-8] LBA mode,
  1888                              <1>                                    ; [bp-20..bp-9] IDENTIFY words
  1889 00000021 247F                <1>     and  al, 0x7F
  1890 00000023 6A40                <1>     push 0x40
  1891 00000025 0FA1                <1>     pop  fs
  1892 00000027 643A067500          <1>     cmp  al, [fs:0x75]             ; that many hard disks?
  1893 0000002C 0F839201            <1>     jae  ext_bad
  1894 00000030 3C01                <1>     cmp  al, 1
  1895 00000032 0F878C01            <1>     ja   ext_bad
  1896 00000036 88C3                <1>     mov  bl, al                    ; BL = drive 0/1
  1897 00000038 C0E004              <1>     shl  al, 4
  1898 0000003B 0CA0                <1>     or   al, 0xA0
  1899 0000003D 8846FE              <1>     mov  [bp-2], al
  1900 00000040 8E5E02              <1>     mov  ds, [bp+2]                ; caller's DS:SI
  1901 00000043 8B7606              <1>     mov  si, [bp+6]
  1902 00000046 80FC41              <1>     cmp  ah, 0x41
  1903 00000049 0F84(4400)          <1>     je   ext41
  1904 0000004D 80FC48              <1>     cmp  ah, 0x48
  1905 00000050 0F84(0D05)          <1>     je   ext48
  1906 00000054 80FC47              <1>     cmp  ah, 0x47
  1907 00000057 0F846B01            <1>     je   ext_ok
  1908 0000005B 80FC45              <1>     cmp  ah, 0x45
  1909 0000005E 0F836001            <1>     jae  ext_bad
  1910                              <1>     ; ---- 42h / 43h / 44h
  1911 00000062 B120                <1>     mov  cl, 0x20                  ; READ SECTORS
  1912 00000064 80FC43              <1>     cmp  ah, 0x43
  1913 00000067 7206                <1>     jb   .cmd
  1914 00000069 B130                <1>     mov  cl, 0x30                  ; WRITE SECTORS
  1915 0000006B 7402                <1>     je   .cmd
  1916 0000006D B140                <1>     mov  cl, 0x40                  ; READ VERIFY SECTORS
  1917                              <1> .cmd:
  1918 0000006F 884EFA              <1>     mov  [bp-6], cl
  1919 00000072 C746FC0000          <1>     mov  word [bp-4], 0
  1920 00000077 66837C0C00          <1>     cmp  dword [si+12], 0          ; 28-bit LBA only
  1921 0000007C 0F854201            <1>     jne  ext_bad
  1922 00000080 668B4408            <1>     mov  eax, [si+8]
  1923 00000084 663DFFFFFF0F        <1>     cmp  eax, 0x0FFFFFFF
  1924 0000008A 0F873401            <1>     ja   ext_bad
  1925 0000008E 660FB74C02          <1>     movzx ecx, word [si+2]
  1926 00000093 09C9                <1>     or   cx, cx
  1927 00000095 0F842D01            <1>     jz   ext_ok
  1928 00000099 83F97F              <1>     cmp  cx, 127
  1929 0000009C 0F872201            <1>     ja   ext_bad
  1930 000000A0 51                  <1>     push cx
