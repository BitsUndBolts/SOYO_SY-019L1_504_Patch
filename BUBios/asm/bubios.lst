  1697 0000045F AA                  <1>     stosb
  1698 00000460 07                  <1>     pop  es
  1699 00000461 9C                  <1>     pushf                          ; keep the caller's interrupt flag:
  1700 00000462 FA                  <1>     cli                            ; early in POST interrupts are off
  1701 00000463 E461                <1>     in   al, 0x61
  1702 00000465 50                  <1>     push ax
  1703 00000466 24FC                <1>     and  al, 0xFC
  1704 00000468 E661                <1>     out  0x61, al
  1705 0000046A B0B0                <1>     mov  al, 0xB0
  1706 0000046C E643                <1>     out  0x43, al
  1707 0000046E B0FF                <1>     mov  al, 0xFF
  1708 00000470 E642                <1>     out  0x42, al
  1709 00000472 E642                <1>     out  0x42, al
