  1935 000000A8 08DB                <1>     or   bl, bl
  1936 000000AA 7403                <1>     jz   .v
  1937 000000AC BF1801              <1>     mov  di, 0x118                 ; INT 46h vector (D:)
  1938 000000AF 650FB53D            <1> .v: lgs  di, [gs:di]
  1939 000000B3 65660FB65D0E        <1>     movzx ebx, byte [gs:di+0x0E]   ; sectors
  1940 000000B9 65660FB715          <1>     movzx edx, word [gs:di]
  1941 000000BE 65660FB64D02        <1>     movzx ecx, byte [gs:di+2]
  1942 000000C4 660FAFD1            <1>     imul edx, ecx
  1943 000000C8 660FAFD3            <1>     imul edx, ebx                  ; C*H*S
  1944 000000CC 6650                <1>     push eax
  1945 000000CE 660FB74C02          <1>     movzx ecx, word [si+2]
  1946 000000D3 6601C8              <1>     add  eax, ecx                  ; end of the request
  1947 000000D6 6639D0              <1>     cmp  eax, edx
  1948 000000D9 0F9746F8            <1>     seta byte [bp-8]               ; beyond CHS: LBA addressing
  1949 000000DD BAF601              <1>     mov  dx, 0x1F6                 ; select the drive, wait until ready
  1950 000000E0 8A46FE              <1>     mov  al, [bp-2]
  1951 000000E3 EE                  <1>     out  dx, al
  1952 000000E4 B840C0              <1>     mov  ax, 0xC040
  1953 000000E7 B94A01              <1>     mov  cx, 5 * 66                ; 5 s
  1954 000000EA E8(6704)            <1>     call ide_wait
  1955 000000ED 6658                <1>     pop  eax
  1956 000000EF 0F82C400            <1>     jc   .err
  1957 000000F3 807EF800            <1>     cmp  byte [bp-8], 0
  1958 000000F7 752A                <1>     jne  .lbamode
  1959                              <1>     ; CHS: sector = LBA mod S + 1, head = (LBA / S) mod H, cyl = / H
  1960 000000F9 6631D2              <1>     xor  edx, edx
  1961 000000FC 66F7F3              <1>     div  ebx
  1962 000000FF 42                  <1>     inc  dx
