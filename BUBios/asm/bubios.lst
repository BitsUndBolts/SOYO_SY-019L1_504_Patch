  2243 00000018 E8(9DEE)            <1>     call P_CMOSWR
  2244 0000001B E9(2405)            <1>     jmp  cmos_csum
  2245 0000001E C3                  <1> .r: ret
  2246                              <1> ; cf_chgline -- replaces AMI's stub (STC/RET at D385) called by INT 13h
  2247                              <1> ; AH=15h for a floppy: CF=1 = the drive has a change line. With a CF card
  2248                              <1> ; on the IDE bus (40:8F bit 3, set by bu_final; AMI never sets that bit)
  2249                              <1> ; the line cannot be read, so DOS is told there is none and checks the
  2250                              <1> ; disk itself. DS = 40h.
  2251                              <1> cf_chgline:
  2252 0000001F F6068F0008          <1>     test byte [0x8F], 8
  2253 00000024 7501                <1>     jnz  .r                        ; (TEST clears CF)
  2254 00000026 F9                  <1>     stc
  2255 00000027 C3                  <1> .r: ret
