  1594 000003AC 0CA0                <1>     or   al, 0xA0
  1595 000003AE EE                  <1>     out  dx, al
  1596 000003AF B2F7                <1>     mov  dl, 0xF7
  1597 000003B1 EC                  <1>     in   al, dx                    ; (400 ns settle)
  1598 000003B2 EC                  <1>     in   al, dx
  1599 000003B3 EC                  <1>     in   al, dx
  1600 000003B4 EC                  <1>     in   al, dx
