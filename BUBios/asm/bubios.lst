  1964 00000101 88D0                <1>     mov  al, dl
  1965 00000103 BAF301              <1>     mov  dx, 0x1F3
  1966 00000106 EE                  <1>     out  dx, al
  1967 00000107 58                  <1>     pop  ax
  1968 00000108 6631D2              <1>     xor  edx, edx
  1969 0000010B 65660FB65D02        <1>     movzx ebx, byte [gs:di+2]
  1970 00000111 66F7F3              <1>     div  ebx
  1971 00000114 52                  <1>     push dx
  1972 00000115 BAF401              <1>     mov  dx, 0x1F4
  1973 00000118 EE                  <1>     out  dx, al
  1974 00000119 42                  <1>     inc  dx
  1975 0000011A 88E0                <1>     mov  al, ah
  1976 0000011C EE                  <1>     out  dx, al
  1977 0000011D 58                  <1>     pop  ax
  1978 0000011E 0A46FE              <1>     or   al, [bp-2]
  1979 00000121 EB1B                <1>     jmp  short .dh
