     1                                  ; =====================================================================
     2                                  ;  BUBios -- MR-BIOS-style front end for the AMIBIOS 11/11/92 setup
     3                                  ;  (SOYO SY-019L1, OPTi 82C495SLC, 27C512) -- version 2.1
     4                                  ;
     5                                  ;  2.0 added the POST screen in post.asm (included at the end of this
     6                                  ;  file) and removed dead AMI code; 2.1 adds drive auto-detection at boot
     7                                  ;  and the INT 13h extensions (LBA); see README.md.
     8                                  ;
     9                                  ;  Built on top of the hardware-confirmed ECHS ROM
    10                                  ;  (binary/SY019L1_27C512_CHSPATCH.BIN of the parent project).
    11                                  ;
    12                                  ;  What this adds (all patch sites are applied and verified by
    13                                  ;  py/build_bubios.py, which asserts the original bytes first):
    14                                  ;
    15                                  ;    0x36D4  AMI main menu            -> JMP bu_main   (tab bar + pages)
    16                                  ;    0x38B5  AMI screen header        -> JMP bu_hdr    (title bar + tabs)
    17                                  ;    0x0D3D  option-editor getkey     -> CALL bu_edkey (Tab / Shift-Tab)
    18                                  ;    0x08D5  Standard-CMOS getkey     -> CALL bu_stdkey + NOP (Tab, digits)
    19                                  ;    0x5F94  date/time field getkey   -> CALL bu_dtkey (numeric date/time entry)
    20                                  ;    0x5037  16 colour schemes        -> BUBios schemes (F2/F3 cycles them)
    21                                  ;    0x4FF6  "bright" OR-mask 0Fh     -> 08h (intensity only, keeps hue)
    22                                  ;    0x309A / 0x6D3A  footer texts    -> Tab/ESC hints
    23                                  ;
    24                                  ;  Code lives in the free block 0xDA84-0xDFFF (executed from F000).
    25                                  ;  Data (and the small timing loop) live in the free block 0x7902-0x7EFD.
    26                                  ;  The setup program copies F000:0000-DFFF to 0100:0000 and runs with
    27                                  ;  DS=SS=0100h, so DS-relative data must sit below 0xE000 -- and not in
    28                                  ;  0xDA84-0xDFFF, which is the setup's stack in that RAM copy.  That is
    29                                  ;  why every string/table is in the 0x79xx block.
    30                                  ; =====================================================================
    31                                  [map all bubios.map]
    32                                  BITS 16
    33                                  CPU 386
    34                                  
    35                                  ; ---- AMI setup routines (all near, segment F000) --------------------
    36                                  A_RDCMOS   equ 0x84CB     ; read CMOS into the image at DS:E000
    37                                  A_VIDINIT  equ 0x5077     ; video mode + colour scheme -> E1A2..E1A9
    38                                  A_CUROFF   equ 0x0995     ; hide cursor
    39                                  A_SETUPOK  equ 0x54AE     ; AX<>0 if menu item [E187] is available
    40                                  A_NOSETUP  equ 0x3704     ; "NO CMOS SETUP PRESENT" path (exits setup)
    41                                  A_BOX      equ 0x5199     ; box  AX=top-left DX=bottom-right BX=style
    42                                  A_FILL     equ 0x520E     ; fill AX=top-left DX=bottom-right, attr [E19F]
    43                                  A_HLINE    equ 0x526E     ; horizontal line AX=start DL=len BX=style
    44                                  A_VLINE    equ 0x5286     ; vertical line   AX=start DL=len BX=style
    45                                  A_PRINT    equ 0x52DF     ; print DS:BX at AX=row:col, attr [E19F]
    46                                  A_PRINTB   equ 0x52BB     ; same, bright
    47                                  A_PRINTC   equ 0x52D2     ; same, centred on column AL
    48                                  A_PUTCH    equ 0x52FA     ; print char AL at DX=row:col
    49                                  A_FOOTER   equ 0x390F     ; framed footer caption DS:BX centred at AX
    50                                  A_GETKEY   equ 0x530E     ; AX = ASCII, or 100h+scan for extended keys
    51                                  A_COLOUR   equ 0x50BA     ; F2/F3 colour cycling (reads [E182])
    52                                  A_SAVEEXIT equ 0x29DD     ; "Write to CMOS and Exit (Y/N)?"
    53                                  A_QUIT     equ 0x29EC     ; "Want to Quit Without Saving (Y/N)?"
    54                                  A_VALSTR   equ 0x5B21     ; AX = value string of option record [E18F]
    55                                  H_STD      equ 0x00EC     ; Standard CMOS setup page
    56                                  H_ADV      equ 0x0BDE     ; Advanced CMOS setup page
    57                                  H_CHIP     equ 0x0C05     ; Advanced chipset setup page
    58                                  H_DEF      equ 0x5486     ; load BIOS / power-on defaults ([E187]=5/6)
    59                                  H_PWD      equ 0xF1C8     ; change password
    60                                  H_DETECT   equ 0x4A44     ; auto-detect hard disk
    61                                  CALC_FACTOR equ 0x76F5    ; ECHS head-factor routine of the xlate patch
    62                                  A_STDKEY   equ 0x08CD     ; Standard CMOS field key reader (flags = navigation)
    63                                  A_GETDATE  equ 0x6180     ; CX = year, DH = month, DL = day (BCD, validated)
    64                                  A_GETTIME  equ 0x61BA     ; CH = hour, CL = min, DH = sec, DL = DST (BCD)
    65                                  A_SETDATE  equ 0x5FCB     ; set RTC date, day clamped to the month, redraw
    66                                  A_DTSHOW   equ 0x6022     ; redraw date, time and calendar
    67                                  
    68                                  ; ---- AMI option records used on the Summary page ----------------------
    69                                  R_EXTCACHE equ 0xBDE7     ; External Cache Memory
    70                                  R_VSHADOW  equ 0xBE8F     ; Video ROM Shadow C000,16K
    71                                  R_SSHADOW  equ 0xC057     ; System ROM Shadow F000,64K
    72                                  R_BOOTSEQ  equ 0xBDA3     ; System Boot Up Sequence
    73                                  R_NUMLOCK  equ 0xBD1D     ; System Boot Up Num Lock
    74                                  R_PASSWORD equ 0xBE6D     ; Password Checking Option
    75                                  
    76                                  ; ---- AMI strings reused (verified by the build script) ----------------
    77                                  S_FLOPPY   equ 0x6F35     ; "360  KB, 5.."  stride 17
    78                                  S_MONO     equ 0x6F8A
    79                                  S_COL80    equ 0x6F9B
    80                                  S_COL40    equ 0x6FAC
    81                                  S_VGA      equ 0x6FBD
    82                                  S_HELP_DEF equ 0x2D4F
    83                                  S_HELP_PON equ 0x2D9B
    84                                  S_HELP_PWD equ 0x2DE5
    85                                  S_HELP_DET equ 0x2E11
    86                                  S_HELP_SAV equ 0x2E7C
    87                                  S_HELP_QUT equ 0x2E75
    88                                  
    89                                  ; ---- setup data segment (DS = 0100h) ---------------------------------
    90                                  CMOS       equ 0xE000     ; CMOS image, CMOS+n = register n
    91                                  V_KEY      equ 0xE182
    92                                  V_ITEM     equ 0xE187     ; current AMI main-menu item (handlers read it)
    93                                  V_REC      equ 0xE18F
    94                                  V_VSTR     equ 0xE197
    95                                  V_ATTR     equ 0xE19F     ; current drawing attribute
    96                                  C_CONTENT  equ 0xE1A2
    97                                  C_SEL      equ 0xE1A3
    98                                  C_HDR      equ 0xE1A8
    99                                  AMI_VSTR   equ 0x8292     ; word: base of the option value strings
   100                                  AMI_VIDSEG equ 0x4FF4     ; word: B800h / B000h
   101                                  
   102                                  ; BUBios state -- in the setup's zero-initialised, otherwise unused area
   103                                  BU_TAB     equ 0xEF80     ; current tab 0..NTABS-1
   104                                  BU_PEND    equ 0xEF81     ; Tab (+1) / Shift-Tab (-1) pressed inside a page
   105                                  BU_SEL     equ 0xEF82     ; selected entry on the Tools / Exit pages
   106                                  BU_MHZ     equ 0xEF84     ; word: measured clock in 1/10 MHz
   107                                  BU_CPU     equ 0xEF86     ; CPU family 3/4/5/6
   108                                  BU_FPU     equ 0xEF87     ; 1 = numeric coprocessor answered FNINIT
   109                                  BU_DTPOS   equ 0xEF88     ; word: row:col of the active date/time field, 0 = none
   110                                  BU_DTW     equ 0xEF8A     ; width of that field
   111                                  BU_BUF     equ 0xEF90     ; 40-byte text buffer
   112                                  
   113                                  NTABS      equ 6
   114                                  LBLW       equ 18         ; label field width on the Summary page
   115                                  ITEMSZ     equ 7          ; size of a Tools/Exit list entry
   116                                  
   117                                  ; =====================================================================
   118                                  section code start=0 vstart=0xDA84
   119                                  ; =====================================================================
   120                                  
   121                                  ; ---------------------------------------------------------------------
   122                                  ; bu_main -- replaces the AMI main menu (entered by JMP from 0x2997)
   123                                  ; ---------------------------------------------------------------------
   124                                  bu_main:
   125 00000000 E8(CB84)                    call A_RDCMOS
   126 00000003 E8(7750)                    call A_VIDINIT
   127 00000006 E8(9509)                    call A_CUROFF
   128 00000009 E8(7D00)                    call bu_detect
   129 0000000C C60687E100                  mov  byte [V_ITEM], 0
   130 00000011 E8(AE54)                    call A_SETUPOK
   131 00000014 09C0                        or   ax, ax
   132 00000016 7509                        jnz  .loop
   133 00000018 B8[5603]                    mov  ax, s_foot_main
   134 0000001B E81A01                      call bu_hdr
   135 0000001E E9(0437)                    jmp  A_NOSETUP
   136                                  
   137                                  .loop:
   138 00000021 A080EF                      mov  al, [BU_TAB]
   139 00000024 3C01                        cmp  al, 1
   140 00000026 7225                        jb   .menu
   141 00000028 3C03                        cmp  al, 3
   142 0000002A 7721                        ja   .menu
   143                                      ; ---- AMI pages: Standard / Advanced / Chipset ----
   144 0000002C FEC8                        dec  al
   145 0000002E A287E1                      mov  [V_ITEM], al
   146 00000031 98                          cbw
   147 00000032 89C3                        mov  bx, ax
   148 00000034 D1E3                        shl  bx, 1
   149 00000036 C60681EF00                  mov  byte [BU_PEND], 0
   150 0000003B FF97[B901]                  call [bx+page_handlers]
   151 0000003F A081EF                      mov  al, [BU_PEND]
   152 00000042 08C0                        or   al, al
   153 00000044 7560                        jnz  .step
   154 00000046 C60680EF00                  mov  byte [BU_TAB], 0          ; plain ESC -> back to Summary
   155 0000004B EBD4                        jmp  .loop
   156                                  
   157                                  .menu:
   158 0000004D E86C01                      call bu_draw_page
   159 00000050 E8(0E53)                    call A_GETKEY
   160 00000053 A382E1                      mov  [V_KEY], ax
   161 00000056 83F81B                      cmp  ax, 0x001B
   162 00000059 7430                        je   .esc
   163 0000005B 83F809                      cmp  ax, 0x0009
   164 0000005E 7440                        je   .next
   165 00000060 3D0F01                      cmp  ax, 0x010F
   166 00000063 743F                        je   .prev
   167 00000065 3D4801                      cmp  ax, 0x0148
   168 00000068 744C                        je   .up
   169 0000006A 3D5001                      cmp  ax, 0x0150
   170 0000006D 745D                        je   .down
   171 0000006F 83F80D                      cmp  ax, 0x000D
   172 00000072 7472                        je   .enter
   173 00000074 3D4401                      cmp  ax, 0x0144
   174 00000077 0F848300                    je   .f10
   175 0000007B 3D3C01                      cmp  ax, 0x013C
   176 0000007E 0F848700                    je   .colour
   177 00000082 3D3D01                      cmp  ax, 0x013D
   178 00000085 0F848000                    je   .colour
   179 00000089 EB96                        jmp  .loop
   180                                  
   181                                  .esc:
   182 0000008B B005                        mov  al, NTABS-1               ; ESC on Summary -> Exit page
   183 0000008D 803E80EF00                  cmp  byte [BU_TAB], 0
   184 00000092 7402                        je   .set
   185 00000094 30C0                        xor  al, al                    ; ESC elsewhere -> Summary
   186                                  .set:
   187 00000096 A280EF                      mov  [BU_TAB], al
   188 00000099 C60682EF00                  mov  byte [BU_SEL], 0
   189 0000009E EB81                        jmp  .loop
   190                                  .next:
   191 000000A0 B001                        mov  al, 1
   192 000000A2 EB02                        jmp  .step
   193                                  .prev:
   194 000000A4 B0FF                        mov  al, -1
   195                                  .step:
   196 000000A6 020680EF                    add  al, [BU_TAB]
   197 000000AA 7902                        jns  .s1
   198 000000AC 0406                        add  al, NTABS
   199                                  .s1:
   200 000000AE 3C06                        cmp  al, NTABS
   201 000000B0 72E4                        jb   .set
   202 000000B2 2C06                        sub  al, NTABS
   203 000000B4 EBE0                        jmp  .set
   204                                  
   205                                  .up:
   206 000000B6 E85600                      call bu_list
   207 000000B9 09C9                        or   cx, cx
   208 000000BB 0F8462FF                    jz   .loop
   209 000000BF A082EF                      mov  al, [BU_SEL]
   210 000000C2 FEC8                        dec  al
   211 000000C4 791A                        jns  .sel
   212 000000C6 88C8                        mov  al, cl
   213 000000C8 FEC8                        dec  al
   214 000000CA EB14                        jmp  .sel
   215                                  .down:
   216 000000CC E84000                      call bu_list
   217 000000CF 09C9                        or   cx, cx
   218 000000D1 0F844CFF                    jz   .loop
   219 000000D5 A082EF                      mov  al, [BU_SEL]
   220 000000D8 FEC0                        inc  al
   221 000000DA 38C8                        cmp  al, cl
   222 000000DC 7202                        jb   .sel
   223 000000DE 30C0                        xor  al, al
   224                                  .sel:
   225 000000E0 A282EF                      mov  [BU_SEL], al
   226 000000E3 E93BFF                      jmp  .loop
   227                                  
   228                                  .enter:
   229 000000E6 E82600                      call bu_list
   230 000000E9 09C9                        or   cx, cx
   231 000000EB 0F8432FF                    jz   .loop
   232 000000EF E83A00                      call bu_item                   ; BX -> entry
   233 000000F2 8A4704                      mov  al, [bx+4]
   234 000000F5 A287E1                      mov  [V_ITEM], al
   235 000000F8 FF5705                      call [bx+5]
   236 000000FB E923FF                      jmp  .loop
   237                                  
   238                                  .f10:
   239 000000FE C60687E10A                  mov  byte [V_ITEM], 10
   240 00000103 E8(DD29)                    call A_SAVEEXIT                ; returns only if the answer was N
   241 00000106 E918FF                      jmp  .loop
   242                                  
   243                                  .colour:
   244 00000109 E8(BA50)                    call A_COLOUR
   245 0000010C E912FF                      jmp  .loop
   246                                  
   247                                  ; ---------------------------------------------------------------------
   248                                  ; bu_list: SI -> entry list of the current tab, CX = number of entries
   249                                  ; bu_item: BX -> entry [BU_SEL] of list SI
   250                                  ; ---------------------------------------------------------------------
   251                                  bu_list:
   252 0000010F 31C9                        xor  cx, cx
   253 00000111 BE[D101]                    mov  si, tools_list
   254 00000114 B105                        mov  cl, 5
   255 00000116 803E80EF04                  cmp  byte [BU_TAB], 4
   256 0000011B 740E                        je   .r
   257 0000011D BE[F401]                    mov  si, exit_list
   258 00000120 B102                        mov  cl, 2
   259 00000122 803E80EF05                  cmp  byte [BU_TAB], 5
   260 00000127 7402                        je   .r
   261 00000129 31C9                        xor  cx, cx
   262 0000012B C3                      .r: ret
   263                                  
   264                                  bu_item:
   265 0000012C A082EF                      mov  al, [BU_SEL]
   266 0000012F B407                        mov  ah, ITEMSZ
   267 00000131 F6E4                        mul  ah
   268 00000133 89F3                        mov  bx, si
   269 00000135 01C3                        add  bx, ax
   270 00000137 C3                          ret
   271                                  
   272                                  ; ---------------------------------------------------------------------
   273                                  ; bu_hdr -- replaces the AMI screen header (0x38B5).
   274                                  ;   In: AX = footer caption (row 24), BX = page title (unused: the
   275                                  ;       active tab names the page).  All registers preserved.
   276                                  ; ---------------------------------------------------------------------
   277                                  bu_hdr:
   278 00000138 60                          pusha
   279 00000139 50                          push ax
   280 0000013A A0A8E1                      mov  al, [C_HDR]
   281 0000013D A29FE1                      mov  [V_ATTR], al
   282 00000140 31C0                        xor  ax, ax                    ; row 0: title bar
   283 00000142 BA4F00                      mov  dx, 0x004F
   284 00000145 E8(0E52)                    call A_FILL
   285 00000148 BB[CD02]                    mov  bx, s_title
   286 0000014B 31C0                        xor  ax, ax                    ; row 0, column 0
   287 0000014D E8(BB52)                    call A_PRINTB
   288 00000150 B80001                      mov  ax, 0x0100                ; frame rows 1..24
   289 00000153 BA4F18                      mov  dx, 0x184F
   290 00000156 BB0300                      mov  bx, 3
   291 00000159 E8(9951)                    call A_BOX
   292 0000015C B80003                      mov  ax, 0x0300                ; separator under the tab bar
   293 0000015F B250                        mov  dl, 0x50
   294 00000161 BB1720                      mov  bx, 0x2017
   295 00000164 E8(6E52)                    call A_HLINE
   296                                      ; tab bar (row 2)
   297 00000167 BE[BF01]                    mov  si, tab_table
   298 0000016A 31C9                        xor  cx, cx
   299                                  .tab:
   300 0000016C A0A8E1                      mov  al, [C_HDR]
   301 0000016F 3A0E80EF                    cmp  cl, [BU_TAB]
   302 00000173 7503                        jne  .t1
   303 00000175 E82E00                      call bu_tabattr
   304                                  .t1:
   305 00000178 A29FE1                      mov  [V_ATTR], al
   306 0000017B AC                          lodsb                          ; column
   307 0000017C B402                        mov  ah, 2
   308 0000017E 8B1C                        mov  bx, [si]
   309 00000180 83C602                      add  si, 2
   310 00000183 51                          push cx
   311 00000184 E8(DF52)                    call A_PRINT
   312 00000187 59                          pop  cx
   313 00000188 41                          inc  cx
   314 00000189 83F906                      cmp  cx, NTABS
   315 0000018C 72DE                        jb   .tab
   316                                      ; footer and content area
   317 0000018E 5B                          pop  bx
   318 0000018F B82818                      mov  ax, 0x1828
   319 00000192 E8(0F39)                    call A_FOOTER
   320 00000195 A0A2E1                      mov  al, [C_CONTENT]
   321 00000198 A29FE1                      mov  [V_ATTR], al
   322 0000019B B80104                      mov  ax, 0x0401
   323 0000019E BA4E17                      mov  dx, 0x174E
   324 000001A1 E8(0E52)                    call A_FILL
   325 000001A4 61                          popa
   326 000001A5 C3                          ret
   327                                  
   328                                  ; active-tab attribute: one per colour scheme, inverse video on mono
   329                                  bu_tabattr:
   330 000001A6 B070                        mov  al, 0x70
   331 000001A8 813EF44F00B0                cmp  word [AMI_VIDSEG], 0xB000
   332 000001AE 740B                        je   .r
   333 000001B0 8A1E37E0                    mov  bl, [CMOS+0x37]
   334 000001B4 83E30F                      and  bx, 0x000F
   335 000001B7 8A87[BD02]                  mov  al, [bx+tab_attrs]
   336 000001BB C3                      .r: ret
   337                                  
   338                                  ; ---------------------------------------------------------------------
   339                                  ; bu_draw_page -- Summary / Tools / Exit pages
   340                                  ; ---------------------------------------------------------------------
   341                                  bu_draw_page:
   342 000001BC E8(0000)                    call bu_autolabel              ; 2.1: "Auto-Detect Disks at Boot: On/Off"
   343 000001BF 31DB                        xor  bx, bx
   344 000001C1 B8[5603]                    mov  ax, s_foot_main
   345 000001C4 E871FF                      call bu_hdr
   346 000001C7 A0A8E1                      mov  al, [C_HDR]
   347 000001CA A29FE1                      mov  [V_ATTR], al
   348 000001CD B80016                      mov  ax, 0x1600                ; line above the help row
   349 000001D0 B250                        mov  dl, 0x50
   350 000001D2 BB1720                      mov  bx, 0x2017
   351 000001D5 E8(6E52)                    call A_HLINE
   352 000001D8 803E80EF00                  cmp  byte [BU_TAB], 0
   353 000001DD 745D                        je   bu_summary
   354                                      ; ---- list page ----
   355 000001DF E82DFF                      call bu_list
   356 000001E2 E357                        jcxz .done
   357 000001E4 31DB                        xor  bx, bx                    ; bl = index
   358 000001E6 B607                        mov  dh, 7                     ; first row
   359                                  .item:
   360 000001E8 51                          push cx
   361 000001E9 56                          push si
   362 000001EA 53                          push bx
   363 000001EB 52                          push dx
   364 000001EC A0A2E1                      mov  al, [C_CONTENT]
   365 000001EF 3A1E82EF                    cmp  bl, [BU_SEL]
   366 000001F3 7503                        jne  .a
   367 000001F5 A0A3E1                      mov  al, [C_SEL]
   368 000001F8 A29FE1                  .a: mov  [V_ATTR], al
   369 000001FB 88F4                        mov  ah, dh                    ; selection bar, columns 22..57
   370 000001FD B016                        mov  al, 22
   371 000001FF B239                        mov  dl, 57
   372 00000201 E8(0E52)                    call A_FILL
   373 00000204 5A                          pop  dx
   374 00000205 5B                          pop  bx
   375 00000206 53                          push bx
   376 00000207 52                          push dx
   377 00000208 88D8                        mov  al, bl
   378 0000020A B407                        mov  ah, ITEMSZ
   379 0000020C F6E4                        mul  ah
   380 0000020E 89F3                        mov  bx, si
   381 00000210 01C3                        add  bx, ax
   382 00000212 8B1F                        mov  bx, [bx]                  ; label
   383 00000214 88F4                        mov  ah, dh
   384 00000216 B018                        mov  al, 24
   385 00000218 E8(DF52)                    call A_PRINT
   386 0000021B 5A                          pop  dx
   387 0000021C 5B                          pop  bx
   388 0000021D 5E                          pop  si
   389 0000021E 59                          pop  cx
   390 0000021F 80C602                      add  dh, 2
   391 00000222 FEC3                        inc  bl
   392 00000224 E2C2                        loop .item
   393                                      ; help text of the selected entry, row 23
   394 00000226 E8E6FE                      call bu_list
   395 00000229 E800FF                      call bu_item
   396 0000022C A0A2E1                      mov  al, [C_CONTENT]
   397 0000022F A29FE1                      mov  [V_ATTR], al
   398 00000232 8B5F02                      mov  bx, [bx+2]
   399 00000235 B82817                      mov  ax, 0x1728
   400 00000238 E8(D252)                    call A_PRINTC
   401                                  .done:
   402 0000023B C3                          ret
   403                                  
   404                                  ; ---------------------------------------------------------------------
   405                                  ; bu_summary -- the entry page
   406                                  ; ---------------------------------------------------------------------
   407                                  bu_summary:
   408 0000023C B82703                      mov  ax, 0x0327                ; column divider rows 3..22
   409 0000023F B214                        mov  dl, 0x14
   410 00000241 BB8B40                      mov  bx, 0x408B
   411 00000244 E8(8652)                    call A_VLINE
   412 00000247 A0A2E1                      mov  al, [C_CONTENT]
   413 0000024A A29FE1                      mov  [V_ATTR], al
   414 0000024D BB[AB03]                    mov  bx, s_tagline
   415 00000250 B82817                      mov  ax, 0x1728
   416 00000253 E8(D252)                    call A_PRINTC
   417 00000256 BE[0202]                    mov  si, sum_table
   418                                  .e:
   419 00000259 AC                          lodsb
   420 0000025A 3CFF                        cmp  al, 0xFF
   421 0000025C 744F                        je   .done
   422 0000025E 88C6                        mov  dh, al                    ; row
   423 00000260 AC                          lodsb
   424 00000261 88C2                        mov  dl, al                    ; column
   425 00000263 AD                          lodsw
   426 00000264 89C7                        mov  di, ax                    ; label
   427 00000266 AD                          lodsw                          ; value descriptor
   428 00000267 56                          push si
   429 00000268 52                          push dx
   430 00000269 57                          push di
   431 0000026A 55                          push bp
   432 0000026B E85000                      call bu_value                  ; BX = value string or 0
   433 0000026E 5D                          pop  bp
   434 0000026F 5F                          pop  di
   435 00000270 5A                          pop  dx
   436 00000271 09DB                        or   bx, bx
   437 00000273 7435                        jz   .skip
   438 00000275 53                          push bx
   439 00000276 A0A2E1                      mov  al, [C_CONTENT]
   440 00000279 A29FE1                      mov  [V_ATTR], al
   441 0000027C 89FB                        mov  bx, di
   442 0000027E 89D0                        mov  ax, dx
   443 00000280 E8(DF52)                    call A_PRINT
