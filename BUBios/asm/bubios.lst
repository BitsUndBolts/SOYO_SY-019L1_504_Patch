  1186                                  ; bu_dtentry -- numeric entry for a date/time field of the Standard page
  1187                                  ;   In : AL = first digit typed, [BU_DTPOS]/[BU_DTW] = field
  1188                                  ;   Out: AX = key to hand back to AMI's field loop
  1189                                  ;        Enter (next field) after a commit, 0 (ignored) after ESC,
  1190                                  ;        or the navigation key that ended the entry.
  1191                                  ;   Digits fill the field; it commits by itself when full.  Backspace
  1192                                  ;   deletes, ESC cancels.  Years may be typed with 2 or 4 digits.
  1193                                  bu_dtentry:
  1194 00000000 53                          push bx
  1195 00000001 51                          push cx
  1196 00000002 52                          push dx
  1197 00000003 56                          push si
  1198 00000004 57                          push di
  1199 00000005 55                          push bp
  1200 00000006 06                          push es
  1201 00000007 6A00                        push 0
  1202 00000009 07                          pop  es
  1203 0000000A 2680068E0240                add  byte [es:0x28E], 0x40     ; hold AMI's once-a-second clock redraw
  1204 00000010 8B1688EF                    mov  dx, [BU_DTPOS]
  1205 00000014 BE[9402]                    mov  si, dt_fields
  1206                                  .find:
  1207 00000017 833C00                      cmp  word [si], 0
  1208 0000001A 7409                        je   .none
  1209 0000001C 3914                        cmp  [si], dx
  1210 0000001E 7409                        je   .found
  1211 00000020 83C604                      add  si, 4
  1212 00000023 EBF2                        jmp  .find
  1213                                  .none:
  1214 00000025 31C0                        xor  ax, ax
  1215 00000027 EB70                        jmp  .done
  1216                                  .found:
  1217 00000029 C60690EF20                  mov  byte [BU_BUF], ' '
  1218 0000002E 31ED                        xor  bp, bp                    ; value
  1219 00000030 31C9                        xor  cx, cx                    ; CL = digits typed
  1220                                  .digit:
  1221 00000032 3A4C02                      cmp  cl, [si+2]
  1222 00000035 731D                        jae  .key
  1223 00000037 88CB                        mov  bl, cl
  1224 00000039 30FF                        xor  bh, bh
  1225 0000003B 888791EF                    mov  [bx+BU_BUF+1], al
  1226 0000003F 2C30                        sub  al, '0'
  1227 00000041 98                          cbw
  1228 00000042 95                          xchg ax, bp
  1229 00000043 BB0A00                      mov  bx, 10
  1230 00000046 F7E3                        mul  bx
  1231 00000048 01C5                        add  bp, ax
  1232 0000004A FEC1                        inc  cl
  1233 0000004C E85B00                      call dt_echo
  1234 0000004F 3A4C02                      cmp  cl, [si+2]
  1235 00000052 7338                        jae  .enter                    ; field full: commit, next field
  1236                                  .key:
  1237 00000054 B400                        mov  ah, 0
  1238 00000056 CD16                        int  0x16
  1239 00000058 3C30                        cmp  al, '0'
  1240 0000005A 7204                        jb   .nd
  1241 0000005C 3C39                        cmp  al, '9'
  1242 0000005E 76D2                        jbe  .digit
  1243                                  .nd:
  1244 00000060 3D080E                      cmp  ax, 0x0E08                ; Backspace
  1245 00000063 7516                        jne  .ne
  1246 00000065 08C9                        or   cl, cl
  1247 00000067 74EB                        jz   .key
  1248 00000069 FEC9                        dec  cl
  1249 0000006B 89E8                        mov  ax, bp
  1250 0000006D 31D2                        xor  dx, dx
  1251 0000006F BB0A00                      mov  bx, 10
  1252 00000072 F7F3                        div  bx
  1253 00000074 89C5                        mov  bp, ax
  1254 00000076 E83100                      call dt_echo
  1255 00000079 EBD9                        jmp  .key
  1256                                  .ne:
  1257 0000007B 80FC01                      cmp  ah, 1                     ; ESC: cancel
  1258 0000007E 7414                        je   .cancel
  1259 00000080 3D0D1C                      cmp  ax, 0x1C0D
  1260 00000083 7407                        je   .enter
  1261 00000085 50                          push ax                        ; any other key: commit and pass it on
  1262 00000086 E8(0000)                    call dt_commit
  1263 00000089 58                          pop  ax
  1264 0000008A EB0D                        jmp  .done
  1265                                  .enter:
  1266 0000008C E8(0000)                    call dt_commit
  1267 0000008F B80D1C                      mov  ax, 0x1C0D
  1268 00000092 EB05                        jmp  .done
  1269                                  .cancel:
  1270 00000094 E8(2260)                    call A_DTSHOW
  1271 00000097 31C0                        xor  ax, ax
  1272                                  .done:
  1273 00000099 6A00                        push 0
  1274 0000009B 07                          pop  es
  1275 0000009C 26802E8E0240                sub  byte [es:0x28E], 0x40
  1276 000000A2 07                          pop  es
  1277 000000A3 5D                          pop  bp
  1278 000000A4 5F                          pop  di
  1279 000000A5 5E                          pop  si
  1280 000000A6 5A                          pop  dx
  1281 000000A7 59                          pop  cx
  1282 000000A8 5B                          pop  bx
  1283 000000A9 C3                          ret
  1284                                  
  1285                                  ; show " digits" padded to the field width, in the highlight colour
  1286                                  dt_echo:
  1287 000000AA 60                          pusha
  1288 000000AB 88CB                        mov  bl, cl
  1289 000000AD 30FF                        xor  bh, bh
  1290 000000AF 8DBF91EF                    lea  di, [bx+BU_BUF+1]
  1291 000000B3 0FB6068AEF                  movzx ax, byte [BU_DTW]
  1292 000000B8 0590EF                      add  ax, BU_BUF
  1293                                  .pad:
  1294 000000BB 39C7                        cmp  di, ax
  1295 000000BD 7306                        jae  .pz
  1296 000000BF C60520                      mov  byte [di], ' '
  1297 000000C2 47                          inc  di
  1298 000000C3 EBF6                        jmp  .pad
  1299                                  .pz:
