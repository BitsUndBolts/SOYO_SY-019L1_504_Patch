     1                                  ; =====================================================================
     2                                  ;  BUBios -- MR-BIOS-style front end for the AMIBIOS 11/11/92 setup
     3                                  ;  (SOYO SY-019L1, OPTi 82C495SLC, 27C512) -- trial version 0.1
     4                                  ;
     5                                  ;  Built on top of the hardware-confirmed ECHS ROM
     6                                  ;  (binary/SY019L1_27C512_CHSPATCH.BIN of the parent project).
     7                                  ;
     8                                  ;  What this adds (all patch sites are applied and verified by
     9                                  ;  py/build_bubios.py, which asserts the original bytes first):
    10                                  ;
    11                                  ;    0x36D4  AMI main menu            -> JMP bu_main   (tab bar + pages)
    12                                  ;    0x38B5  AMI screen header        -> JMP bu_hdr    (title bar + tabs)
    13                                  ;    0x0D3D  option-editor getkey     -> CALL bu_edkey (Tab / Shift-Tab)
    14                                  ;    0x08D5  Standard-CMOS getkey     -> CALL bu_stdkey + NOP
    15                                  ;    0x5037  16 colour schemes        -> BUBios schemes (F2/F3 cycles them)
    16                                  ;    0x4FF6  "bright" OR-mask 0Fh     -> 08h (intensity only, keeps hue)
    17                                  ;    0x309A / 0x6D3A  footer texts    -> Tab/ESC hints
    18                                  ;
    19                                  ;  Code lives in the free block 0xDA84-0xDFFF (executed from F000).
    20                                  ;  Data (and the small timing loop) live in the free block 0x7902-0x7EFD.
    21                                  ;  The setup program copies F000:0000-DFFF to 0100:0000 and runs with
    22                                  ;  DS=SS=0100h, so DS-relative data must sit below 0xE000 -- and not in
    23                                  ;  0xDA84-0xDFFF, which is the setup's stack in that RAM copy.  That is
    24                                  ;  why every string/table is in the 0x79xx block.
    25                                  ; =====================================================================
    26                                  [map all bubios.map]
    27                                  BITS 16
    28                                  CPU 386
    29                                  
    30                                  ; ---- AMI setup routines (all near, segment F000) --------------------
    31                                  A_RDCMOS   equ 0x84CB     ; read CMOS into the image at DS:E000
    32                                  A_VIDINIT  equ 0x5077     ; video mode + colour scheme -> E1A2..E1A9
    33                                  A_CUROFF   equ 0x0995     ; hide cursor
    34                                  A_SETUPOK  equ 0x54AE     ; AX<>0 if menu item [E187] is available
    35                                  A_NOSETUP  equ 0x3704     ; "NO CMOS SETUP PRESENT" path (exits setup)
    36                                  A_BOX      equ 0x5199     ; box  AX=top-left DX=bottom-right BX=style
    37                                  A_FILL     equ 0x520E     ; fill AX=top-left DX=bottom-right, attr [E19F]
    38                                  A_HLINE    equ 0x526E     ; horizontal line AX=start DL=len BX=style
    39                                  A_VLINE    equ 0x5286     ; vertical line   AX=start DL=len BX=style
    40                                  A_PRINT    equ 0x52DF     ; print DS:BX at AX=row:col, attr [E19F]
    41                                  A_PRINTB   equ 0x52BB     ; same, bright
    42                                  A_PRINTC   equ 0x52D2     ; same, centred on column AL
    43                                  A_PUTCH    equ 0x52FA     ; print char AL at DX=row:col
    44                                  A_FOOTER   equ 0x390F     ; framed footer caption DS:BX centred at AX
    45                                  A_GETKEY   equ 0x530E     ; AX = ASCII, or 100h+scan for extended keys
    46                                  A_COLOUR   equ 0x50BA     ; F2/F3 colour cycling (reads [E182])
    47                                  A_SAVEEXIT equ 0x29DD     ; "Write to CMOS and Exit (Y/N)?"
    48                                  A_QUIT     equ 0x29EC     ; "Want to Quit Without Saving (Y/N)?"
    49                                  A_VALSTR   equ 0x5B21     ; AX = value string of option record [E18F]
    50                                  H_STD      equ 0x00EC     ; Standard CMOS setup page
    51                                  H_ADV      equ 0x0BDE     ; Advanced CMOS setup page
    52                                  H_CHIP     equ 0x0C05     ; Advanced chipset setup page
    53                                  H_DEF      equ 0x5486     ; load BIOS / power-on defaults ([E187]=5/6)
    54                                  H_PWD      equ 0xF1C8     ; change password
    55                                  H_DETECT   equ 0x4A44     ; auto-detect hard disk
    56                                  CALC_FACTOR equ 0x76F5    ; ECHS head-factor routine of the xlate patch
    57                                  
    58                                  ; ---- AMI option records used on the Summary page ----------------------
    59                                  R_EXTCACHE equ 0xBDE7     ; External Cache Memory
    60                                  R_VSHADOW  equ 0xBE8F     ; Video ROM Shadow C000,16K
    61                                  R_SSHADOW  equ 0xC057     ; System ROM Shadow F000,64K
    62                                  R_BOOTSEQ  equ 0xBDA3     ; System Boot Up Sequence
    63                                  R_NUMLOCK  equ 0xBD1D     ; System Boot Up Num Lock
    64                                  R_PASSWORD equ 0xBE6D     ; Password Checking Option
    65                                  
    66                                  ; ---- AMI strings reused (verified by the build script) ----------------
    67                                  S_FLOPPY   equ 0x6F35     ; "360  KB, 5.."  stride 17
    68                                  S_MONO     equ 0x6F8A
    69                                  S_COL80    equ 0x6F9B
    70                                  S_COL40    equ 0x6FAC
    71                                  S_VGA      equ 0x6FBD
    72                                  S_HELP_DEF equ 0x2D4F
    73                                  S_HELP_PON equ 0x2D9B
    74                                  S_HELP_PWD equ 0x2DE5
    75                                  S_HELP_DET equ 0x2E11
    76                                  S_HELP_SAV equ 0x2E7C
    77                                  S_HELP_QUT equ 0x2E75
    78                                  
    79                                  ; ---- setup data segment (DS = 0100h) ---------------------------------
    80                                  CMOS       equ 0xE000     ; CMOS image, CMOS+n = register n
    81                                  V_KEY      equ 0xE182
    82                                  V_ITEM     equ 0xE187     ; current AMI main-menu item (handlers read it)
    83                                  V_REC      equ 0xE18F
    84                                  V_VSTR     equ 0xE197
    85                                  V_ATTR     equ 0xE19F     ; current drawing attribute
    86                                  C_CONTENT  equ 0xE1A2
    87                                  C_SEL      equ 0xE1A3
    88                                  C_HDR      equ 0xE1A8
    89                                  AMI_VSTR   equ 0x8292     ; word: base of the option value strings
    90                                  AMI_VIDSEG equ 0x4FF4     ; word: B800h / B000h
    91                                  
    92                                  ; BUBios state -- in the setup's zero-initialised, otherwise unused area
    93                                  BU_TAB     equ 0xEF80     ; current tab 0..NTABS-1
    94                                  BU_PEND    equ 0xEF81     ; Tab (+1) / Shift-Tab (-1) pressed inside a page
    95                                  BU_SEL     equ 0xEF82     ; selected entry on the Tools / Exit pages
    96                                  BU_MHZ     equ 0xEF84     ; word: measured clock in 1/10 MHz
    97                                  BU_CPU     equ 0xEF86     ; CPU family 3/4/5/6
    98                                  BU_BUF     equ 0xEF90     ; 40-byte text buffer
    99                                  
   100                                  NTABS      equ 6
   101                                  LBLW       equ 18         ; label field width on the Summary page
   102                                  ITEMSZ     equ 7          ; size of a Tools/Exit list entry
   103                                  
   104                                  ; =====================================================================
   105                                  section code start=0 vstart=0xDA84
   106                                  ; =====================================================================
   107                                  
   108                                  ; ---------------------------------------------------------------------
   109                                  ; bu_main -- replaces the AMI main menu (entered by JMP from 0x2997)
   110                                  ; ---------------------------------------------------------------------
   111                                  bu_main:
   112 00000000 E8(CB84)                    call A_RDCMOS
   113 00000003 E8(7750)                    call A_VIDINIT
   114 00000006 E8(9509)                    call A_CUROFF
   115 00000009 E8(5900)                    call bu_detect
   116 0000000C C60687E100                  mov  byte [V_ITEM], 0
   117 00000011 E8(AE54)                    call A_SETUPOK
   118 00000014 09C0                        or   ax, ax
   119 00000016 7509                        jnz  .loop
   120 00000018 B8[DB02]                    mov  ax, s_foot_main
   121 0000001B E82501                      call bu_hdr
   122 0000001E E9(0437)                    jmp  A_NOSETUP
   123                                  
   124                                  .loop:
   125 00000021 A080EF                      mov  al, [BU_TAB]
   126 00000024 3C01                        cmp  al, 1
   127 00000026 7225                        jb   .menu
   128 00000028 3C03                        cmp  al, 3
   129 0000002A 7721                        ja   .menu
   130                                      ; ---- AMI pages: Standard / Advanced / Chipset ----
   131 0000002C FEC8                        dec  al
   132 0000002E A287E1                      mov  [V_ITEM], al
   133 00000031 98                          cbw
   134 00000032 89C3                        mov  bx, ax
   135 00000034 D1E3                        shl  bx, 1
   136 00000036 C60681EF00                  mov  byte [BU_PEND], 0
   137 0000003B FF97[5F01]                  call [bx+page_handlers]
   138 0000003F A081EF                      mov  al, [BU_PEND]
   139 00000042 08C0                        or   al, al
   140 00000044 756B                        jnz  .step
   141 00000046 C60680EF00                  mov  byte [BU_TAB], 0          ; plain ESC -> back to Summary
   142 0000004B EBD4                        jmp  .loop
   143                                  
   144                                  .menu:
   145 0000004D E87801                      call bu_draw_page
   146 00000050 E8(0E53)                    call A_GETKEY
   147 00000053 A382E1                      mov  [V_KEY], ax
   148 00000056 83F81B                      cmp  ax, 0x001B
   149 00000059 743A                        je   .esc
   150 0000005B 83F809                      cmp  ax, 0x0009
   151 0000005E 744B                        je   .next
   152 00000060 3D4D01                      cmp  ax, 0x014D
   153 00000063 7446                        je   .next
   154 00000065 3D0F01                      cmp  ax, 0x010F
   155 00000068 7445                        je   .prev
   156 0000006A 3D4B01                      cmp  ax, 0x014B
   157 0000006D 7440                        je   .prev
   158 0000006F 3D4801                      cmp  ax, 0x0148
   159 00000072 744D                        je   .up
   160 00000074 3D5001                      cmp  ax, 0x0150
   161 00000077 745E                        je   .down
   162 00000079 83F80D                      cmp  ax, 0x000D
   163 0000007C 7473                        je   .enter
   164 0000007E 3D4401                      cmp  ax, 0x0144
   165 00000081 0F848400                    je   .f10
   166 00000085 3D3C01                      cmp  ax, 0x013C
   167 00000088 0F848800                    je   .colour
   168 0000008C 3D3D01                      cmp  ax, 0x013D
   169 0000008F 0F848100                    je   .colour
   170 00000093 EB8C                        jmp  .loop
   171                                  
   172                                  .esc:
   173 00000095 B005                        mov  al, NTABS-1               ; ESC on Summary -> Exit page
   174 00000097 803E80EF00                  cmp  byte [BU_TAB], 0
   175 0000009C 7402                        je   .set
   176 0000009E 30C0                        xor  al, al                    ; ESC elsewhere -> Summary
   177                                  .set:
   178 000000A0 A280EF                      mov  [BU_TAB], al
   179 000000A3 C60682EF00                  mov  byte [BU_SEL], 0
   180 000000A8 E976FF                      jmp  .loop
   181                                  .next:
   182 000000AB B001                        mov  al, 1
   183 000000AD EB02                        jmp  .step
   184                                  .prev:
   185 000000AF B0FF                        mov  al, -1
   186                                  .step:
   187 000000B1 020680EF                    add  al, [BU_TAB]
   188 000000B5 7902                        jns  .s1
   189 000000B7 0406                        add  al, NTABS
   190                                  .s1:
   191 000000B9 3C06                        cmp  al, NTABS
   192 000000BB 72E3                        jb   .set
   193 000000BD 2C06                        sub  al, NTABS
   194 000000BF EBDF                        jmp  .set
   195                                  
   196                                  .up:
   197 000000C1 E85600                      call bu_list
   198 000000C4 09C9                        or   cx, cx
   199 000000C6 0F8457FF                    jz   .loop
   200 000000CA A082EF                      mov  al, [BU_SEL]
   201 000000CD FEC8                        dec  al
   202 000000CF 791A                        jns  .sel
   203 000000D1 88C8                        mov  al, cl
   204 000000D3 FEC8                        dec  al
   205 000000D5 EB14                        jmp  .sel
   206                                  .down:
   207 000000D7 E84000                      call bu_list
   208 000000DA 09C9                        or   cx, cx
   209 000000DC 0F8441FF                    jz   .loop
   210 000000E0 A082EF                      mov  al, [BU_SEL]
   211 000000E3 FEC0                        inc  al
   212 000000E5 38C8                        cmp  al, cl
   213 000000E7 7202                        jb   .sel
   214 000000E9 30C0                        xor  al, al
   215                                  .sel:
   216 000000EB A282EF                      mov  [BU_SEL], al
   217 000000EE E930FF                      jmp  .loop
   218                                  
   219                                  .enter:
   220 000000F1 E82600                      call bu_list
   221 000000F4 09C9                        or   cx, cx
   222 000000F6 0F8427FF                    jz   .loop
   223 000000FA E83A00                      call bu_item                   ; BX -> entry
   224 000000FD 8A4704                      mov  al, [bx+4]
   225 00000100 A287E1                      mov  [V_ITEM], al
   226 00000103 FF5705                      call [bx+5]
   227 00000106 E918FF                      jmp  .loop
   228                                  
   229                                  .f10:
   230 00000109 C60687E10A                  mov  byte [V_ITEM], 10
   231 0000010E E8(DD29)                    call A_SAVEEXIT                ; returns only if the answer was N
   232 00000111 E90DFF                      jmp  .loop
   233                                  
   234                                  .colour:
   235 00000114 E8(BA50)                    call A_COLOUR
   236 00000117 E907FF                      jmp  .loop
   237                                  
   238                                  ; ---------------------------------------------------------------------
   239                                  ; bu_list: SI -> entry list of the current tab, CX = number of entries
   240                                  ; bu_item: BX -> entry [BU_SEL] of list SI
   241                                  ; ---------------------------------------------------------------------
   242                                  bu_list:
   243 0000011A 31C9                        xor  cx, cx
   244 0000011C BE[7701]                    mov  si, tools_list
   245 0000011F B104                        mov  cl, 4
   246 00000121 803E80EF04                  cmp  byte [BU_TAB], 4
   247 00000126 740E                        je   .r
   248 00000128 BE[9301]                    mov  si, exit_list
   249 0000012B B102                        mov  cl, 2
   250 0000012D 803E80EF05                  cmp  byte [BU_TAB], 5
   251 00000132 7402                        je   .r
   252 00000134 31C9                        xor  cx, cx
   253 00000136 C3                      .r: ret
   254                                  
   255                                  bu_item:
   256 00000137 A082EF                      mov  al, [BU_SEL]
   257 0000013A B407                        mov  ah, ITEMSZ
   258 0000013C F6E4                        mul  ah
   259 0000013E 89F3                        mov  bx, si
   260 00000140 01C3                        add  bx, ax
   261 00000142 C3                          ret
   262                                  
   263                                  ; ---------------------------------------------------------------------
   264                                  ; bu_hdr -- replaces the AMI screen header (0x38B5).
   265                                  ;   In: AX = footer caption (row 24), BX = page title (unused: the
   266                                  ;       active tab names the page).  All registers preserved.
   267                                  ; ---------------------------------------------------------------------
   268                                  bu_hdr:
   269 00000143 60                          pusha
   270 00000144 50                          push ax
   271 00000145 A0A8E1                      mov  al, [C_HDR]
   272 00000148 A29FE1                      mov  [V_ATTR], al
   273 0000014B 31C0                        xor  ax, ax                    ; row 0: title bar
   274 0000014D BA4F00                      mov  dx, 0x004F
   275 00000150 E8(0E52)                    call A_FILL
   276 00000153 BB[5202]                    mov  bx, s_title
   277 00000156 B80100                      mov  ax, 0x0001
   278 00000159 E8(BB52)                    call A_PRINTB
   279 0000015C B80001                      mov  ax, 0x0100                ; frame rows 1..24
   280 0000015F BA4F18                      mov  dx, 0x184F
   281 00000162 BB0300                      mov  bx, 3
   282 00000165 E8(9951)                    call A_BOX
   283 00000168 B80003                      mov  ax, 0x0300                ; separator under the tab bar
   284 0000016B B250                        mov  dl, 0x50
   285 0000016D BB1720                      mov  bx, 0x2017
   286 00000170 E8(6E52)                    call A_HLINE
   287                                      ; tab bar (row 2)
   288 00000173 BE[6501]                    mov  si, tab_table
   289 00000176 31C9                        xor  cx, cx
   290                                  .tab:
   291 00000178 A0A8E1                      mov  al, [C_HDR]
   292 0000017B 3A0E80EF                    cmp  cl, [BU_TAB]
   293 0000017F 7503                        jne  .t1
   294 00000181 E82E00                      call bu_tabattr
   295                                  .t1:
   296 00000184 A29FE1                      mov  [V_ATTR], al
   297 00000187 AC                          lodsb                          ; column
   298 00000188 B402                        mov  ah, 2
   299 0000018A 8B1C                        mov  bx, [si]
   300 0000018C 83C602                      add  si, 2
   301 0000018F 51                          push cx
   302 00000190 E8(DF52)                    call A_PRINT
   303 00000193 59                          pop  cx
   304 00000194 41                          inc  cx
   305 00000195 83F906                      cmp  cx, NTABS
   306 00000198 72DE                        jb   .tab
   307                                      ; footer and content area
   308 0000019A 5B                          pop  bx
   309 0000019B B82818                      mov  ax, 0x1828
   310 0000019E E8(0F39)                    call A_FOOTER
   311 000001A1 A0A2E1                      mov  al, [C_CONTENT]
   312 000001A4 A29FE1                      mov  [V_ATTR], al
   313 000001A7 B80104                      mov  ax, 0x0401
   314 000001AA BA4E17                      mov  dx, 0x174E
   315 000001AD E8(0E52)                    call A_FILL
   316 000001B0 61                          popa
   317 000001B1 C3                          ret
   318                                  
   319                                  ; active-tab attribute: one per colour scheme, inverse video on mono
   320                                  bu_tabattr:
   321 000001B2 B070                        mov  al, 0x70
   322 000001B4 813EF44F00B0                cmp  word [AMI_VIDSEG], 0xB000
   323 000001BA 740B                        je   .r
   324 000001BC 8A1E37E0                    mov  bl, [CMOS+0x37]
   325 000001C0 83E30F                      and  bx, 0x000F
   326 000001C3 8A87[4202]                  mov  al, [bx+tab_attrs]
   327 000001C7 C3                      .r: ret
   328                                  
   329                                  ; ---------------------------------------------------------------------
   330                                  ; bu_draw_page -- Summary / Tools / Exit pages
   331                                  ; ---------------------------------------------------------------------
   332                                  bu_draw_page:
   333 000001C8 31DB                        xor  bx, bx
   334 000001CA B8[DB02]                    mov  ax, s_foot_main
   335 000001CD E873FF                      call bu_hdr
   336 000001D0 A0A8E1                      mov  al, [C_HDR]
   337 000001D3 A29FE1                      mov  [V_ATTR], al
   338 000001D6 B80016                      mov  ax, 0x1600                ; line above the help row
   339 000001D9 B250                        mov  dl, 0x50
   340 000001DB BB1720                      mov  bx, 0x2017
   341 000001DE E8(6E52)                    call A_HLINE
   342 000001E1 803E80EF00                  cmp  byte [BU_TAB], 0
   343 000001E6 745D                        je   bu_summary
   344                                      ; ---- list page ----
   345 000001E8 E82FFF                      call bu_list
   346 000001EB E357                        jcxz .done
   347 000001ED 31DB                        xor  bx, bx                    ; bl = index
   348 000001EF B607                        mov  dh, 7                     ; first row
   349                                  .item:
   350 000001F1 51                          push cx
   351 000001F2 56                          push si
   352 000001F3 53                          push bx
   353 000001F4 52                          push dx
   354 000001F5 A0A2E1                      mov  al, [C_CONTENT]
   355 000001F8 3A1E82EF                    cmp  bl, [BU_SEL]
   356 000001FC 7503                        jne  .a
   357 000001FE A0A3E1                      mov  al, [C_SEL]
   358 00000201 A29FE1                  .a: mov  [V_ATTR], al
   359 00000204 88F4                        mov  ah, dh                    ; selection bar, columns 22..57
   360 00000206 B016                        mov  al, 22
   361 00000208 B239                        mov  dl, 57
   362 0000020A E8(0E52)                    call A_FILL
   363 0000020D 5A                          pop  dx
   364 0000020E 5B                          pop  bx
   365 0000020F 53                          push bx
   366 00000210 52                          push dx
   367 00000211 88D8                        mov  al, bl
   368 00000213 B407                        mov  ah, ITEMSZ
   369 00000215 F6E4                        mul  ah
   370 00000217 89F3                        mov  bx, si
   371 00000219 01C3                        add  bx, ax
   372 0000021B 8B1F                        mov  bx, [bx]                  ; label
   373 0000021D 88F4                        mov  ah, dh
   374 0000021F B018                        mov  al, 24
   375 00000221 E8(DF52)                    call A_PRINT
   376 00000224 5A                          pop  dx
   377 00000225 5B                          pop  bx
   378 00000226 5E                          pop  si
   379 00000227 59                          pop  cx
   380 00000228 80C602                      add  dh, 2
   381 0000022B FEC3                        inc  bl
   382 0000022D E2C2                        loop .item
   383                                      ; help text of the selected entry, row 23
   384 0000022F E8E8FE                      call bu_list
   385 00000232 E802FF                      call bu_item
   386 00000235 A0A2E1                      mov  al, [C_CONTENT]
   387 00000238 A29FE1                      mov  [V_ATTR], al
   388 0000023B 8B5F02                      mov  bx, [bx+2]
   389 0000023E B82817                      mov  ax, 0x1728
   390 00000241 E8(D252)                    call A_PRINTC
   391                                  .done:
   392 00000244 C3                          ret
   393                                  
   394                                  ; ---------------------------------------------------------------------
   395                                  ; bu_summary -- the entry page
   396                                  ; ---------------------------------------------------------------------
   397                                  bu_summary:
   398 00000245 B82703                      mov  ax, 0x0327                ; column divider rows 3..22
   399 00000248 B214                        mov  dl, 0x14
   400 0000024A BB8B40                      mov  bx, 0x408B
   401 0000024D E8(8652)                    call A_VLINE
   402 00000250 A0A2E1                      mov  al, [C_CONTENT]
   403 00000253 A29FE1                      mov  [V_ATTR], al
   404 00000256 BB[2903]                    mov  bx, s_tagline
   405 00000259 B82817                      mov  ax, 0x1728
   406 0000025C E8(D252)                    call A_PRINTC
   407 0000025F BE[A101]                    mov  si, sum_table
   408                                  .e:
   409 00000262 AC                          lodsb
   410 00000263 3CFF                        cmp  al, 0xFF
   411 00000265 744F                        je   .done
   412 00000267 88C6                        mov  dh, al                    ; row
   413 00000269 AC                          lodsb
   414 0000026A 88C2                        mov  dl, al                    ; column
   415 0000026C AD                          lodsw
   416 0000026D 89C7                        mov  di, ax                    ; label
   417 0000026F AD                          lodsw                          ; value descriptor
   418 00000270 56                          push si
   419 00000271 52                          push dx
   420 00000272 57                          push di
   421 00000273 55                          push bp
   422 00000274 E85000                      call bu_value                  ; BX = value string or 0
   423 00000277 5D                          pop  bp
   424 00000278 5F                          pop  di
   425 00000279 5A                          pop  dx
   426 0000027A 09DB                        or   bx, bx
   427 0000027C 7435                        jz   .skip
   428 0000027E 53                          push bx
   429 0000027F A0A2E1                      mov  al, [C_CONTENT]
   430 00000282 A29FE1                      mov  [V_ATTR], al
   431 00000285 89FB                        mov  bx, di
   432 00000287 89D0                        mov  ax, dx
   433 00000289 E8(DF52)                    call A_PRINT
   434                                      ; dotted leader
   435 0000028C 89FB                        mov  bx, di
   436 0000028E E82600                      call A_STRLEN_wrap             ; CX = label length
   437 00000291 52                          push dx
   438 00000292 00CA                        add  dl, cl
   439 00000294 FEC2                        inc  dl                        ; first dot column
   440 00000296 B91200                      mov  cx, LBLW
   441 00000299 28C1                        sub  cl, al                    ; (AL = label length)
   442 0000029B 49                          dec  cx
   443                                  .dot:
   444 0000029C E30C                        jcxz .dd
   445 0000029E B0FA                        mov  al, 0xFA                  ; middle dot
   446 000002A0 51                          push cx
   447 000002A1 E8(FA52)                    call A_PUTCH
   448 000002A4 59                          pop  cx
   449 000002A5 FEC2                        inc  dl
   450 000002A7 49                          dec  cx
   451 000002A8 EBF2                        jmp  .dot
   452                                  .dd:
   453 000002AA 5A                          pop  dx
   454 000002AB 5B                          pop  bx
